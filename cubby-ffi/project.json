{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "cubby-ffi",
  "targets": {
    "rust": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "cargo fmt --check",
          "cargo clippy --locked --profile ci --all-targets -- -D warnings",
          "cargo test --locked --profile ci"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": ["rustGate"]
    }
  }
}
