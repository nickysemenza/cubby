// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//fo=barzrzzzx

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres", "driverAdapters"]
}

generator json {
  provider = "prisma-json-types-generator"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // vercel neon has DATABASE_URL_UNPOOLED
  // https://www.prisma.io/docs/orm/overview/databases/neon#how-to-use-neons-connection-pooling
  // directUrl  = env("DATABASE_URL_UNPOOLED")
  // https://www.prisma.io/docs/orm/prisma-schema/data-model/unsupported-database-features#enable-postgresql-extensions-for-native-database-functions
  extensions = [pgcrypto, pg_trgm]
}

model Recipe {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  deletedAt         DateTime?
  sections          RecipeSection[]
  pointerIngredient Ingredient? // what ingredients are actually this recipe
  SourceType        RecipeSource?
  SourceData        String?

  // recipe images
  images RecipeImage[]

  @@index([createdAt])
  @@index([SourceType])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Recipe_name_gin_idx")
  @@index([createdAt(sort: Desc)], map: "Recipe_created_at_desc_idx")
}

model RecipeSection {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe       Recipe                    @relation(fields: [recipeId], references: [id])
  recipeId     String                    @db.Uuid
  name         String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @default(now()) @updatedAt
  deletedAt    DateTime?
  ingredients  RecipeSectionIngredient[]
  /// [Instruction]
  instructions Json[]

  @@index([recipeId])
  @@index([createdAt])
}

model RecipeSectionIngredient {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeSection   RecipeSection @relation(fields: [recipeSectionId], references: [id])
  recipeSectionId String        @db.Uuid

  /// pointer to an ingredient
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String     @db.Uuid

  /// [Amount]
  amounts   Json[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([recipeSectionId])
  @@index([ingredientId])
}

model Ingredient {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  aliases   String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  /// can be a placeholder of sorts that points to a recipe
  Recipe   Recipe? @relation(fields: [recipeId], references: [id])
  recipeId String? @unique @db.Uuid

  // all ingredient appear in a recipe
  RecipeSectionIngredient RecipeSectionIngredient[]

  // what product(s) point to this ingredient
  Product Product[]

  @@index([recipeId])
  @@index([createdAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Ingredient_name_gin_idx")
  @@index([aliases], type: Gin, map: "Ingredient_aliases_gin_idx")
}

model Product {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  manufacturer String
  upc          String? @unique
  ndb_number   Int?    @unique
  model        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  // some products can point to an ingredient
  // multiple products can point to the same ingredient
  Ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  ingredientId String?     @db.Uuid

  // products have mappings (such as price)
  unitMappings ProductUnitMappings[]

  // products are inventoried
  InventoryEntry InventoryEntry[]

  // product images
  images ProductImage[]

  @@unique([name, manufacturer])
  @@index([ingredientId])
  @@index([createdAt])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_gin_idx")
  @@index([manufacturer(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_manufacturer_gin_idx")
  @@index([name, manufacturer], map: "Product_name_manufacturer_idx")
}

model ProductUnitMappings {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  productId String  @db.Uuid
  /// [Amount]
  a         Json

  /// [Amount]
  b         Json
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@index([productId])
}

/// holds a mapping between an product and a location
model InventoryEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // name      String

  /// what is the product
  Product   Product @relation(fields: [productId], references: [id])
  productId String  @db.Uuid

  /// [Amount]
  amount Json

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  /// where is the product
  location   Location @relation("LocationToProduct", fields: [locationId], references: [id])
  locationId String   @db.Uuid

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
}

model Location {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  deletedAt         DateTime?
  lastBulkInventory DateTime?

  parent           Location?        @relation("LocationToLocation", fields: [parentId], references: [id])
  parentId         String?          @db.Uuid
  children         Location[]       @relation("LocationToLocation")
  /// products that are in this location
  InventoryEntries InventoryEntry[] @relation("LocationToProduct")

  // location images
  images LocationImage[]

  type String

  @@index([name])
  @@index([type])
  @@index([parentId])
  @@index([createdAt])
  @@index([lastBulkInventory])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_gin_idx")
  @@index([type, name], map: "Location_type_name_idx")
}

enum RecipeSource {
  Book
  Website
  Other
}

// Image upload models
model Image {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url         String
  key         String      @unique
  filename    String
  size        Int
  contentType String
  status      ImageStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  deletedAt   DateTime?

  // Relations
  productImages  ProductImage[]
  locationImages LocationImage[]
  recipeImages   RecipeImage[]

  @@index([createdAt])
  @@index([status])
}

model ProductImage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product   Product   @relation(fields: [productId], references: [id])
  productId String    @db.Uuid
  image     Image     @relation(fields: [imageId], references: [id])
  imageId   String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@unique([productId, imageId])
  @@index([productId])
  @@index([imageId])
}

model LocationImage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  location   Location  @relation(fields: [locationId], references: [id])
  locationId String    @db.Uuid
  image      Image     @relation(fields: [imageId], references: [id])
  imageId    String    @db.Uuid
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?

  @@unique([locationId, imageId])
  @@index([locationId])
  @@index([imageId])
}

model RecipeImage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe    Recipe    @relation(fields: [recipeId], references: [id])
  recipeId  String    @db.Uuid
  image     Image     @relation(fields: [imageId], references: [id])
  imageId   String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?

  @@unique([recipeId, imageId])
  @@index([recipeId])
  @@index([imageId])
}

enum ImageStatus {
  PENDING
  UPLOADED
  FAILED
}
