// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions", "tracing", "fullTextSearchPostgres"]
}

generator json {
    provider = "prisma-json-types-generator"
}

generator dbml {
    provider = "prisma-dbml-generator"
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    // https://www.prisma.io/docs/orm/prisma-schema/data-model/unsupported-database-features#enable-postgresql-extensions-for-native-database-functions
    extensions = [pgcrypto]
}

model Recipe {
    id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name       String
    createdAt  DateTime        @default(now())
    updatedAt  DateTime        @default(now()) @updatedAt
    deletedAt  DateTime?
    sections   RecipeSection[]
    Item       Item[]
    SourceType RecipeSource?
    SourceData String?
}

model RecipeSection {
    id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipe       Recipe                    @relation(fields: [recipeId], references: [id])
    recipeId     String                    @db.Uuid
    name         String?
    createdAt    DateTime                  @default(now())
    updatedAt    DateTime                  @default(now()) @updatedAt
    deletedAt    DateTime?
    ingredients  RecipeSectionIngredient[]
    /// [Instruction]  
    instructions Json[]
}

model RecipeSectionIngredient {
    id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipeSection   RecipeSection @relation(fields: [recipeSectionId], references: [id])
    recipeSectionId String        @db.Uuid

    /// each ingredient is an item
    ingredient   Item   @relation(fields: [ingredientId], references: [id])
    ingredientId String @db.Uuid

    /// [Amount]
    amounts   Json[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

model Item {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String    @unique
    aliases   String[]
    type      ItemType
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    /// items appear in inventory reports
    InventoryItem InventoryItem[]

    /// some items are ingredients
    Recipe                  Recipe?                   @relation(fields: [recipeId], references: [id])
    recipeId                String?                   @db.Uuid
    RecipeSectionIngredient RecipeSectionIngredient[]

    // hierarchy, parent can have equivalent children
    // children Item[] @relation("SameAsItem")
    // parent   Item?  @relation("SameAsItem", fields: [parentItemId], references: [id])
    // parentItemId String?   @db.Uuid

    // what product(s) point to this item
    Product Product[]
}

model Product {
    id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name         String  @unique
    manufacturer String
    upc          String  @unique
    model        String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    Item         Item?                 @relation(fields: [itemId], references: [id])
    itemId       String?               @db.Uuid
    unitMappings ProductUnitMappings[]
}

model ProductUnitMappings {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    product   Product   @relation(fields: [productId], references: [id])
    productId String    @db.Uuid
    /// [Amount]
    a         Json
    /// [Amount]
    b         Json
    source    String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

/// holds a mapping between an item and a location
model InventoryItem {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // name      String

    /// what is the item
    Item   Item   @relation(fields: [itemId], references: [id])
    itemId String @db.Uuid

    /// [Amount]
    amount Json

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    /// where is the item
    location   Location @relation("LocationToItem", fields: [locationId], references: [id])
    locationId String   @db.Uuid
}

model Location {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    parent   Location?       @relation("LocationToLocation", fields: [parentId], references: [id])
    parentId String?         @db.Uuid
    children Location[]      @relation("LocationToLocation")
    /// items that are in this location
    items    InventoryItem[] @relation("LocationToItem")

    type String

    @@index([name])
    @@index([type])
}

enum ItemType {
    Ingredient
    Recipe
    Item
}

enum RecipeSource {
    Book
    Website
    Other
}
