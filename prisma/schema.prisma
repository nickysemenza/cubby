// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//fo=barzrzzzx

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

generator json {
    provider = "prisma-json-types-generator"
}

generator dbml {
    provider = "prisma-dbml-generator"
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    // https://www.prisma.io/docs/orm/prisma-schema/data-model/unsupported-database-features#enable-postgresql-extensions-for-native-database-functions
    extensions = [pgcrypto]
}

model Recipe {
    id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name              String          @unique
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @default(now()) @updatedAt
    deletedAt         DateTime?
    sections          RecipeSection[]
    pointerIngredient Ingredient? // what ingredients are actually this recipe
    SourceType        RecipeSource?
    SourceData        String?
}

model RecipeSection {
    id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipe       Recipe                    @relation(fields: [recipeId], references: [id])
    recipeId     String                    @db.Uuid
    name         String?
    createdAt    DateTime                  @default(now())
    updatedAt    DateTime                  @default(now()) @updatedAt
    deletedAt    DateTime?
    ingredients  RecipeSectionIngredient[]
    /// [Instruction]  
    instructions Json[]
}

model RecipeSectionIngredient {
    id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipeSection   RecipeSection @relation(fields: [recipeSectionId], references: [id])
    recipeSectionId String        @db.Uuid

    /// pointer to an ingredient
    ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
    ingredientId String     @db.Uuid

    /// [Amount]
    amounts   Json[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

model Ingredient {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String    @unique
    aliases   String[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    /// can be a placeholder of sorts that points to a recipe
    Recipe   Recipe? @relation(fields: [recipeId], references: [id])
    recipeId String? @unique @db.Uuid

    // all ingredient appear in a recipe
    RecipeSectionIngredient RecipeSectionIngredient[]

    // what product(s) point to this ingredient
    Product Product[]
}

model Product {
    id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name         String
    manufacturer String
    upc          String? @unique
    ndb_number   Int?    @unique
    model        String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    // some products can point to an ingredient
    // multiple products can point to the same ingredient
    Ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
    ingredientId String?     @db.Uuid

    // products have mappings (such as price)
    unitMappings ProductUnitMappings[]

    // products are inventoried
    InventoryEntry InventoryEntry[]

    @@unique([name, manufacturer])
}

model ProductUnitMappings {
    id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    product   Product @relation(fields: [productId], references: [id])
    productId String  @db.Uuid
    /// [Amount]
    a         Json

    /// [Amount]
    b         Json
    source    String?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

/// holds a mapping between an product and a location
model InventoryEntry {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // name      String

    /// what is the product
    Product   Product @relation(fields: [productId], references: [id])
    productId String  @db.Uuid

    /// [Amount]
    amount Json

    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    /// where is the product
    location   Location @relation("LocationToProduct", fields: [locationId], references: [id])
    locationId String   @db.Uuid

    @@unique([productId, locationId])
}

model Location {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String    @unique
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?

    parent           Location?        @relation("LocationToLocation", fields: [parentId], references: [id])
    parentId         String?          @db.Uuid
    children         Location[]       @relation("LocationToLocation")
    /// products that are in this location
    InventoryEntries InventoryEntry[] @relation("LocationToProduct")

    type String

    @@index([name])
    @@index([type])
}

enum RecipeSource {
    Book
    Website
    Other
}

model usda_branded_food {
    fdc_id                      Int       @id
    brand_owner                 String?
    brand_name                  String?
    subbrand_name               String?
    gtin_upc                    String
    ingredients                 String?
    not_a_significant_source_of String?
    serving_size                Decimal?
    serving_size_unit           String?
    household_serving_fulltext  String?
    branded_food_category       String?
    data_source                 String?
    package_weight              String?
    modified_date               String?
    available_date              String?
    market_country              String?
    discontinued_date           String?
    preparation_state_code      String?
    trade_channel               String?
    short_description           String?
    material_code               String?
    food                        usda_food @relation(fields: [fdc_id], references: [fdc_id], onDelete: NoAction, onUpdate: NoAction)

    @@index([fdc_id], map: "branded_food_fdc_id")
    @@index([gtin_upc], map: "branded_food_upc")
}

model usda_food {
    fdc_id           Int                  @id
    data_type        String
    description      String
    food_category_id String
    publication_date String
    branded_food     usda_branded_food?
    food_nutrient    usda_food_nutrient[]
    food_portion     usda_food_portion[]

    @@index([fdc_id], map: "food_fdc_id")
}

model usda_food_nutrient {
    id                  Int           @id
    fdc_id              Int
    nutrient_id         Int
    amount              Decimal
    data_points         String
    derivation_id       String
    min                 String
    max                 String
    median              String
    loq                 String
    footnote            String
    min_year_acquired   String
    percent_daily_value String
    nutrient            usda_nutrient @relation(fields: [nutrient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    food                usda_food     @relation(fields: [fdc_id], references: [fdc_id], onDelete: NoAction, onUpdate: NoAction)

    @@index([fdc_id], map: "food_nutrient_fdc_id")
}

model usda_nutrient {
    id            Int                  @id
    name          String
    unit_name     String
    nutrient_nbr  String
    rank          String
    food_nutrient usda_food_nutrient[]
}

model usda_measure_unit {
    id                Int                 @id
    name              String
    usda_food_portion usda_food_portion[]
}

model usda_food_portion {
    id                  Int               @id
    fdc_id              Int
    food                usda_food         @relation(fields: [fdc_id], references: [fdc_id], onDelete: NoAction, onUpdate: NoAction)
    seq_num             String?
    amount              Decimal
    measure_unit_id     Int
    measure_unit        usda_measure_unit @relation(fields: [measure_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    portion_description String?
    modifier            String?
    gram_weight         Decimal
    data_points         String?
    footnote            String?
    min_year_acquired   String?

    @@index([fdc_id], map: "food_portion_fdc_id")
}

model usda_sr_legacy_food {
    fdc_id     Int @id
    NDB_number Int @unique
}
