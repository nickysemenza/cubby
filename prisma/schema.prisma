// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions", "tracing"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    // https://www.prisma.io/docs/orm/prisma-schema/data-model/unsupported-database-features#enable-postgresql-extensions-for-native-database-functions
    extensions = [pgcrypto]
}

model Recipe {
    id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String
    createdAt DateTime        @default(now())
    updatedAt DateTime        @default(now()) @updatedAt
    deletedAt DateTime?
    sections  RecipeSection[]
    Item      Item[]
}

model RecipeSection {
    id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipe      Recipe                    @relation(fields: [recipeId], references: [id])
    recipeId    String                    @db.Uuid
    name        String?
    createdAt   DateTime                  @default(now())
    updatedAt   DateTime                  @default(now()) @updatedAt
    deletedAt   DateTime?
    ingredients RecipeSectionIngredient[]
}

model RecipeSectionIngredient {
    id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipeSection   RecipeSection @relation(fields: [recipeSectionId], references: [id])
    recipeSectionId String        @db.Uuid

    ingredient   Item   @relation(fields: [ingredientId], references: [id])
    ingredientId String @db.Uuid

    /// [Amount]
    amounts   Json[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

model Item {
    id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name          String
    type          ItemType
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    deletedAt     DateTime?
    InventoryItem InventoryItem[]
    Product       Product?        @relation(fields: [productId], references: [id])
    productId     String?         @db.Uuid

    Recipe                  Recipe?                   @relation(fields: [recipeId], references: [id])
    recipeId                String?                   @db.Uuid
    RecipeSectionIngredient RecipeSectionIngredient[]

    @@unique([name, type])
}

model Product {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
    Item      Item[]
}

model InventoryItem {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    // name      String

    /// [Amount]
    amount Json
    Item   Item   @relation(fields: [itemId], references: [id])
    itemId String @db.Uuid

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    location   Location @relation("LocationToItem", fields: [locationId], references: [id])
    locationId String   @db.Uuid
}

model Location {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    parent   Location?       @relation("LocationToLocation", fields: [parentId], references: [id])
    parentId String?         @db.Uuid
    children Location[]      @relation("LocationToLocation")
    items    InventoryItem[] @relation("LocationToItem")

    @@index([name])
}

enum ItemType {
    Ingredient
    Recipe
    Item
}
