// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    // https://www.prisma.io/docs/orm/prisma-schema/data-model/unsupported-database-features#enable-postgresql-extensions-for-native-database-functions
    extensions = [pgcrypto]
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
}

model Recipe {
    id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name              String
    createdAt         DateTime                  @default(now())
    updatedAt         DateTime                  @default(now()) @updatedAt
    deletedAt         DateTime?
    sections          RecipeSection[]
    sectionIngredient RecipeSectionIngredient[]
}

model RecipeSection {
    id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipe            Recipe                    @relation(fields: [recipeId], references: [id])
    recipeId          String                    @db.Uuid
    name              String?
    createdAt         DateTime                  @default(now())
    updatedAt         DateTime                  @default(now()) @updatedAt
    deletedAt         DateTime?
    sectionIngredient RecipeSectionIngredient[]
}

model Ingredient {
    id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name                    String
    createdAt               DateTime                  @default(now())
    updatedAt               DateTime                  @default(now()) @updatedAt
    deletedAt               DateTime?
    appearsInRecipeSections RecipeSectionIngredient[]
}

model RecipeSectionIngredient {
    id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    recipeSection   RecipeSection @relation(fields: [recipeSectionId], references: [id])
    recipeSectionId String        @db.Uuid

    // one
    recipe       Recipe?     @relation(fields: [recipeId], references: [id])
    recipeId     String?     @db.Uuid
    // or the other
    ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
    ingredientId String?     @db.Uuid

    // quantity        Float
    // unit            String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
    deletedAt DateTime?
}

model InventoryItem {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    location   Location @relation("LocationToItem", fields: [locationId], references: [id])
    locationId String   @db.Uuid

    @@index([name])
}

model Location {
    id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    name      String
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    parent   Location?       @relation("LocationToLocation", fields: [parentId], references: [id])
    parentId String?         @db.Uuid
    children Location[]      @relation("LocationToLocation")
    items    InventoryItem[] @relation("LocationToItem")

    @@index([name])
}
