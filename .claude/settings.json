{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/setup-agent-environment.mjs",
              "--worktree-only"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
