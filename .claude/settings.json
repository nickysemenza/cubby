{
  "model": "opus",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm",
            "args": [
              "--dir",
              "${CLAUDE_PROJECT_DIR}",
              "run",
              "agent:setup",
              "--",
              "--worktree-only"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
