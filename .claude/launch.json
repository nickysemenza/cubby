{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@cubby/web", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-wt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/nicky/dev/cubby/.claude/worktrees/toast-batch-link/apps/web && exec pnpm run dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "usda-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@cubby/usda-api", "run", "dev"],
      "port": 8080
    },
    {
      "name": "upc-lookup",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@cubby/upc-lookup", "run", "dev:local"],
      "port": 5173
    },
    {
      "name": "web-cf",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep -E '^DATABASE_URL=' apps/web/.env | head -1 | cut -d= -f2-); exec pnpm --filter @cubby/web exec wrangler dev --config dist/server/wrangler.json --port 8788"
      ],
      "port": 8788
    }
  ]
}
