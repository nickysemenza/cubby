{
  "name": "recipehub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:log": "pnpm -r --reporter append-only dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "format:write": "pnpm -r format:write",
    "test": "pnpm -r test",
    "test-ui": "vitest --ui",
    "test:e2e": "pnpm -r test:e2e",
    "wasm": "wasm-pack build --scope recipehub --out-dir ../packages/wasm recipebridge",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "4.0.15",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.0"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "^4.0.0"
        }
      }
    }
  }
}
