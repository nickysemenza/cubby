{
  "name": "cubby",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:setup": "pnpm install --frozen-lockfile && node scripts/ensure.ts wasm",
    "dev": "pnpm --dir apps/web exec tsx tooling/dev/index.ts",
    "build": "node scripts/ensure.ts generate && pnpm --filter @cubby/web build:cf",
    "check": "NX_DAEMON=false nx run-many --projects=cubby-checks --outputStyle=stream --targets=generate,design-tokens,types,lint,format,knip",
    "check:stack": "node scripts/stack-preflight.ts",
    "check:plan": "node scripts/ci-lanes.ts --explain",
    "check:staged": "lint-staged --config .lintstagedrc.json --concurrent false",
    "check:all": "NX_DAEMON=false nx run-many --projects=cubby-checks,@cubby/web --outputStyle=stream --targets=generate,design-tokens,types,lint,format,knip,ci-lanes,bindings,script-tests,workers-tests",
    "typecheck": "node scripts/ensure.ts generate && pnpm -r --workspace-concurrency=2 typecheck && tsc --noEmit -p tsconfig.json",
    "typecheck:web": "pnpm --filter @cubby/web typecheck:app",
    "generate": "node scripts/design-tokens.ts && node scripts/ci-lanes.ts && node scripts/ensure.ts generate --force",
    "generate:if-stale": "node scripts/design-tokens.ts && node scripts/ensure.ts generate",
    "check:design-tokens": "node scripts/design-tokens.ts --check",
    "postinstall": "node scripts/ensure.ts generate --postinstall",
    "check:clean": "sh -c 'if ! git diff --quiet HEAD || test -n \"$(git ls-files --others --exclude-standard)\"; then echo \"Working tree must be clean before and after verification. Commit or remove staged, unstaged, and untracked files:\" >&2; git status --short >&2; exit 1; fi'",
    "lint": "NX_DAEMON=false nx run cubby-checks:lint --outputStyle=stream",
    "lint:fix": "oxlint --fix .",
    "format:check": "NX_DAEMON=false nx run cubby-checks:format --outputStyle=stream",
    "format": "oxfmt .",
    "verify:local": "pnpm check:clean && NX_DAEMON=false nx run-many -t generate,types,lint,format,knip,test,db-check,postgres,workerd-tests,e2e,rust,check --parallel=1 --nxBail --outputStyle=static-failures-only && pnpm check:clean",
    "verify:local:full": "pnpm check:clean && NX_DAEMON=false NX_SKIP_NX_CACHE=true nx run-many -t generate,types,lint,format,knip,test,db-check,postgres,workerd-tests,e2e,rust,check --parallel=1 --nxBail --outputStyle=static-failures-only && pnpm check:clean",
    "test": "NX_DAEMON=false nx run-many --projects=cubby-checks -t fast-tests --outputStyle=static-failures-only",
    "test:postgres": "pnpm --filter @cubby/web test:postgres",
    "test:file": "pnpm --filter @cubby/web test:file",
    "knip:production": "knip --production --no-gitignore --include files,dependencies",
    "test:scripts": "node --test 'scripts/**/*.test.ts' 'tools/oxlint/**/*.test.ts' 'apps/web/generator/**/*.test.ts'",
    "test:e2e": "pnpm --filter @cubby/web test:e2e",
    "test:e2e:household": "pnpm --filter @cubby/web test:e2e:household",
    "test:e2e:local": "pnpm --dir apps/web exec tsx tooling/local-e2e.ts",
    "test:e2e:sim": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts",
    "test:e2e:agent:web": "pnpm --dir apps/web exec tsx tooling/tester-army/web.ts",
    "test:e2e:agent:ios": "pnpm test:e2e:sim -- --tester-army",
    "test:e2e:agent:selfcheck": "NODE_ENV=test node scripts/test-services.ts -- pnpm --dir apps/web exec tsx tooling/tester-army/selfcheck.ts",
    "test:e2e:agent:preflight": "pnpm --dir apps/web exec tsx tooling/tester-army/preflight.ts",
    "apple": "node scripts/apple/apple.ts",
    "wasm": "node scripts/ensure.ts wasm --build",
    "deploy:all": "pnpm run wasm && pnpm --filter @cubby/web run deploy:cf",
    "prepare": "husky",
    "test:services:down": "node scripts/test-services.ts --down",
    "db:generate": "pnpm --filter @cubby/web db:generate",
    "db:check": "pnpm --filter @cubby/web db:check",
    "db:dev:up": "node scripts/dev-db.ts up",
    "db:dev:migrate": "node scripts/dev-db.ts migrate",
    "db:dev:down": "node scripts/dev-db.ts down"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@redocly/cli": "^2.64.0",
    "@tanstack/router-generator": "1.167.44",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "agent-device": "0.21.28",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "picomatch": "^4.0.7",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.11.2",
  "nx": {
    "includedScripts": []
  }
}
