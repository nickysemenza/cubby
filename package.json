{
  "name": "cubby",
  "private": true,
  "type": "module",
  "scripts": {
    "ci:flakes": "node scripts/ci-flakes.ts",
    "agent:setup": "pnpm install --frozen-lockfile && node scripts/ensure-wasm.ts",
    "dev": "pnpm --filter @cubby/web dev",
    "build": "node scripts/generator/ensure.ts && pnpm -r build",
    "check": "NX_DAEMON=false nx run-many --projects=cubby-checks --outputStyle=stream --targets=generate,types,lint,format,knip",
    "check:staged": "lint-staged --config .lintstagedrc.json --concurrent false",
    "check:all": "NX_DAEMON=false nx run-many --projects=cubby-checks,@cubby/web --outputStyle=stream --targets=generate,types,lint,format,knip,bindings,openapi,script-tests,security,workers-tests",
    "typecheck": "node scripts/generator/ensure.ts && pnpm -r --workspace-concurrency=2 typecheck && tsc --noEmit -p tsconfig.json",
    "typecheck:web": "pnpm --filter @cubby/web typecheck:app",
    "typecheck:web:tests": "pnpm --filter @cubby/web typecheck",
    "generate": "node scripts/design-tokens/generate.mjs && node scripts/generator/ensure.ts --force",
    "generate:if-stale": "node scripts/design-tokens/generate.mjs && node scripts/generator/ensure.ts",
    "check:design-tokens": "node scripts/design-tokens/generate.mjs --check",
    "postinstall": "node scripts/generator/ensure.ts --postinstall",
    "dedupe:check": "pnpm dedupe --check",
    "check:clean": "sh -c 'if ! git diff --quiet HEAD || test -n \"$(git ls-files --others --exclude-standard)\"; then echo \"Working tree must be clean before and after verification. Commit or remove staged, unstaged, and untracked files:\" >&2; git status --short >&2; exit 1; fi'",
    "audit:security": "node scripts/check-security-audit.ts",
    "lint": "NX_DAEMON=false nx run cubby-checks:lint --outputStyle=stream",
    "lint:fix": "oxlint --fix .",
    "format:check": "NX_DAEMON=false nx run cubby-checks:format --outputStyle=stream",
    "format": "oxfmt .",
    "verify:local": "pnpm check:clean && NX_DAEMON=false nx run-many -t generate,types,lint,format,knip,test,postgres,build-cf,e2e,rust,apple-check --parallel=1 --nxBail --outputStyle=static-failures-only && pnpm check:clean",
    "verify:local:full": "pnpm check:clean && NX_DAEMON=false NX_SKIP_NX_CACHE=true nx run-many -t generate,types,lint,format,knip,test,postgres,build-cf,e2e,rust,apple-check --parallel=1 --nxBail --outputStyle=static-failures-only && pnpm check:clean",
    "test": "NX_DAEMON=false nx run-many --projects=cubby-checks -t fast-tests --outputStyle=static-failures-only",
    "test:unit": "pnpm --filter @cubby/web test:unit",
    "test:ui": "pnpm --filter @cubby/web test:ui",
    "test:postgres": "pnpm --filter @cubby/web test:postgres",
    "test:changed:postgres": "pnpm --filter @cubby/web test:changed:postgres",
    "test:file": "pnpm --filter @cubby/web test:file",
    "knip:production": "knip --production --no-gitignore --include files,dependencies",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:e2e": "pnpm --filter @cubby/web test:e2e",
    "test:e2e:local": "pnpm --dir apps/web exec tsx tooling/local-e2e.ts",
    "test:e2e:sim": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts",
    "test:e2e:agent:web": "pnpm --dir apps/web exec tsx tooling/tester-army/web.ts",
    "test:e2e:agent:ios": "pnpm test:e2e:sim -- --tester-army",
    "test:e2e:agent:preflight": "pnpm --dir apps/web exec tsx tooling/tester-army/preflight.ts",
    "test:all": "pnpm test && node scripts/test-services.ts -- sh -c 'pnpm test:postgres && pnpm test:e2e'",
    "apple": "node scripts/apple.ts",
    "wasm": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/cubby/cargo-target}\" CARGO_PROFILE_RELEASE_OPT_LEVEL=z CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 CARGO_PROFILE_RELEASE_PANIC=abort CARGO_PROFILE_RELEASE_INCREMENTAL=false wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge && node scripts/ensure-wasm.ts --stamp",
    "deploy:all": "pnpm run wasm && pnpm --filter @cubby/web run deploy:cf && pnpm --filter @cubby/purchase-agent run deploy && pnpm --filter @cubby/usda-api run deploy",
    "prepare": "husky",
    "test:services:down": "node scripts/test-services.ts --down",
    "test:e2e:watch": "pnpm --filter @cubby/web test:e2e:watch",
    "db:generate": "pnpm --filter @cubby/web db:generate",
    "db:check": "pnpm --filter @cubby/web db:check",
    "db:dev:up": "node scripts/dev-db.ts up",
    "db:dev:migrate": "node scripts/dev-db.ts migrate",
    "db:dev:down": "node scripts/dev-db.ts down",
    "dev:doctor": "pnpm --filter @cubby/web dev:doctor",
    "dev:status": "pnpm --filter @cubby/web dev:status",
    "dev:seed": "pnpm --filter @cubby/web dev:seed",
    "dev:reset": "pnpm --filter @cubby/web dev:reset",
    "dev:down": "pnpm --filter @cubby/web dev:down",
    "dev:sim": "pnpm --filter @cubby/web dev:sim",
    "dev:integrations": "pnpm --filter @cubby/web dev:integrations",
    "test:e2e:dev": "pnpm --dir apps/web exec tsx tooling/dev/smoke.ts"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@redocly/cli": "^2.57.0",
    "@tanstack/router-generator": "1.167.40",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "@types/node": "^26.6.3",
    "agent-device": "0.21.20",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "nx": "23.2.1",
    "oxc-parser": "0.152.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.7.0",
  "nx": {
    "includedScripts": []
  }
}
