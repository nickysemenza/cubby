{
  "name": "cubby",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:setup": "pnpm install --frozen-lockfile && node scripts/ensure-wasm.ts",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check": "NX_DAEMON=false nx run-many --projects=cubby-checks --outputStyle=stream --targets=entity,start-ops,types,lint,format,soft-delete,identifiers,knip",
    "check:all": "NX_DAEMON=false nx run-many --projects=cubby-checks --outputStyle=stream --targets=entity,start-ops,types,lint,format,soft-delete,identifiers,knip,bindings,openapi,script-tests,security",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck && tsc --noEmit -p tsconfig.json",
    "typecheck:web": "pnpm --filter @cubby/web typecheck",
    "entity:generate": "tsx scripts/entity-generator.ts",
    "entity:check": "tsx scripts/entity-generator.ts --check",
    "start-operations:generate": "node scripts/start-operation-registry-generator.ts",
    "knip": "knip --no-config-hints --cache",
    "dedupe:check": "pnpm dedupe --check",
    "audit:security": "node scripts/check-security-audit.ts",
    "lint": "NX_DAEMON=false nx run cubby-checks:lint --outputStyle=stream",
    "lint:fix": "oxlint --fix .",
    "format:check": "NX_DAEMON=false nx run cubby-checks:format --outputStyle=stream",
    "format": "oxfmt .",
    "verify:local": "node scripts/ci-scope.ts",
    "verify:local:full": "node scripts/ci-scope.ts --full",
    "verify:push": "node scripts/ci-scope.ts",
    "test": "NX_DAEMON=false nx run cubby-checks:fast-tests --outputStyle=stream",
    "test:unit": "pnpm --filter @cubby/web test:unit",
    "test:ui": "pnpm --filter @cubby/web test:ui",
    "test:pglite": "pnpm --filter @cubby/web test:pglite",
    "test:postgres": "pnpm --filter @cubby/web test:postgres",
    "test:integration:postgres": "pnpm --filter @cubby/web test:integration:postgres",
    "test:changed": "pnpm --filter @cubby/web test:changed",
    "test:changed:postgres": "pnpm --filter @cubby/web test:changed:postgres",
    "test:file": "pnpm --filter @cubby/web test:file",
    "test:file:postgres": "pnpm --filter @cubby/web test:file:postgres",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:e2e": "pnpm --filter @cubby/web test:e2e",
    "test:e2e:postgres": "pnpm --filter @cubby/web test:e2e:postgres",
    "test:e2e:pglite": "pnpm --filter @cubby/web test:e2e:pglite",
    "test:all": "pnpm test && concurrently --kill-others-on-fail --success all --names postgres,e2e \"pnpm test:postgres\" \"pnpm test:e2e\"",
    "test:local": "pnpm test:all",
    "wasm": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/cubby/recipebridge-target}\" wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "nx": "23.2.0",
    "oxc-parser": "0.147.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
