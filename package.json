{
  "name": "recipehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:rebuild": "npm run db:push",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "test": "vitest ",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "npm run build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "wasm": "wasm-pack build --out-dir pkg recipebridge",
    "gen:config-schema": "tsx scripts/generate-json-schemas.ts",
    "gen:write-config": "tsx scripts/write-config.ts",
    "load-data": "tsx scripts/load-data.ts",
    "regenerate": "npm run db:rebuild && npm run wasm",
    "test:e2e": " NODE_ENV=test playwright test",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.873.0",
