{
  "name": "recipehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:snapletseed": "npx @snaplet/seed sync",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:rebuild": "npm run db:push && npm run db:snapletseed && prisma db seed",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "test": "vitest",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "wasm": "cd recipebridge && wasm-pack build",
    "regenerate": "npm run db:rebuild && npm run wasm"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@opentelemetry/api-logs": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/instrumentation": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-logs": "^0.55.0",
    "@opentelemetry/sdk-trace-base": "^1.28.0",
    "@opentelemetry/sdk-trace-node": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@prisma/client": "^5.14.0",
    "@prisma/instrumentation": "^5.22.0",
    "@t3-oss/env-nextjs": "^0.11.0",
    "@tanstack/react-query": "^5.50.0",
    "@tanstack/react-table": "^8.20.5",
    "@trpc/client": "^11.0.0-rc.446",
    "@trpc/react-query": "^11.0.0-rc.446",
    "@trpc/server": "^11.0.0-rc.446",
    "@vercel/otel": "^1.10.0",
    "dayjs": "^1.11.13",
    "flat": "^6.0.1",
    "geist": "^1.3.0",
    "json-edit-react": "^1.17.1",
    "lucide-react": "^0.460.0",
    "next": "^15.0.1",
    "react": "^18.3.1",
    "react-aria-components": "^1.4.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.3.0",
    "trpc-ui": "^1.0.3",
    "vite-plugin-wasm": "^3.3.0",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.2.0",
    "@snaplet/copycat": "^5.1.0",
    "@snaplet/seed": "^0.98.0",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "@vitest/coverage-v8": "^2.1.5",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.1",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "prisma": "^5.14.0",
    "prisma-dbml-generator": "^0.12.0",
    "prisma-json-types-generator": "^3.1.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.3",
    "vite-plugin-top-level-await": "^1.4.4",
    "vitest": "^2.1.5"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "npm@10.9.0",
  "@snaplet/seed": {
    "config": "prisma/seed/seed.config.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed/seed.ts"
  }
}
