{
  "name": "cubby",
  "private": true,
  "type": "module",
  "scripts": {
    "ci:flakes": "node scripts/ci-flakes.ts",
    "agent:setup": "pnpm install --frozen-lockfile && node scripts/ensure-wasm.ts",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check": "NX_DAEMON=false nx run-many --projects=cubby-checks --outputStyle=stream --targets=generate,types,lint,format,knip",
    "check:staged": "lint-staged --config .lintstagedrc.json --concurrent false",
    "check:all": "NX_DAEMON=false nx run-many --projects=cubby-checks,@cubby/web --outputStyle=stream --targets=generate,types,lint,format,knip,bindings,openapi,preview-fixtures,script-tests,security,workers-tests",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck && tsc --noEmit -p tsconfig.json",
    "typecheck:web": "pnpm --filter @cubby/web typecheck",
    "generate": "tsx --tsconfig apps/web/tsconfig.json scripts/generator/main.ts",
    "generate:api": "pnpm generate && sh apps/apple/scripts/generate-openapi.sh",
    "generate:check": "tsx --tsconfig apps/web/tsconfig.json scripts/generator/main.ts --check",
    "dedupe:check": "pnpm dedupe --check",
    "check:clean": "sh -c 'if ! git diff --quiet HEAD || test -n \"$(git ls-files --others --exclude-standard)\"; then echo \"Working tree must be clean before and after verification. Commit or remove staged, unstaged, and untracked files:\" >&2; git status --short >&2; exit 1; fi'",
    "audit:security": "node scripts/check-security-audit.ts",
    "lint": "NX_DAEMON=false nx run cubby-checks:lint --outputStyle=stream",
    "lint:fix": "oxlint --fix .",
    "format:check": "NX_DAEMON=false nx run cubby-checks:format --outputStyle=stream",
    "format": "oxfmt .",
    "verify:local": "pnpm check:clean && NX_DAEMON=false nx run-many -t generate,types,lint,format,knip,preview-fixtures,test,postgres,build-cf,e2e,rust,apple-check --parallel=1 --nxBail --outputStyle=static-failures-only && pnpm check:clean",
    "verify:local:full": "pnpm check:clean && NX_DAEMON=false NX_SKIP_NX_CACHE=true nx run-many -t generate,types,lint,format,knip,preview-fixtures,test,postgres,build-cf,e2e,rust,apple-check --parallel=1 --nxBail --outputStyle=static-failures-only && pnpm check:clean",
    "test": "NX_DAEMON=false nx run-many --projects=cubby-checks -t fast-tests --outputStyle=static-failures-only",
    "test:unit": "pnpm --filter @cubby/web test:unit",
    "test:ui": "pnpm --filter @cubby/web test:ui",
    "test:postgres": "pnpm --filter @cubby/web test:postgres",
    "test:integration:postgres": "pnpm --filter @cubby/web test:integration:postgres",
    "test:changed": "pnpm --filter @cubby/web test:changed",
    "test:changed:postgres": "pnpm --filter @cubby/web test:changed:postgres",
    "test:file": "pnpm --filter @cubby/web test:file",
    "test:file:postgres": "pnpm --filter @cubby/web test:file:postgres",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:e2e": "pnpm --filter @cubby/web test:e2e",
    "test:e2e:sim": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts",
    "test:e2e:sim:video": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts --video",
    "dev:sim:watch": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts --watch",
    "test:e2e:headless": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts --headless",
    "test:e2e:headless:watch": "pnpm --dir apps/web exec tsx tooling/sim-e2e.ts --headless --watch",
    "test:e2e:postgres": "pnpm --filter @cubby/web test:e2e:postgres",
    "test:all": "pnpm test && node scripts/test-services.ts -- sh -c 'pnpm test:postgres && pnpm test:e2e'",
    "test:local": "pnpm test:all",
    "apple": "node scripts/apple.ts",
    "wasm": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/cubby/recipebridge-target}\" wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge && node scripts/ensure-wasm.ts --stamp",
    "deploy:all": "pnpm run wasm && pnpm --filter @cubby/web run deploy:cf && pnpm --filter @cubby/purchase-agent run deploy && pnpm --filter @cubby/upc-lookup run deploy && pnpm --filter @cubby/usda-api run deploy",
    "prepare": "husky && sh scripts/install-merge-driver.sh",
    "trace": "node scripts/test-services.ts --trace",
    "test:services:down": "node scripts/test-services.ts --down",
    "test:e2e:watch": "pnpm --filter @cubby/web test:e2e:watch",
    "db:dev:up": "node scripts/dev-db.ts up",
    "db:dev:push": "node scripts/dev-db.ts push",
    "db:dev:seed": "node scripts/dev-db.ts seed",
    "db:dev:reset": "node scripts/dev-db.ts reset",
    "db:dev:down": "node scripts/dev-db.ts down",
    "dev:local": "pnpm --filter @cubby/web dev:local"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@redocly/cli": "^2.52.0",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "@types/node": "^26.1.1",
    "agent-device": "0.21.12",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.5.1",
    "nx": "23.2.0",
    "oxc-parser": "0.149.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.82.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.4.1",
  "nx": {
    "includedScripts": []
  }
}
