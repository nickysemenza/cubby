{
  "name": "recipehub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "format:write": "pnpm -r format:write",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "wasm": "wasm-pack build --out-dir pkg apps/web/recipebridge",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,mdx}": [
      "cd apps/web && eslint --fix",
      "cd apps/web && prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "cd apps/web && bash -c 'tsc --noEmit'"
    ]
  }
}
