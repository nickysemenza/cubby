{
  "name": "cubby",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:log": "pnpm -r --reporter append-only dev",
    "build": "pnpm -r build",
    "check": "biome check && pnpm typecheck && node scripts/check-conventions.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "typecheck:stable": "pnpm -r --parallel run typecheck:stable",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "format:write": "pnpm -r format:write",
    "test": "pnpm -r test",
    "test-ui": "vitest --ui",
    "test:e2e": "pnpm -r test:e2e",
    "wasm": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/cubby/recipebridge-target}\" wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge",
    "deploy:all": "pnpm --filter @cubby/usda-api run deploy && pnpm --filter @cubby/upc-lookup run deploy && pnpm --filter @cubby/web run deploy:cf",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260209.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "4.1.6",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
