{
  "name": "cubby",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:setup": "node scripts/setup-agent-environment.ts",
    "dev": "pnpm -r dev",
    "dev:log": "pnpm -r --reporter append-only dev",
    "build": "pnpm -r build",
    "check": "node scripts/run-checks.ts",
    "check:all": "node scripts/run-checks.ts --all",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck && tsc --noEmit -p tsconfig.json",
    "typecheck:web": "pnpm --filter @cubby/web typecheck",
    "types:check": "pnpm --filter @cubby/web --filter @cubby/upc-lookup --filter @cubby/usda-api --workspace-concurrency=2 types:check",
    "openapi:check": "pnpm --filter @cubby/usda-api generate:openapi:check",
    "entity:generate": "node scripts/entity-literal-generator.ts",
    "entity:check": "node scripts/entity-literal-generator.ts --check",
    "start-operations:generate": "node scripts/start-operation-registry-generator.ts",
    "start-operations:check": "node scripts/start-operation-registry-generator.ts --check",
    "unsafe-identifiers:check": "node scripts/check-unsafe-identifiers.ts --include-tests && node --test scripts/check-unsafe-identifiers.unit.test.ts",
    "knip": "knip --no-config-hints",
    "dedupe:check": "pnpm dedupe --check",
    "docs:check": "node scripts/check-markdown-links.ts",
    "audit:security": "node scripts/check-security-audit.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "check:staged": "node scripts/check-staged.ts",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "test:unit": "pnpm --filter @cubby/web test:unit",
    "test:unit-pure": "pnpm --filter @cubby/web test:unit-pure",
    "test:ui": "pnpm --filter @cubby/web test:ui",
    "test:pglite": "pnpm --filter @cubby/web test:pglite",
    "test:integration:postgres": "pnpm --filter @cubby/web test:integration:postgres",
    "test:changed": "pnpm --filter @cubby/web test:changed",
    "test:changed:postgres": "pnpm --filter @cubby/web test:changed:postgres",
    "test:file": "pnpm --filter @cubby/web test:file",
    "test:file:postgres": "pnpm --filter @cubby/web test:file:postgres",
    "test:scripts": "node --test scripts/anti-slop-rules.test.ts scripts/ci-scope.test.ts scripts/check-staged.test.ts scripts/oxlint-config.test.ts scripts/run-checks.test.ts",
    "test:ui:watch": "pnpm --filter @cubby/web test:watch",
    "test:e2e": "pnpm -r test:e2e",
    "test:e2e:postgres": "pnpm --filter @cubby/web test:e2e:postgres",
    "test:local": "pnpm test && pnpm test:e2e",
    "wasm": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/cubby/recipebridge-target}\" wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge",
    "deploy:all": "pnpm --filter @cubby/usda-api run deploy && pnpm --filter @cubby/upc-lookup run deploy && pnpm --filter @cubby/web run deploy:cf",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "oxc-parser": "0.147.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.1"
}
