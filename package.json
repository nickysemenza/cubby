{
  "name": "recipehub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "format:write": "pnpm -r format:write",
    "test": "pnpm -r test",
    "test-ui": "vitest --ui",
    "test:e2e": "pnpm -r test:e2e",
    "wasm": "wasm-pack build --scope recipehub --out-dir ../packages/wasm recipebridge",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "4.0.15",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.0"
    }
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,mdx}": [
      "bash -c 'cd apps/web && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "bash -c 'cd apps/web && tsc --noEmit'"
    ],
    "apps/usda-api/**/*.{ts,js}": [
      "bash -c 'cd apps/usda-api && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "apps/usda-api/**/*.ts": [
      "bash -c 'cd apps/usda-api && tsc --noEmit'"
    ],
    "packages/usda-contract/**/*.{ts,js}": [
      "bash -c 'cd packages/usda-contract && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "packages/usda-contract/**/*.ts": [
      "bash -c 'cd packages/usda-contract && tsc --noEmit'"
    ],
    "packages/usda-schemas/**/*.{ts,js}": [
      "bash -c 'cd packages/usda-schemas && eslint --fix \"$@\"' --",
      "prettier --write"
    ],
    "packages/usda-schemas/**/*.ts": [
      "bash -c 'cd packages/usda-schemas && tsc --noEmit'"
    ]
  }
}
