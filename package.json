{
  "name": "cubby",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:setup": "node scripts/setup-agent-environment.ts",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check": "node scripts/run-checks.ts",
    "check:all": "node scripts/run-checks.ts --all",
    "benchmark:check": "node scripts/run-checks.ts benchmark",
    "typecheck": "node scripts/run-checks.ts typecheck",
    "typecheck:web": "pnpm --filter @cubby/web typecheck",
    "entity:generate": "node scripts/entity-literal-generator.ts",
    "entity:check": "node scripts/entity-literal-generator.ts --check",
    "start-operations:generate": "node scripts/start-operation-registry-generator.ts",
    "knip": "knip --no-config-hints --cache",
    "dedupe:check": "pnpm dedupe --check",
    "audit:security": "node scripts/check-security-audit.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "verify:push": "node scripts/ci-scope.ts",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "test:unit": "pnpm --filter @cubby/web test:unit",
    "test:ui": "pnpm --filter @cubby/web test:ui",
    "test:pglite": "pnpm --filter @cubby/web test:pglite",
    "test:integration:postgres": "pnpm --filter @cubby/web test:integration:postgres",
    "test:changed": "pnpm --filter @cubby/web test:changed",
    "test:changed:postgres": "pnpm --filter @cubby/web test:changed:postgres",
    "test:file": "pnpm --filter @cubby/web test:file",
    "test:file:postgres": "pnpm --filter @cubby/web test:file:postgres",
    "test:scripts": "node --test scripts/*.test.ts",
    "test:e2e": "pnpm -r test:e2e",
    "test:e2e:postgres": "pnpm --filter @cubby/web test:e2e:postgres",
    "test:local": "pnpm test && pnpm test:e2e",
    "wasm": "CARGO_TARGET_DIR=\"${CARGO_TARGET_DIR:-$HOME/.cache/cubby/recipebridge-target}\" wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge",
    "prepare": "husky"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "oxc-parser": "0.147.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.34.1"
}
