{
  "name": "cubby",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:log": "pnpm -r --reporter append-only dev",
    "build": "pnpm -r build",
    "check": "biome check && pnpm typecheck",
    "typecheck": "pnpm -r --parallel typecheck",
    "typecheck:stable": "pnpm -r --parallel run typecheck:stable",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "format:write": "pnpm -r format:write",
    "test": "pnpm -r test",
    "test-ui": "vitest --ui",
    "test:e2e": "pnpm -r test:e2e",
    "wasm": "wasm-pack build --scope cubby --out-dir ../packages/wasm recipebridge",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260209.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "4.1.6",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.0"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "^4.0.0"
        }
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8"
  }
}
