{
  // Dependency-free CLIs and node:test files use Node's native type
  // stripping, wherever they live. The generator (apps/web/generator) imports
  // web aliases and is checked by apps/web/tsconfig.json.
  "compilerOptions": {
    "incremental": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "tools/oxlint/**/*.test.ts",
    "apps/apple/tooling/**/*.ts",
    "apps/apple/scripts/*.test.ts",
    "apps/web/tooling/dev-services/**/*.ts",
    "apps/web/tooling/dev/dev-runtime-retry.test.ts",
    "apps/web/tooling/dev/dev-session.test.ts",
    "apps/web/tooling/native-*.test.ts",
    "apps/web/tooling/test-run-contract.test.ts"
  ]
}
