{
  // Root-only project: covers the repo-level `scripts/` gates, which are not
  // part of any pnpm workspace (`pnpm-workspace.yaml` is `apps/*` + `packages/*`)
  // and were therefore checked by nothing before they became TypeScript.
  //
  // These scripts run under `node scripts/foo.ts` with Node 24's native type
  // stripping. `scripts/generator/` is the exception: it runs under
  // `tsx --tsconfig apps/web/tsconfig.json` because it imports web modules by
  // their `~/` paths, so the web project type-checks it (see its `include`).
  // `erasableSyntaxOnly` remains on:
  // it fails the build on enums, namespaces, and parameter properties, the
  // constructs stripping cannot handle. `allowImportingTsExtensions` supports
  // explicit TypeScript specifiers when script modules import one another.
  "compilerOptions": {
    "incremental": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/generator/**"]
}
