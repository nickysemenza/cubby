{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    // Root-level gate scripts. They are listed individually rather than as a
    // `scripts/**` glob so knip still reports a genuinely orphaned script.
    ".": {
      "entry": [
        "scripts/apple.ts!",
        "scripts/test-services.ts!",
        "scripts/check-security-audit.ts!",
        "scripts/ensure-apple-ffi.ts!",
        "scripts/ensure-wasm.ts!",
        "scripts/generator/main.ts!"
      ],
      "project": ["scripts/**/*.ts!"],
      // Invoked as the child command of test-services.ts, beyond Knip's script parser.
      "ignoreDependencies": ["vitest", "vite", "concurrently"],
      // xcode-select: scripts/apple-check.sh (the `apple` Nx target) uses it
      // to detect a machine without Xcode (so it can skip, not fail). pkill:
      // apple.ts quits the running Mac app before relaunching. container: the
      // Apple test-service runtime. All are system tools, never npm
      // dependencies.
      "ignoreBinaries": ["xcode-select", "pkill", "container"]
    },
    "apps/web": {
      "entry": [
        "src/start.ts!",
        "src/router.tsx!",
        "src/routes/**/*.{ts,tsx}!",
        "src/server.ts!",
        "src/styles.css!",
        "src/lib/recipebridge-cf.ts!",
        "src/lib/sentry-cf-shim.ts!",
        "src/server/purchase-import/run-service.ts!",
        "src/integrations/**/*.{ts,tsx}!",
        "src/contracts/index.ts!",
        "src/lib/generated/http-resources.gen.ts!",
        // The `<entity>ListItem` exports name the OpenAPI components; the
        // generator reads them, nothing in the web app does.
        "src/entities/generated/entity-lists.gen.ts!",
        "src/**/*.test.{ts,tsx}!",
        "tests/**/*.{ts,tsx}!",
        "scripts/check-client-bundle.ts!",
        "scripts/check-client-bundle.unit.test.ts!",
        "scripts/ensure-db-extensions.ts!",
        "tooling/**/*.{ts,tsx}!",
        "drizzle.config.ts!",
        "instrument.server.mjs!"
      ],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.{ts,mjs}!"],
      "paths": {
        "~/*": ["./src/*"],
        "tooling/*": ["./tooling/*"]
      },
      "ignoreBinaries": ["tsgo", "rsvg-convert", "magick"],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "@testing-library/.+",
        "@vitest/.+",
        "@tailwindcss/vite",
        "@opentelemetry/.+",
        "cloudflare",
        "vite-plugin-wasm",
        "vite-plugin-top-level-await"
      ],
      "vitest": { "config": "vitest.config.ts" },
      "playwright": { "config": "playwright.config.ts" }
    },
    "apps/purchase-agent": {
      "entry": [
        "src/app.ts!",
        "src/cloudflare.ts!",
        "src/import-run.ts!",
        "src/**/*.unit.test.ts!",
        "flue.config.ts!",
        "vite.config.ts!"
      ],
      "project": ["src/**/*.ts!", "*.ts!"],
      "ignoreDependencies": ["cloudflare"],
      "vitest": { "config": "vitest.config.ts" }
    },
    "apps/mcp-apps": {
      "entry": [
        "src/bundles.ts!",
        "build.mjs!",
        "vite.config.ts!",
        "src/usda-picker-entry.ts!",
        "harness/{host.ts,vite.config.ts}!"
      ],
      "project": ["src/**/*.ts!", "harness/**/*.ts!"],
      "vitest": { "config": "vitest.config.ts" },
      // Consumed by `src/app.css`'s @import, which knip doesn't follow.
      "ignoreDependencies": ["@cubby/design-tokens"]
    },
    "apps/upc-lookup": {
      "entry": [
        "src/index.tsx!",
        "src/**/*.test.ts!",
        "vite.config.ts!",
        "drizzle.config.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "apps/usda-api": {
      "entry": [
        "src/worker.ts!",
        "src/**/*.test.ts!",
        "scripts/**/*.ts!",
        "drizzle.config.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/schemas": {
      "entry": [
        "src/index.ts!",
        "src/**/*.test.ts!",
        "src/entity-definitions/*.entity.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/shared": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/upc-contract": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/usda-contract": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/usda-schemas": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/worker-tracing": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "ignore": [
    ".claude/workflows/**",
    "apps/web/src/components/ui/context-menu.tsx"
  ],
  "ignoreDependencies": ["zod"],
  "ignoreBinaries": ["wasm-pack", "vitest"],
  "ignoreWorkspaces": ["packages/wasm"],
  "rules": {
    "duplicates": "error",
    "cycles": "error"
  },
  "tags": ["-lintignore"]
}
