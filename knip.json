{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    // Root-level gate scripts. They are listed individually rather than as a
    // `scripts/**` glob so knip still reports a genuinely orphaned script.
    ".": {
      "entry": [
        "neon.ts!",
        "scripts/apple.ts!",
        "scripts/test-services.ts!",
        "scripts/check-security-audit.ts!",
        "scripts/ensure-apple-ffi.ts!",
        "scripts/ensure-wasm.ts!",
        "scripts/typecheck-web.ts!",
        "scripts/migrate-upc-d1.ts!",
        "scripts/generator/main.ts!",
        // Reached from hooks, CI, or package scripts rather than an import
        // (production mode does not read those): .husky/commit-msg,
        // ci.yaml, and the Nx targets.
        "scripts/check-outward-text.ts!",
        "scripts/ci-change-scope.ts!",
        "scripts/ci-flakes.ts!",
        "scripts/dev-db.ts!",
        "scripts/stamp-source-mtimes.ts!",
        "scripts/apple-simulator-build-cache.ts!",
        "scripts/benchmark-apple-runner.ts!",
        "scripts/pristine-simulator-cache.ts!",
        "scripts/generator/ensure.ts!"
      ],
      "project": ["neon.ts!", "scripts/**/*.ts!"],
      // Invoked as child commands beyond Knip's script parser; agent-device is
      // spawned by the simulator runner in apps/web/tooling/sim-e2e.ts.
      // neon-env is installed for interactive branch environment commands.
      "ignoreDependencies": [
        "vitest",
        "vite",
        "concurrently",
        "agent-device",
        "@neon/env"
      ],
      // xcode-select: scripts/apple-check.sh (the `apple` Nx target) uses it
      // to detect a machine without Xcode (so it can skip, not fail). pkill:
      // apple.ts quits the running Mac app before relaunching. container: the
      // Apple test-service runtime. All are system tools, never npm
      // dependencies.
      "ignoreBinaries": ["xcode-select", "pkill", "container", "wrangler"]
    },
    "apps/web": {
      "entry": [
        "src/start.ts!",
        "src/router.tsx!",
        "src/routes/**/*.{ts,tsx}!",
        "src/server.ts!",
        "src/cf-server.ts!",
        "vite.config.ts!",
        "e2e.config.ts!",
        "src/styles.css!",
        "src/lib/recipebridge-cf.ts!",
        "src/lib/sentry-cf-shim.ts!",
        "src/integrations/**/*.{ts,tsx}!",
        "src/contracts/index.ts!",
        "src/lib/generated/http-resources.gen.ts!",
        // The `<entity>ListItem` exports name the OpenAPI components; the
        // generator reads them, nothing in the web app does.
        "src/entity/generated/entity-lists.gen.ts!",
        // Type-only port existence checks; nothing imports them by design.
        "src/entity/generated/entity-port-checks.gen.ts!",
        // Read only through `import()` types in the global worker-configuration.d.ts.
        "src/server/worker-bindings.ts!",
        // Opt-in `live-eval` vitest project (billed model evals).
        "src/**/*.live-eval.ts!",
        "tests/**/*.{ts,tsx}!",
        "scripts/check-client-bundle.ts!",
        "scripts/worker-type-imports.ts!",
        "scripts/check-server-closure.ts!",
        "scripts/e2e-affected.ts!",
        "scripts/generate-spec-areas.ts!",
        "scripts/read-performance.ts!",
        "scripts/apple-preview-fixtures.ts!",
        "tooling/**/*.{ts,tsx}!",
        "tooling/e2e-db-watchdog.mjs!",
        "drizzle.config.ts!"
      ],
      // Test seams (fixtures, mocks, harnesses) are reached only from tests;
      // production mode leaves them out of the file graph.
      "project": [
        "src/**/*.{ts,tsx}!",
        "scripts/**/*.{ts,mjs}!",
        "!src/**/*.fixtures.{ts,tsx}!",
        "!src/**/*-test-helpers.{ts,tsx}!",
        "!src/lib/test/**!",
        "!src/server/testing/**!",
        "!src/server/repo/database-helpers/mock-db.ts!"
      ],
      "paths": {
        "~/*": ["./src/*"],
        "tooling/*": ["./tooling/*"]
      },
      "ignoreBinaries": [
        "tsgo",
        "rsvg-convert",
        "magick",
        "apple",
        "openssl",
        "security",
        "ditto",
        "osascript",
        "screencapture"
      ],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "@testing-library/.+",
        "@vitest/.+",
        "@tailwindcss/vite",
        "cloudflare",
        "vite-plugin-wasm",
        "vite-plugin-top-level-await"
      ],
      "vitest": { "config": "vitest.config.ts" },
      // Analyze the config imports above without executing local startup guards.
      "vite": { "config": [] },
      "playwright": { "config": "playwright.config.ts" }
    },
    "apps/purchase-agent": {
      "entry": [
        "src/app.ts!",
        "src/cloudflare.ts!",
        "src/purchase-import-run.ts!",
        "src/**/*.unit.test.ts!",
        "flue.config.ts!",
        "vite.config.ts!"
      ],
      "project": ["src/**/*.ts!", "*.ts!"],
      "ignoreDependencies": ["cloudflare"],
      "vitest": { "config": "vitest.config.ts" }
    },
    "apps/mcp-apps": {
      "entry": [
        "src/bundles.ts!",
        "build.mjs!",
        "vite.config.ts!",
        "src/usda-picker-entry.ts!",
        "harness/{host.ts,vite.config.ts}!"
      ],
      "project": ["src/**/*.ts!", "harness/**/*.ts!"],
      "vitest": { "config": "vitest.config.ts" },
      // Consumed by `src/app.css`'s @import, which knip doesn't follow.
      "ignoreDependencies": ["@cubby/design-tokens"]
    },
    "apps/usda-api": {
      "entry": [
        "src/worker.ts!",
        "src/local-dev.ts!",
        "src/db/import-usda.ts!",
        "src/**/*.test.ts!",
        "scripts/**/*.ts!",
        "drizzle.config.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/schemas": {
      "entry": [
        "src/index.ts!",
        "src/**/*.test.ts!",
        "src/entity-definitions/*.entity.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/shared": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/usda": {
      "entry": ["src/index.ts!", "src/contract.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/worker-tracing": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  // Run with --no-gitignore (project.json): generated modules are gitignored
  // but import hand-written code, so knip must read them. These are the
  // gitignored trees that are not source.
  "ignore": [
    ".claude/**",
    "**/dist/**",
    "**/.wrangler/**",
    "apps/apple/**",
    "apps/web/src/ui/primitives/context-menu.tsx"
  ],
  "ignoreDependencies": ["zod"],
  "ignoreBinaries": ["wasm-pack", "vitest"],
  "ignoreWorkspaces": ["packages/wasm"],
  "rules": {
    "duplicates": "error",
    "cycles": "error"
  },
  "tags": ["-lintignore"]
}
