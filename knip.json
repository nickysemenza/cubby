{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    // Root-level gate scripts. They are listed individually rather than as a
    // `scripts/**` glob so knip still reports a genuinely orphaned script.
    // `mtime.ts` is deliberately absent — it is reached through the
    // `ensure-*` imports, so knip should keep proving that.
    ".": {
      "entry": [
        "scripts/format-changed.ts!",
        "scripts/check-sql-safety.ts!",
        "scripts/check-soft-delete-filters.ts!",
        "scripts/check-unsafe-identifiers.unit.test.ts!",
        "scripts/check-markdown-links.ts!",
        "scripts/check-security-audit.ts!",
        "scripts/ci-scope.ts!",
        "scripts/ci-scope.test.ts!",
        "scripts/ensure-wasm.ts!",
        "scripts/ensure-mcp-apps.ts!",
        "scripts/setup-agent-environment.ts!",
        "scripts/entity-literal-generator.ts!",
        "scripts/entity-literals/entities/*.entity.ts!"
      ],
      "project": ["scripts/**/*.ts!"]
    },
    "apps/web": {
      "entry": [
        "src/start.ts!",
        "src/router.tsx!",
        "src/routes/**/*.{ts,tsx}!",
        "src/server.ts!",
        "src/sw.ts!",
        "src/styles.css!",
        "src/lib/recipebridge-cf.ts!",
        "src/lib/sentry-cf-shim.ts!",
        "src/integrations/**/*.{ts,tsx}!",
        "src/**/*.test.{ts,tsx}!",
        "tests/**/*.{ts,tsx}!",
        "scripts/analyze-client-bundle.ts!",
        "scripts/analyze-client-bundle.unit.test.ts!",
        "scripts/build-sw.mjs!",
        "scripts/ensure-db-extensions.ts!",
        "tooling/**/*.{ts,tsx}!",
        "drizzle.config.ts!",
        "instrument.server.mjs!"
      ],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.{ts,mjs}!"],
      "paths": {
        "~/*": ["./src/*"],
        "tooling/*": ["./tooling/*"]
      },
      "ignoreBinaries": ["tsgo", "rsvg-convert", "magick"],
      "ignoreDependencies": [
        "@fontsource-variable/inter",
        "@fontsource-variable/jetbrains-mono",
        "@fontsource-variable/space-grotesk",
        "@testing-library/.+",
        "@vitest/.+",
        "@tailwindcss/postcss",
        "@tailwindcss/vite",
        "postcss",
        "@opentelemetry/.+",
        "@tanstack/router-plugin",
        "vite-plugin-wasm",
        "vite-plugin-top-level-await",
        "rollup"
      ],
      "vitest": { "config": "vitest.config.ts" },
      "playwright": { "config": "playwright.config.ts" }
    },
    "apps/mcp-apps": {
      "entry": [
        "src/bundles.ts!",
        "build.mjs!",
        "vite.config.ts!",
        "src/usda-picker.ts!",
        "harness/{host.ts,vite.config.ts}!"
      ],
      "project": ["src/**/*.ts!", "harness/**/*.ts!"],
      "vitest": { "config": "vitest.config.ts" },
      // Consumed by `src/app.css`'s @import, which knip doesn't follow.
      "ignoreDependencies": ["@cubby/design-tokens"]
    },
    "apps/upc-lookup": {
      "entry": [
        "src/index.tsx!",
        "src/**/*.test.ts!",
        "vite.config.ts!",
        "drizzle.config.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}!"]
    },
    "apps/usda-api": {
      "entry": [
        "src/worker.ts!",
        "src/**/*.test.ts!",
        "scripts/**/*.ts!",
        "drizzle.config.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "packages/schemas": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/shared": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/upc-contract": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/usda-contract": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/usda-schemas": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/worker-tracing": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "ignore": [
    ".claude/workflows/**",
    "apps/web/src/components/ui/context-menu.tsx"
  ],
  "ignoreDependencies": ["zod"],
  "ignoreBinaries": ["wasm-pack", "vitest"],
  "ignoreWorkspaces": ["packages/wasm"],
  "rules": {
    "duplicates": "error",
    "cycles": "error"
  },
  "tags": ["-lintignore"]
}
