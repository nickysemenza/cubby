{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    // Root-level gate scripts and Apple host tooling. They are listed
    // individually rather than as a glob so knip still reports a genuinely
    // orphaned script. Web tooling entries live in the apps/web workspace.
    ".": {
      "entry": [
        "neon.ts!",
        "apps/apple/tooling/apple.ts!",
        "apps/apple/tooling/apple-release.ts!",
        "scripts/ensure.ts!",
        "scripts/design-tokens.ts!"
      ],
      "project": [
        "neon.ts!",
        "scripts/**/*.ts!",
        "apps/apple/tooling/**/*.ts!"
      ],
      // Invoked as child commands beyond Knip's script parser; agent-device is
      // spawned by the simulator runner in apps/web/tooling/sim-e2e.ts.
      // neon-env is installed for interactive branch environment commands.
      "ignoreDependencies": [
        // Invoked directly by .husky/pre-commit, without a package-manager process.
        "lint-staged",
        "vitest",
        "vite",
        "concurrently",
        "agent-device",
        "@neon/env",
        // scripts/tsc.ts resolves its bin through import.meta.resolve.
        "tsrs"
      ],
      // xcode-select: apps/apple/tooling/apple-check.sh (the `apple` Nx targets) uses it
      // to detect a machine without Xcode (so it can skip, not fail). pkill:
      // apple.ts quits the running Mac app before relaunching. container: the
      // Apple test-service runtime. All are system tools, never npm
      // dependencies.
      "ignoreBinaries": [
        "xcode-select",
        "plutil",
        "pkill",
        "container",
        "wrangler"
      ]
    },
    "apps/web": {
      "entry": [
        "src/start.ts!",
        "src/router.tsx!",
        "src/routes/**/*.{ts,tsx}!",
        "src/server.ts!",
        "src/cf-server.ts!",
        "vite.config.ts!",
        "cloudflare.config.ts!",
        "src/styles.css!",
        "src/lib/sentry-cf-shim.ts!",
        "src/integrations/**/*.{ts,tsx}!",
        "src/contracts/index.ts!",
        // The `<entity>ListItem` exports name the generated client models; the
        // generator reads them, nothing in the web app does.
        "src/server/entity-reads/list-contracts.ts!",
        // Type-only port existence checks; nothing imports them by design.
        "src/entity/generated/entity-port-checks.gen.ts!",
        "src/server/generated/entity-port-checks.gen.ts!",
        // Read only through `import()` types in the global worker-environment.d.ts.
        "src/server/worker-bindings.ts!",
        // Opt-in `live-eval` vitest project (billed model evals).
        "src/**/*.live-eval.ts!",
        "tests/**/*.{ts,tsx}!",
        "tooling/**/*.{ts,tsx}!",
        "generator/main.ts!",
        // `generate:claude-plugin` rewrites the committed Claude plugin.
        "generator/claude-plugin.ts!",
        "tooling/e2e-db-watchdog.mjs!",
        "drizzle*.config.ts!"
      ],
      // Test seams (fixtures, mocks, harnesses) are reached only from tests;
      // production mode leaves them out of the file graph.
      "project": [
        "src/**/*.{ts,tsx}!",
        "generator/**/*.ts!",
        "!src/**/*.fixtures.{ts,tsx}!",
        "!src/**/*-test-helpers.{ts,tsx}!",
        "!src/lib/test/**!",
        "!src/server/testing/**!"
      ],
      "paths": {
        "~/*": ["./src/*"],
        "tooling/*": ["./tooling/*"]
      },
      "ignoreBinaries": [
        "rsvg-convert",
        "magick",
        "apple",
        "openssl",
        "security",
        "ditto",
        "osascript",
        "screencapture"
      ],
      "ignoreDependencies": [
        "@testing-library/.+",
        "@vitest/.+",
        "@tailwindcss/vite",
        "cloudflare",
        "vite-plugin-wasm",
        "vite-plugin-top-level-await"
      ],
      "vitest": { "config": "vitest.config.ts" },
      // Analyze the config imports above without executing local startup guards.
      "vite": { "config": [] },
      "playwright": { "config": "playwright.config.ts" }
    },
    "packages/schemas": {
      // Private package: an export no workspace imports is dead, not public API.
      // Consumers knip cannot trace (the native generator names Swift models
      // after export names; generated modules and `import()` type queries)
      // keep their export with an `@public` tag naming that consumer.
      "includeEntryExports": true,
      "entry": [
        "src/index.ts!",
        "src/**/*.test.ts!",
        "src/**/*.typecheck.ts!",
        "src/entity-definitions/*.entity.ts!"
      ],
      "project": ["src/**/*.ts!"]
    },
    "apps/nx-cache": {
      // Native config names the Worker entry as a string; static HTML loads the dashboard.
      "entry": [
        "src/index.ts!",
        "public/dashboard.js!",
        "cloudflare.config.ts!",
        "vite.config.ts!"
      ]
    },
    "packages/shared": {
      "includeEntryExports": true,
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/usda": {
      "includeEntryExports": true,
      "entry": [
        "src/index.ts!",
        "src/contract.ts!",
        "src/**/*.test.ts!",
        "scripts/*.ts!"
      ],
      "project": ["src/**/*.ts!", "scripts/*.ts!"]
    },
    "packages/worker-tracing": {
      "entry": ["src/index.ts!", "src/**/*.test.ts!"],
      "project": ["src/**/*.ts!"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  // Run with --no-gitignore (project.json): generated modules are gitignored
  // but import hand-written code, so knip must read them. These are the
  // gitignored trees that are not source.
  "ignore": [
    "artifacts/**",
    "apps/web/src/server/.lint-fixture-*/**",
    ".claude/**",
    "**/dist/**",
    "**/.wrangler/**",
    "**/.cloudflare/**",
    "apps/apple/{App,CubbyKit,Generated,docs,e2e}/**"
  ],
  // Registry copies stay whole so `shadcn add --overwrite` diffs cleanly;
  // their unused parts are expected.
  "ignoreIssues": {
    // Generated package modules publish whole declaration sets; their
    // generator owns pruning, not the entry-export check.
    "packages/schemas/src/generated/**": ["exports", "types"],
    "packages/shared/src/generated/**": ["exports", "types"],
    "apps/web/src/ui/primitives/**": ["exports", "types"],
    "apps/web/src/ui/reui/**": ["exports", "types"]
  },
  "ignoreDependencies": ["zod"],
  "ignoreBinaries": ["wasm-pack", "vitest"],
  "ignoreWorkspaces": ["packages/wasm"],
  "rules": {
    "duplicates": "error",
    "cycles": "error"
  },
  "tags": ["-lintignore"]
}
