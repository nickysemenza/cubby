{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "recipebridge",
  "targets": {
    "rust": {
      "command": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo clippy --no-default-features -- -D warnings && cargo test",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "gate",
        // rust-toolchain.toml names a floating channel.
        {
          "runtime": "rustc -V"
        }
      ]
    }
  }
}
