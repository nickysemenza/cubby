# Gitignored files Claude Code and Codex copy into each managed worktree
# (gitignore syntax; only files that are BOTH gitignored AND matched here are
# copied). See README "Worktrees". Deliberately env-only — the WASM package is
# NOT copied (copying it blindly drifts stale); it's built per-worktree via
# `pnpm run wasm`, kept warm by a shared CARGO_TARGET_DIR and rebuilt-when-stale
# by scripts/ensure-wasm.mjs.

# Local env / secrets the dev server (and e2e) need
apps/web/.env
apps/web/.env.test
.env.local
.env*.local

# Incremental TypeScript caches. Contains only relative paths, so a copy stays
# valid at the new worktree path; tsc validates file hashes and rechecks
# whatever actually differs, so a stale one costs a miss and never correctness.
# Worth ~6s on a new worktree's first typecheck (7.1s cold -> ~0.8s warm on
# TS 7's native tsc). Copied, never shared — see apps/web/tsconfig.json on why
# a shared buildinfo path would have worktrees clobbering each other.
*.tsbuildinfo
