#!/usr/bin/env bash
# Amp orb setup (https://ampcode.com/docs/orbs). Runs once per fresh orb and
# again on a stale snapshot, so every step must be idempotent and cheap when
# its result is already present. Toolchain inventory: docs/ci.md (Node 24,
# pnpm 12.7.0, Rust/wasm-pack, external PostgreSQL/IntegreSQL on Linux,
# Playwright browsers).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# amp-headless and supervised orb services put ~/.local/bin ahead of
# /usr/local/bin, so tools linked there override the base image's versions.
bin_dir="$HOME/.local/bin"
mkdir -p "$bin_dir"
export PATH="$bin_dir:$PATH"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - started))s)"
}

install_system_packages() {
  if ! docker compose version >/dev/null 2>&1; then
    sudo DEBIAN_FRONTEND=noninteractive apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq docker-compose-plugin
  fi
}

# `pnpm dev` and `docker compose -p cubby up -d` (PostgreSQL tests) need
# Docker. Amp's processes do not carry the docker group, so the socket is
# owned by the user's primary group; socket activation starts the daemon on
# first use.
configure_docker() {
  local dropin=/etc/systemd/system/docker.socket.d/amp-orb.conf
  local expected=$'[Socket]\nSocketGroup=user'
  if [[ "$(cat "$dropin" 2>/dev/null)" != "$expected" ]]; then
    sudo mkdir -p "${dropin%/*}"
    printf '%s\n' "$expected" | sudo tee "$dropin" >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl stop docker.service docker.socket
  fi
  sudo systemctl enable --now docker.socket
}

install_node() {
  local major
  major="$(tr -d 'v[:space:]' < .nvmrc)"
  if [[ "$("$bin_dir/node" --version 2>/dev/null)" == "v$major."* ]]; then
    return
  fi
  local arch
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "unsupported architecture: $(uname -m)" >&2; return 1 ;;
  esac
  local base="https://nodejs.org/dist/latest-v$major.x"
  local tarball
  tarball="$(curl -fsSL "$base/SHASUMS256.txt" | awk -v a="linux-$arch.tar.xz" '$2 ~ a"$" {print $2}')"
  local dest="$HOME/.local/share/${tarball%.tar.xz}"
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/$tarball" "$base/$tarball"
  (cd "$tmp" && curl -fsSL "$base/SHASUMS256.txt" | grep " $tarball\$" | sha256sum -c --quiet -)
  rm -rf "$dest"
  mkdir -p "$dest"
  tar -xJf "$tmp/$tarball" -C "$dest" --strip-components=1
  rm -rf "$tmp"
  for tool in node npm npx corepack; do
    ln -sfn "$dest/bin/$tool" "$bin_dir/$tool"
  done
}

# rust-toolchain.toml pins the stable channel; WASM builds need the wasm32
# target, and CI's Rust lane runs rustfmt and clippy.
install_rust() {
  if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none
  fi
  "$HOME/.cargo/bin/rustup" toolchain install stable --profile minimal \
    --component rustfmt,clippy --target wasm32-unknown-unknown
  # scripts/rust-fingerprint.ts falls back to an online `cargo metadata` whose
  # download progress reaches the Nx runtime input, so an empty Cargo cache
  # changes the WASM cache key once. Fetching first keeps the key stable.
  "$HOME/.cargo/bin/cargo" fetch --locked --quiet
}

install_wasm_pack() {
  local version=0.15.0
  if [[ "$("$HOME/.cargo/bin/wasm-pack" --version 2>/dev/null)" != "wasm-pack $version" ]]; then
    local name="wasm-pack-v$version-$(uname -m)-unknown-linux-musl"
    curl -fsSL "https://github.com/wasm-bindgen/wasm-pack/releases/download/v$version/$name.tar.gz" \
      | tar -xz -C "$HOME/.cargo/bin" --strip-components=1 "$name/wasm-pack"
  fi
  # rustup proxies dispatch on their file name, so links keep working.
  local tool
  for tool in "$HOME"/.cargo/bin/*; do
    if [[ -f "$tool" && -x "$tool" ]]; then
      ln -sfn "$tool" "$bin_dir/"
    fi
  done
}

install_playwright_browser() {
  pnpm --filter @cubby/web run test:e2e:install-browser chromium
}

pull_database_images() {
  docker compose -p cubby pull --quiet --policy missing
}

step "System packages" install_system_packages
step "Docker socket" configure_docker
step "Node $(tr -d '[:space:]' < .nvmrc)" install_node
step "Rust toolchain" install_rust
step "wasm-pack" install_wasm_pack
# Frozen install, then the WASM package restored from Nx's cache or built.
step "pnpm agent:setup" pnpm agent:setup
step "Playwright Chromium" install_playwright_browser
step "Database images" pull_database_images
