{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "cubby-checks",
  "targets": {
    "generate": {
      "command": "pnpm generate:check && redocly lint apps/web/src/lib/generated/http-openapi.gen.json --config redocly.yaml",
      "cache": true,
      "inputs": ["repo"]
    },
    "types": {
      "command": "pnpm typecheck",
      "cache": true,
      "dependsOn": ["wasm"],
      "inputs": [
        "repo",
        {
          "dependentTasksOutputFiles": "packages/wasm/**/*"
        }
      ]
    },
    "lint": {
      "command": "oxlint .",
      "cache": true,
      "inputs": [
        "repo",
        "!{workspaceRoot}/**/*.mdx",
        "!{workspaceRoot}/**/*.rs",
        "!{workspaceRoot}/**/*.toml",
        "!{workspaceRoot}/**/*.lock"
      ]
    },
    "format": {
      "command": "oxfmt --check .",
      "cache": true,
      "inputs": [
        "repo",
        "!{workspaceRoot}/**/*.mdx",
        "!{workspaceRoot}/**/*.rs",
        "!{workspaceRoot}/**/*.toml",
        "!{workspaceRoot}/**/*.lock"
      ]
    },
    "knip": {
      "command": "knip --no-config-hints",
      "cache": true,
      "inputs": ["repo"]
    },
    "bindings": {
      "command": "pnpm --filter @cubby/web --filter @cubby/upc-lookup --filter @cubby/usda-api --filter @cubby/purchase-agent --workspace-concurrency=2 types:check",
      "cache": false
    },
    "openapi": {
      "command": "pnpm --filter @cubby/usda-api generate:openapi:check",
      "cache": false
    },
    // Apple `#Preview` fixtures generated from the zod schemas; runs here, not in
    // apple-check.sh, because the macOS Apple CI job has no Node toolchain.
    "preview-fixtures": {
      "command": "pnpm --dir apps/web run gen:apple-preview-fixtures:check",
      "cache": true,
      "inputs": ["repo"]
    },
    "script-tests": {
      "command": "pnpm test:scripts",
      "cache": false
    },
    "security": {
      "command": "pnpm audit:security",
      "cache": false
    },
    "fast-tests": {
      // Aux packages (apps/mcp-apps, apps/upc-lookup, apps/usda-api,
      // packages/*) run through their own cached `test` target
      // (targetDefaults above) instead of `pnpm -r --workspace-concurrency=2
      // test`: an aux-untouched run replays from cache instead of competing
      // with the heavier web Vitest run for CPU. This orchestration target is
      // deliberately uncached: child targets own their complete cache keys and
      // output restoration, so an outer replay can never bypass them.
      "command": "nx run-many -t test --exclude=cubby-checks --output-style=static-failures-only",
      "cache": false,
      "dependsOn": ["wasm"]
    },
    "wasm": {
      // On CI, setup-node-with-deps (wasm: restore) already restored or built
      // packages/wasm for these exact recipebridge sources and exports
      // CUBBY_WASM_PKG_READY=1; a fresh runner has no Nx cache, so without
      // this every `dependsOn: ["wasm"]` rebuilt it (~90s in Validation).
      "command": "if [ \"${CUBBY_WASM_PKG_READY:-}\" = 1 ] && [ -f packages/wasm/recipebridge_bg.wasm ]; then echo 'wasm: packages/wasm already provided by setup-node-with-deps'; else pnpm run wasm; fi",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/recipebridge/**/*",
        "{workspaceRoot}/packages/wasm/package.json",
        "{workspaceRoot}/packages/wasm/.gitignore",
        "{workspaceRoot}/scripts/ensure-wasm.ts",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": []
        },
        {
          "runtime": "node scripts/ensure-wasm.ts --fingerprint"
        }
      ],
      "outputs": ["{workspaceRoot}/packages/wasm"]
    },
    "apple-ffi": {
      "command": "node scripts/ensure-apple-ffi.ts --build",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/cubby-ffi/**/*",
        "{workspaceRoot}/recipebridge/**/*",
        "{workspaceRoot}/apps/apple/scripts/build-rust.sh",
        "{workspaceRoot}/scripts/ensure-apple-ffi.ts",
        "{workspaceRoot}/scripts/rust-fingerprint.ts",
        {
          "externalDependencies": []
        },
        {
          "runtime": "node scripts/ensure-apple-ffi.ts --fingerprint"
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/apple/CubbyKit/Frameworks/CubbyFFI.xcframework",
        "{workspaceRoot}/apps/apple/CubbyKit/Sources/CubbyFFI/cubby_ffi.swift"
      ]
    }
  }
}
