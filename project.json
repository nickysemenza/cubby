{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "cubby-checks",
  "targets": {
    // scripts/ensure.ts generate runs this target, so every entry point that
    // needs generated output gets a cache hit (which also restores a missing
    // or edited output) while these inputs are unchanged. Generated output is
    // ignored by Nx's file map, so it never feeds its own key.
    "generate": {
      "command": "tsx --tsconfig apps/web/tsconfig.json scripts/generator/main.ts && redocly lint apps/web/src/lib/generated/http-openapi.gen.json --config redocly.yaml",
      "cache": true,
      "inputs": [
        // Every root the generator reads: its own code, the packages the
        // declarations and contracts import, the web app (contracts, routes,
        // list sources), and the preview-fixture builder in apps/web/scripts.
        "{workspaceRoot}/scripts/generator/**/*",
        "{workspaceRoot}/scripts/lib/tree-digest.ts",
        "{workspaceRoot}/packages/**/*",
        "{workspaceRoot}/apps/web/src/**/*",
        "{workspaceRoot}/apps/web/scripts/apple-preview-fixtures.ts",
        // Purchase-import prompt sources (scripts/generator/agent-prompts.ts).
        "{workspaceRoot}/.claude/skills/purchase-import/references/*.md",
        // The R2 public origin generated into `SharedConstants.swift`.
        "{workspaceRoot}/apps/web/wrangler.jsonc",
        "{workspaceRoot}/apps/web/tooling/wrangler-public-config.ts",
        "{workspaceRoot}/apps/web/tsconfig.json",
        // The entity-declaration import-boundary override (import-boundary.ts).
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/redocly.yaml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        { "runtime": "node --version" }
      ],
      // The hand-written routes beside the generated ones are inputs too, so
      // a cache hit restores them byte-for-byte.
      "outputs": [
        "{workspaceRoot}/apps/web/src/**/*.gen.{ts,json}",
        "{workspaceRoot}/apps/web/src/routes/_authenticated/.gitignore",
        "{workspaceRoot}/apps/web/src/routes/_authenticated/*.tsx",
        "{workspaceRoot}/packages/schemas/src/generated",
        "{workspaceRoot}/packages/shared/src/generated",
        "{workspaceRoot}/apps/apple/Generated",
        "{workspaceRoot}/apps/apple/App/Shared/Previews/Fixtures",
        "{workspaceRoot}/apps/apple/CubbyKit/Sources/CubbyKit/Generated",
        "{workspaceRoot}/apps/apple/CubbyKit/Sources/CubbyAPISupport/Generated",
        "{workspaceRoot}/apps/apple/CubbyKit/Sources/CubbyAPI/openapi.json",
        "{workspaceRoot}/apps/apple/CubbyKit/Sources/CubbyAPI/openapi-generator-config.yaml",
        "{workspaceRoot}/docs/guide/how-values-are-determined.md"
      ]
    },
    "types": {
      "command": "pnpm typecheck",
      "cache": true,
      "dependsOn": ["wasm", "generate"],
      "inputs": [
        "repo",
        {
          "dependentTasksOutputFiles": "packages/wasm/**/*"
        }
      ]
    },
    // Generated brand CSS, Apple metrics and color assets match tokens.json.
    "design-tokens": {
      "command": "pnpm check:design-tokens",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/design-tokens/**/*",
        "{workspaceRoot}/scripts/design-tokens.ts",
        "{workspaceRoot}/apps/apple/App/Shared/Theme/FieldGuideMetrics.swift",
        "{workspaceRoot}/apps/apple/App/Assets.xcassets/**/*"
      ]
    },
    "lint": {
      "command": "oxlint .",
      "cache": true,
      "inputs": ["lintable"]
    },
    "format": {
      "command": "oxfmt --check .",
      "cache": true,
      "inputs": ["formattable"]
    },
    "knip": {
      "command": "knip --no-config-hints --no-gitignore && pnpm knip:production",
      // Knip loads vitest.config.ts, whose ensures defer to this graph.
      "dependsOn": ["wasm", "generate"],
      "cache": true,
      "inputs": ["repo"]
    },
    // .github/ci-lanes.yml matches the Nx inputs of each CI lane's tasks.
    "ci-lanes": {
      "command": "node scripts/ci-lanes.ts --check",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/**/project.json",
        "{workspaceRoot}/**/package.json",
        "{workspaceRoot}/scripts/ci-lanes.ts",
        "{workspaceRoot}/.github/ci-lanes.yml"
      ]
    },
    "bindings": {
      "command": "pnpm --filter @cubby/web types:check",
      "cache": true,
      "inputs": ["gate"]
    },
    "script-tests": {
      "command": "pnpm test:scripts",
      "cache": true,
      "inputs": ["gate"]
    },
    "fast-tests": {
      // Aux packages (packages/*) run through their own cached `test` target
      // (targetDefaults above) instead of `pnpm -r --workspace-concurrency=2
      // test`: an aux-untouched run replays from cache instead of competing
      // with the heavier web Vitest run for CPU. This orchestration target is
      // deliberately uncached: child targets own their complete cache keys and
      // output restoration, so an outer replay can never bypass them.
      "command": "nx run-many -t test --exclude=cubby-checks --output-style=static-failures-only",
      "cache": false,
      "dependsOn": ["wasm", "generate"]
    },
    "wasm": {
      "command": "pnpm run wasm",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/recipebridge/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/packages/wasm/package.json",
        "{workspaceRoot}/packages/wasm/.gitignore",
        "{workspaceRoot}/scripts/ensure.ts",
        "{workspaceRoot}/scripts/rust-fingerprint.ts",
        "{workspaceRoot}/scripts/lib/tree-digest.ts",
        "{workspaceRoot}/package.json",
        {
          "externalDependencies": []
        },
        {
          "runtime": "node scripts/ensure.ts wasm --fingerprint"
        }
      ],
      "outputs": ["{workspaceRoot}/packages/wasm"]
    },
    "apple-ffi": {
      "command": "node scripts/ensure.ts apple-ffi --build",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/cubby-ffi/**/*",
        "{workspaceRoot}/recipebridge/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/apps/apple/scripts/build-rust.sh",
        "{workspaceRoot}/scripts/ensure.ts",
        "{workspaceRoot}/scripts/rust-fingerprint.ts",
        {
          "externalDependencies": []
        },
        {
          "runtime": "node scripts/ensure.ts apple-ffi --fingerprint"
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/apple/CubbyKit/Frameworks/CubbyFFI.xcframework",
        "{workspaceRoot}/apps/apple/CubbyKit/Sources/CubbyFFI/cubby_ffi.swift"
      ]
    }
  }
}
