diff --git a/dist/index.js b/dist/index.js
--- a/dist/index.js
+++ b/dist/index.js
@@ -11,6 +11,7 @@
         this.ssl = ssl;
         this.writable = false;
         this.destroyed = false;
+        this._writeOrdinal = 0;
         this._upgrading = false;
         this._upgraded = false;
         this._cfSocket = null;
@@ -37,7 +38,15 @@
             const options = this.ssl ? { secureTransport: 'starttls' } : {};
             const mod = await import('cloudflare:sockets');
             const connect = mod.connect;
+            this.emit('socketOpening');
             this._cfSocket = connect(`${host}:${port}`, options);
+            // Observe native opening without delaying the existing pipelined startup.
+            if (this.listenerCount('socketOpened') || this.listenerCount('socketOpenFailed')) {
+                void this._cfSocket.opened.then(
+                    () => this.emit('socketOpened'),
+                    () => this.emit('socketOpenFailed')
+                );
+            }
             this._cfWriter = this._cfSocket.writable.getWriter();
             this._addClosedHandler();
             this._cfReader = this._cfSocket.readable.getReader();
@@ -85,11 +94,15 @@
         if (typeof data === 'string')
             data = Buffer.from(data, encoding);
         log('sending data direct:', data);
+        const ordinal = ++this._writeOrdinal;
+        this.emit('writeStarted', ordinal);
         this._cfWriter.write(data).then(() => {
             log('data sent');
+            this.emit('writeCompleted', ordinal);
             callback();
         }, (err) => {
             log('send error', err);
+            this.emit('writeFailed', ordinal);
             callback(err);
         });
         return true;
