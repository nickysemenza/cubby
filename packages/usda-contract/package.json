{
  "name": "@cubby/usda-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "typecheck:stable": "tsc --noEmit",
    "lint": "biome lint",
