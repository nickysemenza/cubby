{
  "name": "@cubby/recipebridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./worker/recipebridge.js",
    "./browser/recipebridge.js",
    "./cookbook/recipebridge_cookbook.js",
    "./*/snippets/*"
  ],
  "main": "worker/recipebridge.js",
  "types": "worker/recipebridge.d.ts",
  "exports": {
    ".": {
      "types": "./worker/recipebridge.d.ts",
      "default": "./worker/recipebridge.js"
    },
    "./cookbook": {
      "types": "./cookbook/recipebridge_cookbook.d.ts",
      "default": "./cookbook/recipebridge_cookbook.js"
    }
  }
}
