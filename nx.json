{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "parallel": 4,
  "maxCacheSize": "4GB",
  "tui": {
    "enabled": false
  },
  "defaultBase": "origin/main",
  "namedInputs": {
    // What oxlint and oxfmt read: the repo minus the file types neither checks.
    "lintable": [
      "repo",
      "!{workspaceRoot}/**/*.mdx",
      "!{workspaceRoot}/**/*.rs",
      "!{workspaceRoot}/**/*.toml",
      "!{workspaceRoot}/**/*.lock"
    ],
    "formattable": [
      "{workspaceRoot}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,json5,css,scss,less,graphql,gql,md,mdx,markdown,yaml,yml,toml}",
      "{workspaceRoot}/.oxfmtrc.json",
      "{workspaceRoot}/.editorconfig",
      // The same Apple files .oxfmtrc.json ignores.
      "!{workspaceRoot}/apps/apple/**/*.{json,ts,tsx,js,jsx}"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/nx.json",
      {
        "runtime": "node --version"
      },
      {
        "runtime": "node -p \"process.platform + process.arch\""
      },
      {
        "env": "NODE_OPTIONS"
      },
      {
        "env": "CI"
      }
    ],
    // Whole-tree scope for cubby-checks' repo-wide gates (generate, types,
    // lint, format, knip): a project-scoped `default` narrows every other
    // project to `{projectRoot}`, but these targets genuinely read the whole
    // tree. Apple/Rust native sources and prose never change their output.
    "repo": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/apps/apple/**/*.{json,ts,tsx,js,jsx}",
      "!{workspaceRoot}/cubby-ffi/**",
      "!{workspaceRoot}/**/*.md",
      "!{workspaceRoot}/.claude/**"
    ],
    // Result passes include execution identity; portable generation/WASM keep
    // their narrower artifact inputs; source coverage remains broad.
    "gate": [
      "{workspaceRoot}/**/*",
      { "runtime": "node scripts/ci-environment.ts web" },
      "!{workspaceRoot}/**/*.{md,mdx,MD,markdown}",
      "!{workspaceRoot}/.claude/**",
      // Workflows that deploy, publish or review run no check.
      "!{workspaceRoot}/.github/workflows/{deploy.yaml,deploy-nx-cache.yaml,apple-testflight.yaml,claude.yml}",
      {
        "runtime": "git ls-files -z -co --exclude-standard -- docs .claude/skills/purchase-import .claude/skills/product-enrichment .claude/skills/photo-inventory-import | xargs -0 shasum -a 256"
      }
    ],
    // What Cargo reads for the recipebridge and cubby-ffi merge-gate lanes:
    // the workspace crates, the golden vectors their tests read, and the CI
    // configuration that runs them. rust-toolchain.toml names a floating
    // channel, so the compiler version is keyed too.
    "rustGate": [
      "{workspaceRoot}/recipebridge/**/*",
      "{workspaceRoot}/cubby-ffi/**/*",
      "{workspaceRoot}/Cargo.{toml,lock}",
      "{workspaceRoot}/rust-toolchain.toml",
      // Cargo, rustfmt, and Clippy read configuration from ancestor directories.
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/{.rustfmt,rustfmt,.clippy,clippy}.toml",
      "{workspaceRoot}/packages/shared/golden-vectors/**/*",
      "{workspaceRoot}/.github/workflows/ci.yaml",
      "{workspaceRoot}/.github/actions/**/*",
      "{workspaceRoot}/scripts/check-rust.ts",
      { "runtime": "rustc -V" },
      { "runtime": "node --version" },
      { "env": "RUSTFLAGS" },
      { "env": "CARGO_ENCODED_RUSTFLAGS" },
      { "env": "CARGO_BUILD_WARNINGS" },
      { "runtime": "node -p \"process.platform + process.arch\"" },
      // Cargo never reads JavaScript dependencies, which Nx hashes by default.
      { "externalDependencies": [] }
    ]
  },
  "analytics": false,
  "targetDefaults": {
    "nx:run-commands": {
      "inputs": ["default"],
      "outputs": []
    },
    // Every package.json-inferred `test` target (the aux packages under
    // apps/* and packages/*) is a merge-gate lane; a project-scoped key would
    // reuse a pass after a dependency it imports changed.
    "test": {
      "cache": true,
      "inputs": ["gate"]
    }
  }
}
