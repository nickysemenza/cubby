{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "parallel": 4,
  "maxCacheSize": "4GB",
  "tui": {
    "enabled": false
  },
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/nx.json",
      {
        "runtime": "node --version"
      },
      {
        "runtime": "node -p \"process.platform + process.arch\""
      },
      {
        "env": "NODE_OPTIONS"
      },
      {
        "env": "CI"
      }
    ],
    // Whole-tree scope for cubby-checks' repo-wide gates (generate, types,
    // lint, format, knip): a project-scoped `default` narrows every other
    // project to `{projectRoot}`, but these targets genuinely read the whole
    // tree. Apple/Rust native sources and prose never change their output.
    "repo": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/apps/apple/**",
      "!{workspaceRoot}/cubby-ffi/**",
      "!{workspaceRoot}/**/*.md",
      "!{workspaceRoot}/.claude/**"
    ]
  },
  "analytics": false,
  "targetDefaults": {
    "nx:run-commands": {
      "inputs": ["default"],
      "outputs": []
    },
    // Applies to every package.json-inferred `test` target (the aux packages
    // under apps/* and packages/*); `{projectRoot}` resolves per-project.
    // apps/web/project.json replaces these narrow inputs with its complete
    // cross-workspace/runtime contract while retaining target-level caching.
    "test": {
      "cache": true,
      "inputs": ["{projectRoot}/**/*"]
    }
  }
}
