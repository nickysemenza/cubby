{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "parallel": 4,
  "maxCacheSize": "4GB",
  "tui": {
    "enabled": false
  },
  "defaultBase": "origin/main",
  "namedInputs": {
    // What oxlint and oxfmt read: the repo minus the file types neither checks.
    "lintable": [
      "repo",
      "!{workspaceRoot}/**/*.mdx",
      "!{workspaceRoot}/**/*.rs",
      "!{workspaceRoot}/**/*.toml",
      "!{workspaceRoot}/**/*.lock"
    ],
    "formattable": [
      "{workspaceRoot}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,json5,css,scss,less,graphql,gql,md,mdx,markdown,yaml,yml,toml}",
      "{workspaceRoot}/.oxfmtrc.json",
      "{workspaceRoot}/.editorconfig",
      // The same Apple files .oxfmtrc.json ignores.
      "!{workspaceRoot}/apps/apple/**/*.{json,ts,tsx,js,jsx}"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/nx.json",
      {
        "runtime": "node --version"
      },
      {
        "runtime": "node -p \"process.platform + process.arch\""
      },
      {
        "env": "NODE_OPTIONS"
      },
      {
        "env": "CI"
      }
    ],
    // Whole-tree scope for cubby-checks' repo-wide gates (generate, types,
    // lint, format, knip): a project-scoped `default` narrows every other
    // project to `{projectRoot}`, but these targets genuinely read the whole
    // tree. Apple/Rust native sources and prose never change their output.
    "repo": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/apps/apple/**/*.{json,ts,tsx,js,jsx}",
      "!{workspaceRoot}/cubby-ffi/**",
      "!{workspaceRoot}/**/*.md",
      "!{workspaceRoot}/.claude/**"
    ],
    // Merge-gate test lanes (docs/adr/0009-content-hash-merge-gate.md). A
    // passing result for this hash satisfies the gate, so a false cache hit
    // skips a check that should have run: keep it broad. Every
    // non-documentation file (lockfile and CI configuration included) and the
    // Markdown that the Worker bundles or generation reads; Nx applies a
    // negation to every file input, so that Markdown is hashed at runtime.
    // Platform and Node version stay out so a developer Mac's pass counts as
    // CI's; the nightly CI run reruns every lane uncached as the backstop.
    "gate": [
      "{workspaceRoot}/**/*",
      "!{workspaceRoot}/**/*.{md,mdx,MD,markdown}",
      "!{workspaceRoot}/.claude/**",
      // Workflows that deploy, publish or review run no check.
      "!{workspaceRoot}/.github/workflows/{deploy.yaml,apple-testflight.yaml,claude.yml,claude-code-review.yml}",
      {
        "runtime": "git ls-files -z -co --exclude-standard -- docs/README.md docs/todos.md .claude/skills/purchase-import .claude/skills/product-enrichment .claude/skills/photo-inventory-import | xargs -0 shasum -a 256"
      }
    ]
  },
  "analytics": false,
  "targetDefaults": {
    "nx:run-commands": {
      "inputs": ["default"],
      "outputs": []
    },
    // Every package.json-inferred `test` target (the aux packages under
    // apps/* and packages/*) is a merge-gate lane; a project-scoped key would
    // reuse a pass after a dependency it imports changed.
    "test": {
      "cache": true,
      "inputs": ["gate"]
    }
  }
}
