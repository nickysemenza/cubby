{
  "$ref": "#/definitions/configuration",
  "definitions": {
    "configuration": {
      "type": "object",
      "properties": {
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "name of location"
              },
              "type": {
                "type": "string",
                "enum": [
                  "room",
                  "bag",
                  "shelf",
                  "crate",
                  "half-crate",
                  "table",
                  "drawer",
                  "cart",
                  "cabinet"
                ],
                "description": "type of location (room, container, etc)"
              },
              "products": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "upc": {
                      "type": "string",
                      "minLength": 12,
                      "maxLength": 14,
                      "description": "12 digit UPC code"
                    },
                    "ndb_number": {
                      "type": "number",
                      "maximum": 99999,
                      "minimum": 1000,
                      "description": "NDB number"
                    },
                    "manufacturer": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "ingredient": {
                      "type": "boolean",
                      "description": "if the product is an ingredient, an ingredient with the same name will be created and linked to this product"
                    },
                    "aliases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "alternative names for this ingredient"
                    },
                    "price_per": {
                      "type": "number",
                      "description": "price per each, shorthand for unit_mappings"
                    },
                    "unit_mappings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "manufacturer"
                  ],
                  "additionalProperties": false
                }
              },
              "productReferences": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/configuration/properties/locations/items"
                }
              }
            },
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false
          },
          "description": "locations that have inventoryable items"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/configuration/properties/locations/items/properties/products/items"
          },
          "description": "products that can be purchased"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "locations",
        "products"
      ],
      "additionalProperties": false,
      "description": "system config"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}