        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.live-eval.ts",
        "apps/web/src/ui/primitives/**",
        "apps/web/src/ui/reui/**"
      ],
      "rules": {
        "cubby/no-raw-table": "error",
        "cubby/no-hand-rolled-record-list": "error",
        "cubby/no-native-select": "error",
        "cubby/no-raw-value-control": "error"
      }
    },
    {
