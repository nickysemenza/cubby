{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "jsx-a11y",
    "vitest",
    "unicorn",
    "oxc"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "cubby",
      "specifier": "./tools/oxlint/cubby/index.ts"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/.output/**",
    "**/.vinxi/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/drizzle/**",
    "**/node_modules/**",
    "apps/web/src/ui/reui/**",
    "apps/web/src/ui/primitives/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/wasm/**",
    "**/worker-configuration.d.ts",
    "apps/apple/**",
    "cubby-ffi/**"
  ],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 20
      }
    ],
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-direct-query-invalidation": "error",
    "anti-slop/no-legacy-query-invalidation": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "allowInTypeGuards": true
      }
    ],
    "anti-slop/no-unsafe-sql-array-interpolation": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "cubby/no-unsafe-identifiers": "error",
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "typescript/no-explicit-any": "error",
    "react/exhaustive-deps": "error",
    "react/no-array-index-key": "error",
    "react/rules-of-hooks": "error",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/capitalized-calls": "off",
    "react/error-boundaries": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/globals": "off",
    "react/hooks": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/invariant": "off",
    "react/memo-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/rule-suppression": "off",
    "react/set-state-in-effect": "off",
    "react/set-state-in-render": "off",
    "react/static-components": "off",
    "react/syntax": "off",
    "react/todo": "off",
    "react/unsupported-syntax": "off",
    "react/use-memo": "off",
    "react/void-use-memo": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/web/src/server/services/**/*.ts",
        "apps/web/src/server/services/**/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "~/server/repo/database-helpers",
                "message": "Services cannot access DB helpers directly. Use repo functions instead."
              },
              {
                "name": "~/server/db/schema",
                "message": "Services cannot access DB schema directly. Use repo functions instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.fixtures.ts",
        "**/*.fixtures.tsx",
        "**/tests/**",
        "**/test/**",
        "**/__fixtures__/**",
        "**/test-support/**",
        "**/tooling/**",
        "packages/*/src/testing.ts"
      ],
      "rules": {
        "cubby/no-unsafe-identifiers": "off"
      }
    },
    {
      "files": ["apps/web/src/server/**/*.ts", "packages/*/src/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "cubby/require-soft-delete-filter": "error"
      }
    },
    {
      "files": [
        "apps/web/src/integrations/tanstack-query/operation-overrides.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-start",
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              },
              {
                "name": "@cubby/db",
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              }
            ],
            "patterns": [
              {
                "group": ["~/server/**"],
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              },
              {
                "group": ["~/features/ai/server-functions/**"],
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              }
            ]
          }
        ]
      }
    },
    {
      // The purchase agent reads untrusted content; it reaches Cubby only
      // through its narrowed environment (docs/infrastructure.md#purchase-agent).
      "files": ["apps/web/src/server/purchase-agent/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "cubby/purchase-agent-boundary": "error"
      }
    },
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.fixtures.ts",
        "**/*.fixtures.tsx",
        "**/tests/**",
        "**/test/**",
        "**/__fixtures__/**",
        "**/test-support/**",
        "**/tooling/**"
      ],
      "rules": {
        "cubby/no-swallowed-catch": "error",
        "cubby/no-error-toast-in-handler": "error"
      }
    },
    {
      "files": ["apps/web/src/ui/feedback/error-details.tsx"],
      "rules": {
        "cubby/no-error-toast-in-handler": "off"
      }
    },
    {
      "files": ["apps/web/tooling/test-setup.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../src/server/**",
                  "!../src/server/db/database",
                  "!../src/server/db/schema",
                  "!../src/server/db-pg-tracing"
                ],
                "allowTypeImports": true,
                "message": "test-setup.ts doubles as vitest's globalSetup, which runs before test.env applies, and most of ~/server pulls in env.ts validation that would fail there. Only db/database, db/schema, and db-pg-tracing are safe to import eagerly; import anything else lazily with import() inside the function that needs it."
              },
              {
                "group": ["../src/env", "~/env", "~/server/**"],
                "allowTypeImports": true,
                "message": "test-setup.ts doubles as vitest's globalSetup, which runs before test.env applies; an eager env/server import fails env.ts validation before it can pass. Import lazily with import() inside the function that needs it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/schemas/src/entity-definitions/**/*.ts",
        "packages/schemas/src/child-tables/**/*.ts",
        "packages/schemas/src/*-fields.ts",
        "packages/schemas/src/mailbox-research.ts",
        "packages/schemas/src/execution-authorization.ts",
        "packages/schemas/src/research-facts.ts",
        "packages/schemas/src/research-assessment.ts",
        "packages/schemas/src/base-entity.ts",
        "packages/schemas/src/codec.ts",
        "packages/schemas/src/group-keys.ts",
        "packages/schemas/src/data-quality-facets.ts",
        "packages/schemas/src/data-quality-shape.ts",
        "packages/schemas/src/expense-line-kind.ts",
        "packages/schemas/src/external-id.ts",
        "packages/schemas/src/field-resolution.ts",
        "packages/schemas/src/spending-classification.ts",
        "packages/schemas/src/financial-reconciliation.ts",
        "packages/schemas/src/purchase-evidence-policy.ts",
        "packages/schemas/src/emoji.ts",
        "packages/schemas/src/garden-guide.ts",
        "packages/schemas/src/garden-guides.ts",
        "packages/schemas/src/garden-practice.ts",
        "packages/schemas/src/image-summary.ts",
        "packages/schemas/src/inventory-ownership.ts",
        "packages/schemas/src/meal-classification.ts",
        "packages/schemas/src/meal-shared.ts",
        "packages/schemas/src/money.ts",
        "packages/schemas/src/nutrition.ts",
        "packages/schemas/src/photo-categories.ts",
        "packages/schemas/src/recipe-shared.ts",
        "packages/schemas/src/unitmapping.ts"
      ],
      "excludeFiles": ["**/*.test.ts", "packages/schemas/src/entity-fields.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)generated(/|$)",
                "message": "Entity declarations, and the helper modules they import, are the generator's input: they must not import generated artifacts, a canonical entity schema module (one built from generated field schemas), app code, or the WASM boundary. See docs/entities.md."
              },
              {
                "regex": "^(\\.{1,2}/|@cubby/schemas/)(device|run|financial-account|financial-transaction|garden-entry|image-sighting|image|ingredient|inventory|ledger-party|ledger-transfer|location|meal-nutrition|meal|plant|planting|product-category|product|project|purchase|recipe|usda|vendor-account|vendor|wish)(\\.[jt]s)?$",
                "message": "Entity declarations, and the helper modules they import, are the generator's input: they must not import generated artifacts, a canonical entity schema module (one built from generated field schemas), app code, or the WASM boundary. See docs/entities.md."
              },
              {
                "regex": "^(~/|@cubby/recipebridge(/|$))|(^|/)apps/",
                "message": "Entity declarations, and the helper modules they import, are the generator's input: they must not import generated artifacts, a canonical entity schema module (one built from generated field schemas), app code, or the WASM boundary. See docs/entities.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/server/**/*.ts",
        "apps/web/src/cf-server.ts",
        "packages/*/src/**/*.ts"
      ],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.live-eval.ts",
        "packages/worker-tracing/src/log.ts"
      ],
      "rules": {
        "cubby/no-raw-console": "error"
      }
    },
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.live-eval.ts",
        "apps/web/src/lib/number-format.ts",
        "apps/web/src/lib/utils.ts"
      ],
      "rules": {
        "cubby/no-ad-hoc-number-format": "error",
        "cubby/no-unbounded-page-size": "error"
      }
    },
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "apps/web/src/lib/household-date.ts"
      ],
      "rules": {
        "cubby/no-ad-hoc-calendar-day": "error"
      }
    },
    {
      "files": ["apps/web/src/server/**/*.ts"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.live-eval.ts",
        "apps/web/src/server/entity-kernel/execute.ts"
      ],
      "rules": {
        "cubby/no-kernel-action-guard": "error"
      }
    },
    {
      "files": ["apps/web/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.live-eval.ts",
        "apps/web/src/ui/primitives/**",
        "apps/web/src/ui/reui/**"
      ],
      "rules": {
        "cubby/no-raw-table": "error"
      }
    },
    {
      "files": [
        "apps/web/**/*.test.ts",
        "apps/web/**/*.test.tsx",
        "apps/web/tooling/**/*.ts",
        "apps/web/tests/**/*.ts"
      ],
      "rules": {
        "cubby/no-hand-parsed-create-input": "error"
      }
    },
    {
      "files": [
        "apps/web/src/features/ai/ai-usage-page.tsx",
        "apps/web/src/ui/charts/kit.tsx",
        "apps/web/src/features/developer/mcp-usage-dashboard.tsx",
        "apps/web/src/features/labels/label-summary.tsx",
        "apps/web/src/features/nutrition/NutrientDensityStats.tsx",
        "apps/web/src/features/performance/index.tsx",
        "apps/web/src/features/recipes/RecipeMagazineView.tsx",
        "apps/web/src/features/recipes/compare/RecipeCompareGrid.tsx",
        "apps/web/src/features/recipes/cookbook-import/run-report-panel.tsx",
        "apps/web/src/features/units/NutrientsSummary.tsx",
        "apps/web/src/ui/visualizations/recipe-cost-treemap.tsx",
        "apps/web/src/app/cookbooks/cookbook-run-report.tsx",
        "apps/web/src/app/purchases/financial-settlement.tsx",
        "apps/web/src/app/purchases/purchase-import-run-detail.tsx",
        "apps/web/src/app/runs/run-history.tsx",
        "apps/web/src/entity/detail-field-renderers/image-capture.tsx",
        "apps/web/src/lib/format-duration.ts",
        "apps/web/src/lib/wasm-execution.ts",
        "apps/web/src/server/calendar/ics.ts",
        "apps/web/src/server/repo/financial-transaction-allocations.ts",
        "apps/web/src/server/services/product-match-ranking.ts"
      ],
      "rules": {
        "cubby/no-ad-hoc-number-format": "off"
      }
    },
    {
      "files": ["packages/schemas/src/pagination.ts"],
      "rules": {
        "cubby/no-raw-console": "off"
      }
    },
    {
      "files": [
        "apps/web/src/entity/entity-detail/entity-relation-table.tsx",
        "apps/web/src/entity/merge/entity-merge-dialog.tsx",
        "apps/web/src/features/performance/index.tsx",
        "apps/web/src/features/recipes/compare/RecipeCompareGrid.tsx",
        "apps/web/src/app/docs/_components/GuideDoc.tsx",
        "apps/web/src/app/projects/charts/task-status-board.tsx",
        "apps/web/src/app/projects/tool-matrix-page.tsx",
        "apps/web/src/ui/markdown.tsx",
        "apps/web/src/ui/matrix/cross-tab-table.tsx"
      ],
      "rules": {
        "cubby/no-raw-table": "off"
      }
    }
  ]
}
