{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "react",
    "jsx-a11y",
    "vitest",
    "unicorn",
    "oxc"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "cubby",
      "specifier": "./tools/oxlint/cubby/index.ts"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/.output/**",
    "**/.vinxi/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/drizzle/**",
    "**/node_modules/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/wasm/**",
    "**/.cloudflare/**",
    "apps/apple/**",
    "!apps/apple/tooling/",
    "!apps/apple/tooling/**",
    "!apps/apple/scripts/",
    "!apps/apple/scripts/*.test.ts",
    "cubby-ffi/**"
  ],
  "rules": {
    "complexity": [
      "error",
      {
        "max": 50
      }
    ],
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-direct-query-invalidation": "error",
    "anti-slop/no-legacy-query-invalidation": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unsafe-sql-array-interpolation": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": [
      "error",
      {
        "exportedOnly": true
      }
    ],
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": [
      "error",
      {
        "allowLiteralTypes": true
      }
    ],
    "cubby/no-unsafe-identifiers": "error",
    "cubby/no-raw-enum-literal-in-sql": "error",
    "cubby/no-hand-rolled-plural": "error",
    "cubby/domain-layers": "error",
    "cubby/no-domain-barrel": "error",
    "cubby/no-deep-relative-imports": "error",
    "cubby/no-ordinary-dialog-bypass": "error",
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "typescript/no-explicit-any": "error",
    "react/exhaustive-deps": "error",
    "react/no-array-index-key": "error",
    "react/rules-of-hooks": "error",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/capitalized-calls": "off",
    "react/error-boundaries": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/globals": "off",
    "react/hooks": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/invariant": "off",
    "react/memo-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/rule-suppression": "off",
    "react/set-state-in-effect": "off",
    "react/set-state-in-render": "off",
    "react/static-components": "off",
    "react/syntax": "off",
    "react/todo": "off",
    "react/unsupported-syntax": "off",
    "react/use-memo": "off",
    "react/void-use-memo": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.live-eval.ts"
      ],
      "rules": {
        "cubby/no-uppercase-utility": "error",
        "cubby/no-large-radius": "error",
        "cubby/no-shadow-utility": "error",
        "cubby/no-arbitrary-font-size": "error",
        "cubby/no-dark-variant": "error",
        "cubby/no-hand-rolled-panel": "error"
      }
    },
    {
      // Primitives, controls, overlays, CodeBlock and vendored ReUI own their frame;
      // EmptyState's dashed slot is the one non-Panel content box.
      // Home files are rewritten by the Home lane; drop them when it lands.
      "files": [
        "apps/web/src/ui/primitives/**",
        "apps/web/src/ui/combobox/**",
        "apps/web/src/ui/overlays/**",
        "apps/web/src/ui/reui/**",
        "apps/web/src/ui/date-picker-input.tsx",
        "apps/web/src/ui/text/code-block.tsx",
        "apps/web/src/ui/feedback/empty-state.tsx",
        "apps/web/src/features/home/entitycount.tsx",
        "apps/web/src/features/home/pinned-views.tsx"
      ],
      "rules": { "cubby/no-hand-rolled-panel": "off" }
    },
    {
      // Exact-path specialized compositions; reasons live in apps/web/DESIGN.md.
      "files": [
        "apps/web/src/ui/overlays/overlay.tsx",
        "apps/web/src/ui/primitives/dialog.tsx",
        "apps/web/src/ui/primitives/sheet.tsx",
        "apps/web/src/ui/primitives/command.tsx",
        "apps/web/src/entity/entity-media/photo-viewer.tsx",
        "apps/web/src/entity/relationships/graph-explorer.tsx",
        "apps/web/src/entity/hooks/use-entity-preview.tsx",
        "apps/web/src/ui/overlays/side-panel.tsx"
      ],
      "rules": { "cubby/no-ordinary-dialog-bypass": "off" }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.fixtures.ts",
        "**/*.fixtures.tsx",
        "**/tests/**",
        "**/test/**",
        "**/__fixtures__/**",
        "**/test-support/**",
        "**/tooling/**",
        "packages/*/src/testing.ts"
      ],
      "rules": {
        "cubby/no-unsafe-identifiers": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.fixtures.ts",
        "**/*.fixtures.tsx",
        "**/tests/**",
        "**/test/**",
        "**/__fixtures__/**",
        "**/test-support/**"
      ],
      "rules": {
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      "files": ["apps/web/src/server/generic/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "cubby/no-entity-roster": "error"
      }
    },
    {
      "files": ["apps/web/src/server/**/*.ts", "packages/*/src/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "cubby/require-soft-delete-filter": "error",
        "cubby/no-raw-deleted-at-predicate": "error"
      }
    },
    {
      // Queue selection, item claiming and the Job and WorkItem tables stay
      // inside generic/jobs. Drains use defineDrain and the work-items
      // interface; external executors use external-claim; other readers use
      // job-reads and operator. Tests and test support use those interfaces
      // and generic/jobs/jobs.fixtures.ts. Only the owner and the files that
      // declare or assemble the tables are exempt.
      "files": ["apps/web/src/server/**/*.ts", "apps/web/tooling/**/*.ts"],
      "excludeFiles": [
        "apps/web/src/server/generic/jobs/**",
        "apps/web/src/server/db/job-schema.ts",
        "apps/web/src/server/db/retained-tables.ts",
        "apps/web/src/server/db/schema.ts",
        "apps/web/src/server/db/drizzle-schema.ts",
        "apps/web/src/server/db/generated/entity-table-definitions.gen.ts",
        "apps/web/src/server/db/generated/entity-tables.gen.ts",
        "apps/web/src/server/db/generated/entity-edges.gen.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)db/(schema|retained-tables)(\\.ts)?$",
                "importNames": [
                  "job",
                  "jobInvalidationCapture",
                  "jobLaneAdmission",
                  "workItem",
                  "workTicket"
                ],
                "message": "Job and WorkItem tables belong to generic/jobs. Read Jobs through job-reads.ts, control them through operator.ts, and WorkItems through work-items.ts; tests use jobs.fixtures.ts. Whole-model consumers import drizzleSchema from db/drizzle-schema."
              },
              {
                "regex": "(^|/)generated/entity-table(s|-definitions)\\.gen(\\.ts)?$",
                "importNames": ["job"],
                "message": "The Job table belongs to generic/jobs. Read Jobs through job-reads.ts."
              },
              {
                "regex": "(^|/)db/job-schema(\\.ts)?$",
                "message": "Job tables belong to generic/jobs. Use job-reads.ts, operator.ts or work-items.ts; tests use jobs.fixtures.ts."
              },
              {
                "regex": "(^|/)generic/jobs/repo/(queue|work-claims)(\\.ts)?$",
                "message": "The queue scheduler and item claiming are private to generic/jobs. Use producer.ts, operator.ts, job-reads.ts, work-items.ts, defineDrain, or external-claim.ts."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "schema",
            "property": "job",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "schema",
            "property": "jobInvalidationCapture",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "schema",
            "property": "jobLaneAdmission",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "schema",
            "property": "workItem",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "schema",
            "property": "workTicket",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "drizzleSchema",
            "property": "job",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "drizzleSchema",
            "property": "jobInvalidationCapture",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "drizzleSchema",
            "property": "jobLaneAdmission",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "drizzleSchema",
            "property": "workItem",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          },
          {
            "object": "drizzleSchema",
            "property": "workTicket",
            "message": "Job and WorkItem tables belong to generic/jobs. Use its read, operator or work-item interfaces, or jobs.fixtures.ts in tests."
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/integrations/tanstack-query/operation-overrides.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-start",
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              },
              {
                "name": "@cubby/db",
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              }
            ],
            "patterns": [
              {
                "group": ["~/server/**"],
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              },
              {
                "group": ["~/features/ai/server-functions/**"],
                "allowTypeImports": true,
                "message": "The client operation overrides (loaded by the browser catalog) must stay free of eager server/runtime imports. Import types only, and dispatch through the operation catalog (~/integrations/tanstack-query/operation-catalog)."
              }
            ]
          }
        ]
      }
    },
    {
      // The purchase agent reads untrusted content; it reaches Cubby only
      // through its narrowed environment (docs/infrastructure.md#purchase-agent).
      "files": ["apps/web/src/server/domains/purchase-agent/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "cubby/purchase-agent-boundary": "error"
      }
    },
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "excludeFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.fixtures.ts",
        "**/*.fixtures.tsx",
        "**/tests/**",
        "**/test/**",
        "**/__fixtures__/**",
        "**/test-support/**",
        "**/tooling/**"
      ],
      "rules": {
        "cubby/no-swallowed-catch": "error",
        "cubby/no-error-toast-in-handler": "error"
      }
    },
    {
      "files": ["apps/web/src/ui/feedback/error-details.tsx"],
      "rules": {
        "cubby/no-error-toast-in-handler": "off"
      }
    },
    {
      "files": ["apps/web/tooling/test-setup.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../src/server/**",
                  "!../src/server/db/database",
                  "!../src/server/db/database-runtime",
                  "!../src/server/db/drizzle-schema",
                  "!../src/server/db/db-pg-tracing"
                ],
                "allowTypeImports": true,
                "message": "test-setup.ts doubles as vitest's globalSetup, which runs before test.env applies, and most of ~/server pulls in env.ts validation that would fail there. Only db/database, db/database-runtime, db/drizzle-schema, and db/db-pg-tracing are safe to import eagerly; import anything else lazily with import() inside the function that needs it."
              },
              {
                "group": ["../src/env", "~/env", "~/server/**"],
                "allowTypeImports": true,
                "message": "test-setup.ts doubles as vitest's globalSetup, which runs before test.env applies; an eager env/server import fails env.ts validation before it can pass. Import lazily with import() inside the function that needs it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/schemas/src/entity-definitions/**/*.ts",
        "packages/schemas/src/relationship-query-definitions.ts",
        "packages/schemas/src/entity-links.ts",
        "packages/schemas/src/entity-attachment.ts",
        "packages/schemas/src/automatic-rule.ts",
        "packages/schemas/src/entity-integrity.ts",
        "packages/schemas/src/child-tables/**/*.ts",
        "packages/schemas/src/*-fields.ts",
        "packages/schemas/src/product-raw-read.ts",
        "packages/schemas/src/recipe-raw-read.ts",
        "packages/schemas/src/ingredient-raw-read.ts",
        "packages/schemas/src/vendor-raw-read.ts",
        "packages/schemas/src/inventory-raw-read.ts",
        "packages/schemas/src/image-raw-read.ts",
        "packages/schemas/src/meal-raw-read.ts",
        "packages/schemas/src/location-raw-read.ts",
        "packages/schemas/src/cookbook-raw-read.ts",
        "packages/schemas/src/project-tool-raw-read.ts",
        "packages/schemas/src/scan-raw-read.ts",
        "packages/schemas/src/ai-evaluation.ts",
        "packages/schemas/src/assessment-reference.ts",
        "packages/schemas/src/workflow-runs.ts",
        "packages/schemas/src/job.ts",
        "packages/schemas/src/mailbox-research.ts",
        "packages/schemas/src/mail-coverage-control.ts",
        "packages/schemas/src/shipment-evidence.ts",
        "packages/schemas/src/email-actions.ts",
        "packages/schemas/src/email-observations.ts",
        "packages/schemas/src/import-source.ts",
        "packages/schemas/src/execution-authorization.ts",
        "packages/schemas/src/base-entity.ts",
        "packages/schemas/src/date-range.ts",
        "packages/schemas/src/codec.ts",
        "packages/schemas/src/group-keys.ts",
        "packages/schemas/src/data-quality-facets.ts",
        "packages/schemas/src/data-quality-shape.ts",
        "packages/schemas/src/expense-line-kind.ts",
        "packages/schemas/src/external-id.ts",
        "packages/schemas/src/entity-collection.ts",
        "packages/schemas/src/entity-detail-summary.ts",
        "packages/schemas/src/entity-report-slots.ts",
        "packages/schemas/src/field-resolution.ts",
        "packages/schemas/src/field-explanation-evidence.ts",
        "packages/schemas/src/field-outcome.ts",
        "packages/schemas/src/derived-value.ts",
        "packages/schemas/src/spending-classification.ts",
        "packages/schemas/src/financial-reconciliation.ts",
        "packages/schemas/src/purchase-evidence-policy.ts",
        "packages/schemas/src/emoji.ts",
        "packages/schemas/src/garden-guide.ts",
        "packages/schemas/src/garden-guides.ts",
        "packages/schemas/src/garden-practice.ts",
        "packages/schemas/src/image-summary.ts",
        "packages/schemas/src/field-envelope.ts",
        "packages/schemas/src/entity-core.ts",
        "packages/schemas/src/display-images.ts",
        "packages/schemas/src/image-processing.ts",
        "packages/schemas/src/image-identification.ts",
        "packages/schemas/src/inventory-ownership.ts",
        "packages/schemas/src/work-diagnostic-facts.ts",
        "packages/schemas/src/expense-beneficiaries.ts",
        "packages/schemas/src/email-relationship-facts.ts",
        "packages/schemas/src/meal-classification.ts",
        "packages/schemas/src/meal-shared.ts",
        "packages/schemas/src/money.ts",
        "packages/schemas/src/pagination.ts",
        "packages/schemas/src/nutrition.ts",
        "packages/schemas/src/photo-categories.ts",
        "packages/schemas/src/photo-run-input.ts",
        "packages/schemas/src/recipe-shared.ts",
        "packages/schemas/src/run-work-progress.ts",
        "packages/schemas/src/unitmapping.ts"
      ],
      "excludeFiles": ["**/*.test.ts", "packages/schemas/src/entity-fields.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)generated(/|$)",
                "message": "Entity declarations, and the helper modules they import, are the generator's input: they must not import generated artifacts, a canonical entity schema module (one built from generated field schemas), app code, or the WASM boundary. See docs/entities.md."
              },
              {
                "regex": "^(\\.{1,2}/|@cubby/schemas/)(device|run|financial-account|financial-transaction|garden-entry|image-sighting|image|ingredient|inventory|ledger-party|ledger-transfer|location|meal-nutrition|meal|plant|planting|product-category|product|project|purchase|recipe|usda|vendor-account|vendor|wish)(\\.[jt]s)?$",
                "message": "Entity declarations, and the helper modules they import, are the generator's input: they must not import generated artifacts, a canonical entity schema module (one built from generated field schemas), app code, or the WASM boundary. See docs/entities.md."
              },
              {
                "regex": "^(~/|@cubby/recipebridge(/|$))|(^|/)apps/",
                "message": "Entity declarations, and the helper modules they import, are the generator's input: they must not import generated artifacts, a canonical entity schema module (one built from generated field schemas), app code, or the WASM boundary. See docs/entities.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/server/**/*.ts",
        "apps/web/src/cf-server.ts",
        "packages/*/src/**/*.ts"
      ],
      "excludeFiles": [
