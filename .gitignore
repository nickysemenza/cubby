# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
.next/
out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# USDA database (large files)
apps/usda-api/data/

tsconfig.vitest-temp.json

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock
.claude/worktrees/

certificates
# better-auth configuration (can include secrets)
/.auth/

.playwright-mcp/

.worktrees/

# MCP config (contains API keys)
.mcp.json
lcov.info

.pnpm-store.codex/
.pnpm-store/

# Written by tooling/failure-summary-reporter.ts so a truncated run
# does not have to be repeated to recover the failure list.
.vitest-failures.txt

# Vitest browser-mode (`preview` project) failure screenshots/traces.
.vitest/

# Nx project graph and local task metadata
.nx/

# iOS/macOS native app (apps/apple/) build artifacts
apps/apple/**/.build/
apps/apple/**/.swiftpm/
apps/apple/**/*.xcodeproj/
apps/apple/**/xcuserdata/
*.xcuserstate
apps/apple/.build/
apps/apple/CubbyKit/Frameworks/

# Sentry auth token for the Apple dSYM upload phase lives in ~/.sentryclirc; never in the tree.
.sentryclirc

# Impeccable design-audit artifacts are session output, not source.
.impeccable/

# Local cargo overrides (patches to sibling checkouts); machine-specific
.cargo/config.toml
artifacts/sim-e2e/
artifacts/headless-e2e/
