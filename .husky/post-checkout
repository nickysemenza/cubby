#!/usr/bin/env sh

# Args: $1=prev HEAD  $2=new HEAD  $3=flag (1 = branch checkout, 0 = file checkout).
# Only react to branch checkouts/rebases — refresh the gitignored WASM binary if
# the new tree's recipebridge/ (or a local path-dep) differs from the built one.
[ "$3" = "1" ] || exit 0
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/ensure-wasm.ts"
# Cubby.xcodeproj is generated and gitignored; after a branch switch it can
# reference files the new tree lacks (actool then dies on a nil object).
. "$ROOT/scripts/ensure-xcodeproj.sh"
