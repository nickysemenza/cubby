#!/usr/bin/env sh

# A pull/merge that changes recipebridge/ leaves the gitignored WASM binary stale
# (git can't update it). Rebuild it so the app doesn't break at runtime.
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/ensure-wasm.ts"
# Same for the generated Xcode project (see post-checkout).
. "$ROOT/scripts/ensure-xcodeproj.sh"
# Generated outputs are gitignored; bring them current for the merged inputs.
node "$ROOT/scripts/generator/ensure.ts" || true
