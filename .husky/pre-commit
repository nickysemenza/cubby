#!/usr/bin/env sh
set -e

# Validate staged files without rewriting the working tree. This preserves the
# user's staged/unstaged split for partially staged files.
pnpm exec biome check --staged --error-on-warnings --no-errors-on-unmatched

# Typecheck only the workspaces the staged files can affect. Falls back to the
# full run for broad or unrecognised changes; skips entirely for docs-only
# commits. See scripts/typecheck-staged.ts for why this reuses CI's classifier.
node "$(git rev-parse --show-toplevel)/scripts/typecheck-staged.ts"
