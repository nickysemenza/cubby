{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upc-lookup",
  "account_id": "9f10f078d35d86c78dedece2300a6b88",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.tsx",

  // Observability: logs and traces
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  // https://developers.cloudflare.com/workers/observability/traces/
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },

  // D1 Database for product cache
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "upc-lookup-db",
      "database_id": "6c1f2074-2017-48d1-ae37-bc7002d47c64",
      "migrations_dir": "drizzle",
    },
  ],

  // R2 Bucket for product images
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "upc-images",
    },
  ],

  // API_KEY should be set via: wrangler secret put API_KEY
}
