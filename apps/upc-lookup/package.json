{
  "name": "@cubby/upc-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schemas": {
      "types": "./src/schemas/product.ts",
      "import": "./src/schemas/product.ts",
      "default": "./src/schemas/product.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "types:generate": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --include-runtime=false --strict-vars=false",
    "types:check": "pnpm types:generate --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply upc-lookup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply upc-lookup-db --remote",
    "db:studio": "drizzle-kit studio",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsgo --noEmit",
    "typecheck:stable": "tsc --noEmit",
    "check": "biome check && pnpm typecheck",
    "format:check": "biome check",
    "format:write": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@cubby/shared": "workspace:*",
    "@cubby/upc-contract": "workspace:*",
    "@cubby/usda-schemas": "workspace:*",
    "@cubby/worker-tracing": "workspace:*",
    "@hono/zod-validator": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/hono-api-reference": "^0.11.9",
    "@sentry/cloudflare": "^10.65.0",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.49.0",
    "hono": "^4.12.29",
    "p-map": "^7.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260712.1",
    "@tailwindcss/vite": "^4.3.2",
    "drizzle-kit": "^0.31.10",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
