{
  "name": "@cubby/upc-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "types:generate": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --include-runtime=false --strict-vars=false",
    "types:check": "pnpm types:generate --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply upc-lookup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply upc-lookup-db --remote",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cubby/shared": "workspace:*",
    "@cubby/upc-contract": "workspace:*",
    "@cubby/worker-tracing": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@scalar/hono-api-reference": "^0.12.8",
    "@sentry/cloudflare": "^11.2.0",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.12",
    "p-map": "^7.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "vite": "^8.1.5",
    "vite-ssr-components": "^0.8.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
