{
  "name": "@cubby/upc-lookup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schemas": {
      "types": "./src/schemas/product.ts",
      "import": "./src/schemas/product.ts",
      "default": "./src/schemas/product.ts"
    }
  },
  "scripts": {
    "dev:local": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply upc-lookup-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply upc-lookup-db --remote",
    "db:studio": "drizzle-kit studio",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsgo --noEmit",
    "typecheck:stable": "tsc --noEmit",
    "check": "biome check && pnpm typecheck",
    "format:check": "biome check",
    "format:write": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@cubby/usda-schemas": "workspace:*",
    "@cubby/worker-tracing": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@scalar/hono-api-reference": "^0.11.6",
    "@sentry/cloudflare": "^10.62.0",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.49.0",
    "hono": "^4.12.27",
    "p-map": "^7.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@cloudflare/workers-types": "^4.20260628.1",
    "@tailwindcss/vite": "^4.3.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0",
    "vite-ssr-components": "^0.6.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
