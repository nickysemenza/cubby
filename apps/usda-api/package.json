{
  "name": "@cubby/usda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to .wrangler/state --var SENTRY_ENVIRONMENT:development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:usda": "tsx src/db/import-usda.ts",
    "edge:build": "tsx scripts/build-edge-artifacts.ts",
    "edge:build:sample": "tsx scripts/build-edge-artifacts.ts --limit 1000 --out artifacts/usda-edge/sample --version vsample",
    "edge:validate": "tsx scripts/validate-edge-artifacts.ts",
    "edge:validate:sample": "tsx scripts/validate-edge-artifacts.ts --artifacts artifacts/usda-edge/sample",
    "edge:seed:local": "tsx scripts/seed-edge-artifacts.ts --artifacts artifacts/usda-edge/sample",
    "edge:seed:remote": "tsx scripts/seed-edge-artifacts.ts --remote",
    "edge:d1:migrate:local": "wrangler d1 migrations apply usda-api-index --local",
    "edge:d1:migrate:remote": "wrangler d1 migrations apply usda-api-index --remote",
    "deploy": "wrangler deploy",
    "types:generate": "wrangler types --env-interface CloudflareBindings --include-runtime=false --strict-vars=false",
    "types:check": "pnpm types:generate --check",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:openapi:check": "tsx scripts/generate-openapi.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cubby/usda-contract": "workspace:*",
    "@cubby/usda-schemas": "workspace:*",
    "@cubby/worker-tracing": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "@sentry/cloudflare": "^10.66.0",
    "better-sqlite3": "^13.0.0",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "p-map": "^7.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.112.0"
  },
  "packageManager": "pnpm@12.4.0"
}
