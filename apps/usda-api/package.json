{
  "name": "@recipehub/usda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:usda": "tsx src/db/import-usda.ts",
    "upload:db": "tsx scripts/upload-db-to-r2.ts",
    "generate:openapi": "tsx -e \"import('./src/openapi.js').then(m => console.log(JSON.stringify(m.openApiDocument, null, 2)))\" > openapi.json",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsc --noEmit",
    "check": "biome check && tsc --noEmit",
    "format:check": "biome check",
    "format:write": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/otel": "^1.0.1",
    "@kubiks/otel-drizzle": "^2.1.0",
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@recipehub/usda-contract": "workspace:*",
    "@recipehub/usda-schemas": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.28",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "better-sqlite3": "^12.5.0",
    "commander": "^14.0.2",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "ora": "^9.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.2",
    "@vitest/coverage-v8": "^4.0.15",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
