{
  "name": "@recipehub/usda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:usda": "tsx src/db/import-usda.ts",
    "upload:db": "tsx scripts/upload-db-to-r2.ts",
    "generate:openapi": "tsx -e \"import('./src/openapi.js').then(m => console.log(JSON.stringify(m.openApiDocument, null, 2)))\" > openapi.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "check": "eslint --cache --cache-location .eslintcache . && tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,js}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,js}\" --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.2.0",
    "@recipehub/usda-contract": "workspace:*",
    "@recipehub/usda-schemas": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.21",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "better-sqlite3": "^12.4.1",
    "commander": "^14.0.1",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.11",
    "ora": "^9.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
