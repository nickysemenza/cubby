{
  "name": "@cubby/usda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "wrangler dev --port 8787 --persist-to .wrangler/state",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:usda": "tsx src/db/import-usda.ts",
    "edge:build": "tsx scripts/build-edge-artifacts.ts",
    "edge:build:sample": "tsx scripts/build-edge-artifacts.ts --limit 1000 --out artifacts/usda-edge/sample --version vsample",
    "edge:validate": "tsx scripts/validate-edge-artifacts.ts",
    "edge:validate:sample": "tsx scripts/validate-edge-artifacts.ts --artifacts artifacts/usda-edge/sample",
    "edge:seed:local": "tsx scripts/seed-edge-artifacts.ts --artifacts artifacts/usda-edge/sample",
    "edge:seed:remote": "tsx scripts/seed-edge-artifacts.ts --remote",
    "edge:d1:migrate:local": "wrangler d1 migrations apply usda-api-index --local",
    "edge:d1:migrate:remote": "wrangler d1 migrations apply usda-api-index --remote",
    "deploy": "wrangler deploy",
    "generate:openapi": "tsx -e \"import('./src/openapi.js').then(m => console.log(JSON.stringify(m.openApiDocument, null, 2)))\" > openapi.json",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "typecheck": "tsgo --noEmit",
    "typecheck:stable": "tsc --noEmit",
    "check": "biome check && pnpm typecheck",
    "format:check": "biome check",
    "format:write": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cubby/usda-contract": "workspace:*",
    "@cubby/usda-schemas": "workspace:*",
    "@cubby/worker-tracing": "workspace:*",
    "@hono/zod-validator": "^0.8.0",
    "@openapi-contrib/json-schema-to-openapi-schema": "^4.3.4",
    "@scalar/hono-api-reference": "^0.11.6",
    "@sentry/cloudflare": "^10.62.0",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "p-map": "^7.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
