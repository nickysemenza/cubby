{
  "name": "@recipehub/usda-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:usda": "tsx src/db/import-usda.ts",
    "upload:db": "bash scripts/upload-db-to-r2.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.3",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.0",
    "better-sqlite3": "^12.2.0",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.5.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
