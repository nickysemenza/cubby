{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usda-api",
  "account_id": "9f10f078d35d86c78dedece2300a6b88",
  // Bumped to 2026-06-16 for the cloudflare:workers `tracing.enterSpan` custom-spans
  // API (used via @cubby/worker-tracing to trace the D1/R2 batch-lookup phases).
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",

  // Observability: logs + traces exported to Grafana via named OTLP destinations
  // (configured in the CF dashboard → Workers Observability → Destinations).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "destinations": ["grafana-logs"]
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "destinations": ["grafana-traces"]
    }
  },
  "placement": {
    "mode": "smart"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usda-api-index",
      "database_id": "e2e0037c-6046-4b66-85d9-03ceb0770db6",
      "migrations_dir": "edge-migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "USDA_BUNDLES",
      "bucket_name": "usda-api-bundles"
    }
  ],

  "vars": {
    "API_BASE_URL": "http://localhost:8787",
    "SENTRY_ENVIRONMENT": "production"
  }
}
