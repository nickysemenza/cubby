{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/sw.ts"],
  "compilerOptions": {
    // The typecheck script uses one native checker to avoid duplicating the
    // large generic type graph. Measurements: docs/local-check-performance.md.
    //
    // The default buildinfo path is beside this tsconfig, which is what keeps
    // parallel worktrees from clobbering each other's cache — do not point it
    // at a shared location. The file carries only relative paths, so it stays
    // valid when copied into a new worktree; see `.worktreeinclude`.
    "incremental": true,
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "~/*": ["./src/*"],
      "tooling/*": ["./tooling/*"]
    }
  }
}
