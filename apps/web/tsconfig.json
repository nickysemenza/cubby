{
  // `scripts/generator` runs under this tsconfig (`pnpm generate`), so it is
  // type-checked here rather than by the root project.
  "include": ["**/*.ts", "**/*.tsx", "../../scripts/generator/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    // The typecheck script uses one native checker to avoid duplicating the
    // large generic type graph. Measurements: docs/local-check-performance.md.
    //
    // The default buildinfo path is beside this tsconfig, which is what keeps
    // parallel worktrees from clobbering each other's cache — do not point it
    "incremental": true,
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "ES2024.Promise",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["vite/client", "@cloudflare/vitest-plugin/types"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    // Vite already compiles each file alone. For tsc it also skips recomputing
    // declaration signatures across an edited file's importer closure, which
    // roughly halves the first incremental check after an edit; measurements
    // in docs/local-check-performance.md.
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "~/*": ["./src/*"],
      "tooling/*": ["./tooling/*"]
    }
  }
}
