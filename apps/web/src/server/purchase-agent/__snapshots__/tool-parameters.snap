{
  "claim_next_import_work": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "operationId"
    ]
  },
  "extract_receipt_evidence": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "operationId"
    ]
  },
  "extract_run_evidence": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "operationId"
    ]
  },
  "issue_browser_command": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "command": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "navigate_orders",
              "capture_order",
              "capture_pdf",
              "capture_screenshot"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    "required": [
      "operationId",
      "command"
    ]
  },
  "read_browser_command_result": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "operationId"
    ]
  },
  "import_browser_order_evidence": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "commandId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "defaultTrade": {
        "type": "string",
        "enum": [
          "planning",
          "demolition",
          "building",
          "drywall",
          "electrical",
          "plumbing",
          "mechanical",
          "cabinetry",
          "countertop",
          "flooring",
          "millwork",
          "finishes",
          "appliances",
          "landscaping",
          "logistics",
          "metalworking",
          "crafts",
          "auto",
          "other"
        ]
      },
      "defaultProjectId": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "operationId",
      "commandId"
    ]
  },
  "report_agent_progress": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "phase": {
        "type": "string",
        "enum": [
          "preparing",
          "investigating",
          "awaiting_browser",
          "awaiting_approval",
          "committing",
          "review",
          "complete"
        ]
      },
      "currentItem": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "awaitingApproval": {
        "type": "boolean"
      },
      "detail": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required": [
      "operationId",
      "phase"
    ]
  },
  "save_navigation_hints": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "hints": {
        "minItems": 1,
        "maxItems": 25,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri"
            },
            "label": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "url"
          ]
        }
      }
    },
    "required": [
      "operationId",
      "hints"
    ]
  },
  "mark_history_expired": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "earliestAvailableOrderAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
      }
    },
    "required": [
      "operationId",
      "earliestAvailableOrderAt"
    ]
  },
  "finish_import_run": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "operationId"
    ]
  },
  "stop_import_run_for_review": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "reason": {
        "type": "string",
        "enum": [
          "navigation_ambiguity",
          "unreadable_evidence",
          "provider_failure",
          "other"
        ]
      },
      "detail": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required": [
      "operationId",
      "reason"
    ]
  },
  "defer_order_for_review": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "orderId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "detail": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required": [
      "operationId",
      "orderId",
      "detail"
    ]
  },
  "settle_charge_hunt": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "huntId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "outcome": {
        "type": "string",
        "enum": [
          "not_found",
          "needs_review"
        ]
      },
      "detail": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "required": [
      "operationId",
      "huntId",
      "outcome",
      "detail"
    ]
  }
}
