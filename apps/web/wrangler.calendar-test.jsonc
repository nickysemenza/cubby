{
  "name": "cubby-calendar-test",
  "main": "tooling/calendar-test-worker.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "DB_FRESHNESS",
        "class_name": "DatabaseFreshnessDurableObject",
      },
      {
        "name": "CALENDAR_FEED",
        "class_name": "CalendarFeedDurableObject",
      },
      {
        "name": "PURCHASE_IMPORT",
        "class_name": "PurchaseImportDurableObject",
      },
      {
        "name": "AI_RESPONSE_CACHE",
        "class_name": "AiResponseCacheDurableObject",
      },
    ],
  },
  "exports": {
    "DatabaseFreshnessDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "CalendarFeedDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "PurchaseImportDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AiResponseCacheDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "queues": {
    "producers": [
      {
        "binding": "PURCHASE_AGENT_QUEUE",
        "queue": "cubby-purchase-agent-test",
      },
    ],
  },
}
