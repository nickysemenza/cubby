{
  "name": "cubby-calendar-test",
  "main": "tooling/calendar-test-worker.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "DB_FRESHNESS",
        "class_name": "DatabaseFreshnessDurableObject",
      },
      {
        "name": "CALENDAR_FEED",
        "class_name": "CalendarFeedDurableObject",
      },
      {
        "name": "PURCHASE_IMPORT",
        "class_name": "PurchaseImportDurableObject",
      },
      {
        "name": "AI_RESPONSE_CACHE",
        "class_name": "AiResponseCacheDurableObject",
      },
      {
        "name": "CHATGPT_PLAN",
        "class_name": "ChatGptPlanDurableObject",
      },
      {
        "name": "USDA_RELEASE",
        "class_name": "UsdaReleaseDurableObject",
      },
    ],
  },
  "exports": {
    "DatabaseFreshnessDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "CalendarFeedDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "PurchaseImportDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "AiResponseCacheDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ChatGptPlanDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "UsdaReleaseDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "r2_buckets": [
    { "binding": "USDA_RELEASES", "bucket_name": "cubby-usda-releases-test" },
  ],
  // Synthetic values for `src/env.ts`, which validates at module load: the
  // Durable Object implementations reach it through their static graphs.
  "vars": {
    "R2_ACCESS_KEY_ID": "synthetic-access",
    "R2_SECRET_ACCESS_KEY": "synthetic-secret",
    "R2_ENDPOINT": "https://objects.example.test",
    "R2_BUCKET_NAME": "synthetic-bucket",
    "R2_PUBLIC_URL": "https://images.example.test",
    "BETTER_AUTH_SECRET": "synthetic-calendar-test-auth",
  },
  "queues": {
    "producers": [
      {
        "binding": "PURCHASE_AGENT_QUEUE",
        "queue": "cubby-purchase-agent-test",
      },
    ],
  },
}
