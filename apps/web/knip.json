{
  "entry": [
    "src/start.ts",
    "src/router.tsx",
    "src/routes/**/*.tsx",
    "src/routes/**/*.ts",
    "src/styles.css",
    "src/server.ts",
    "src/lib/recipebridge-cf.ts",
    "src/integrations/**/*.{ts,tsx}",
    "drizzle.config.ts",
    "instrument.server.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "wasm/**",
    "types.ts",
    "src/components/ui/**",
    "scripts/**",
    "tests/**",
    "tooling/**",
    "src/routeTree.gen.ts"
  ],
  "ignoreDependencies": [
    "@cubby/.+",
    "@testing-library/.+",
    "@vitest/.+",
    "@tailwindcss/postcss",
    "postcss",
    "@opentelemetry/.+",
    "@tanstack/router-plugin",
    "vite-plugin-wasm",
    "vite-plugin-top-level-await"
  ],
  "vitest": {
    "config": "vitest.config.ts"
  },
  "playwright": {
    "config": "playwright.config.ts"
  },
  "tags": ["-lintignore"]
}
