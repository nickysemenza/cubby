{
  "name": "@cubby/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-wasm.mjs && node ../../scripts/ensure-mcp-apps.mjs && NODE_OPTIONS='--import ./instrument.server.mjs' vite dev",
    "build": "pnpm run build:cf",
    "deploy": "pnpm run deploy:cf",
    "test": "node ../../scripts/ensure-mcp-apps.mjs && vitest run",
    "test:unit": "node ../../scripts/ensure-mcp-apps.mjs && vitest run --project unit",
    "test:ui": "node ../../scripts/ensure-mcp-apps.mjs && NODE_OPTIONS=--no-experimental-webstorage vitest run --project ui",
    "test:integration": "node ../../scripts/ensure-mcp-apps.mjs && vitest run --project integration",
    "test:changed": "node ../../scripts/ensure-mcp-apps.mjs && vitest run --changed",
    "test:watch": "node ../../scripts/ensure-mcp-apps.mjs && vitest --ui",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "format": "biome format",
    "format:check": "biome check",
    "format:write": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check && pnpm typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "db:ensure-extensions": "tsx scripts/ensure-db-extensions.ts",
    "seed-vendor-logos": "tsx scripts/seed-vendor-logos.ts",
    "db:push": "pnpm run db:ensure-extensions && drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:rebuild": "pnpm run db:push",
    "db:studio": "drizzle-kit studio",
    "db:cleanup-unreferenced-images": "tsx scripts/cleanup-unreferenced-images.ts",
    "db:backfill-settlement-allocations": "tsx scripts/backfill-settlement-allocations.ts",
    "db:backfill-household-project": "tsx scripts/backfill-household-project.ts",
    "db:backfill-location-identity": "tsx scripts/backfill-location-product-identity.ts",
    "db:create-home-location": "tsx scripts/create-home-location.ts",
    "db:backfill-stock-tracked": "tsx scripts/backfill-stock-tracked.ts",
    "db:backfill-search-documents": "tsx scripts/backfill-search-documents.ts",
    "db:backfill-product-conversion-coverage": "tsx scripts/backfill-product-conversion-coverage.ts",
    "db:report-product-quantities": "tsx scripts/report-product-quantity-backfill.ts",
    "db:report-split-sums": "tsx scripts/report-split-expense-sums.ts",
    "regenerate": "pnpm run db:rebuild",
    "knip": "knip",
    "knip:production": "knip --production",
    "types:generate": "wrangler types --env-interface Env --env-file .env.example --strict-vars=false --include-runtime=false",
    "types:check": "pnpm types:generate --check",
    "analyze:client-bundle": "tsx scripts/analyze-client-bundle.ts",
    "build:cf": "node ../../scripts/ensure-mcp-apps.mjs && rm -rf dist && DEPLOY_TARGET=cloudflare NODE_ENV=production vite build && node scripts/build-sw.mjs && tsx scripts/analyze-client-bundle.ts --check",
    "deploy:cf": "pnpm run build:cf && wrangler deploy --config dist/server/wrangler.json",
    "preview:cf": "pnpm run build:cf && wrangler dev --config dist/server/wrangler.json",
    "gen:apple-icon": "rsvg-convert -w 180 -h 180 public/favicon.svg -o public/apple-touch-icon.png",
    "gen:pwa-icons": "rsvg-convert -w 192 -h 192 public/favicon.svg -o public/icon-192.png && rsvg-convert -w 512 -h 512 public/favicon.svg -o public/icon-512.png && magick -size 512x512 xc:'#f7f4ec' \\( public/icon-512.png -resize 360x360 \\) -gravity center -composite public/icon-512-maskable.png",
    "gen:pwa-splash": "mkdir -p public/splash && for size in 750x1334:192 1125x2436:256 828x1792:256 1170x2532:256 1284x2778:256 1179x2556:256 1290x2796:256 1206x2622:256 1320x2868:256 1620x2160:300 1668x2388:300 2048x2732:360; do dim=${size%%:*}; icon=${size##*:}; magick -size $dim xc:'#f7f4ec' \\( public/icon-512.png -resize ${icon}x${icon} \\) -gravity center -composite public/splash/apple-splash-${dim}.png; done",
    "gen:pwa-assets": "pnpm run gen:apple-icon && pnpm run gen:pwa-icons && pnpm run gen:pwa-splash"
  },
