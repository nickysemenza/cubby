{
  "name": "@cubby/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000",
    "build": "NODE_ENV=production vite build && ([ -d .output/server ] && cp instrument.server.mjs .output/server || true)",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "test": "vitest run",
    "test:e2e": "NODE_ENV=test playwright test",
    "format": "biome format",
    "format:check": "biome check",
    "format:write": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check && pnpm typecheck",
    "typecheck": "tsgo --noEmit",
    "typecheck:stable": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:rebuild": "pnpm run db:push",
    "db:studio": "drizzle-kit studio",
    "gen:write-config": "tsx scripts/write-config.ts",
    "load-data": "tsx scripts/load-data.ts",
    "regenerate": "pnpm run db:rebuild",
    "knip": "knip",
    "knip:production": "knip --production",
    "cf:types": "wrangler types --strict-vars=false --include-runtime=false",
    "build:cf": "rm -rf dist && DEPLOY_TARGET=cloudflare vite build",
    "deploy:cf": "pnpm run build:cf && wrangler deploy --config dist/server/wrangler.json",
    "preview:cf": "pnpm run build:cf && wrangler dev --config dist/server/wrangler.json",
    "gen:apple-icon": "rsvg-convert -w 180 -h 180 public/favicon.svg -o public/apple-touch-icon.png",
    "gen:pwa-icons": "rsvg-convert -w 192 -h 192 public/favicon.svg -o public/icon-192.png && rsvg-convert -w 512 -h 512 public/favicon.svg -o public/icon-512.png && magick -size 512x512 xc:'#FAF8F5' \\( public/icon-512.png -resize 360x360 \\) -gravity center -composite public/icon-512-maskable.png",
    "gen:pwa-splash": "mkdir -p public/splash && for size in 750x1334:192 1125x2436:256 828x1792:256 1170x2532:256 1284x2778:256 1179x2556:256 1290x2796:256 1206x2622:256 1320x2868:256 1620x2160:300 1668x2388:300 2048x2732:360; do dim=${size%%:*}; icon=${size##*:}; magick -size $dim xc:'#FAF8F5' \\( public/icon-512.png -resize ${icon}x${icon} \\) -gravity center -composite public/splash/apple-splash-${dim}.png; done",
    "gen:pwa-assets": "pnpm run gen:apple-icon && pnpm run gen:pwa-icons && pnpm run gen:pwa-splash"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.983.0",
