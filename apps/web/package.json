{
  "name": "@cubby/web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project unit --project mcp-contract --project worker-safety --project ui",
    "test:unit": "vitest run --project unit",
    "test:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project ui",
    "test:preview": "vitest run --project preview",
    "test:postgres": "node ../../scripts/test-services.ts -- vitest run --project integration --project integration-workerd",
    "test:file": "vitest run",
    "test:e2e": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test",
    "test:e2e:household": "pnpm build:cf --ensure && pnpm test:e2e --project=\"Household exploration\"",
    "eval:agent-models": "NODE_ENV=test node ../../scripts/test-services.ts -- vitest run --project live-eval src/server/domains/purchase-import/agent-model-eval.live-eval.ts",
    "eval:mail-prompts:stdin": "tsx tooling/ai/mail-prompt-stdin.ts",
    "eval:mail-prompts": "NODE_ENV=test node ../../scripts/test-services.ts -- vitest run --project live-eval --silent=false src/server/ai/mail-prompt.live-eval.ts",
    "eval:features": "NODE_ENV=test node ../../scripts/test-services.ts -- vitest run --project live-eval src/server/ai/feature-routing-eval.live-eval.ts",
    "test:e2e:hmr": "playwright test --config=playwright.dev.config.ts",
    "test:e2e:affected": "pnpm build:cf --ensure && pnpm test:e2e --only-changed=origin/main",
    "test:e2e:watch": "tsx tooling/build-cf.ts --ensure && NODE_ENV=test node ../../scripts/test-services.ts -- concurrently -k -n build,test \"tsx tooling/build-cf.ts --watch\" \"playwright test --ui\"",
    "test:e2e:ci:desktop": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test --project='Gmail profile tests' --project='Authenticated tests'",
    "test:e2e:ci:purchase-import": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test --project='Purchase import agent'",
    "test:e2e:install-browser": "playwright install",
    "typecheck": "node ../../scripts/ensure.ts wasm && node ../../scripts/ensure.ts generate && tsc --noEmit --checkers 1 -p tsconfig.json",
    "typecheck:app": "node ../../scripts/ensure.ts wasm && node ../../scripts/ensure.ts generate && tsc --noEmit --checkers 1 -p tsconfig.app.json",
    "db:generate": "node ../../scripts/ensure.ts generate && tsx tooling/db-generate.ts",
    "db:check": "node ../../scripts/ensure.ts generate && node ../../scripts/test-services.ts -- tsx tooling/db-check.ts",
    "db:migrate": "tsx tooling/db-migrate.ts",
    "db:promote-historical-orders": "tsx tooling/historical-accepted-orders.ts",
    "types:generate": "wrangler types --env-interface Env --env-file .env.example --strict-vars=false --include-runtime=false && node tooling/checks/worker-type-imports.ts",
    "types:check": "wrangler types --env-interface Env --env-file .env.example --strict-vars=false --include-runtime=false --check && node tooling/checks/worker-type-imports.ts --check",
    "build:cf": "tsx tooling/build-cf.ts",
    "deploy:cf": "pnpm run build:cf && wrangler deploy --config dist/server/wrangler.json",
    "preview:cf": "tsx tooling/dev/index.ts preview",
    "test:calendar": "pnpm --dir ../web-worker-tests test:workers",
    "db:backfill-ai-costs": "tsx tooling/ai-cost-backfill.ts"
  },
