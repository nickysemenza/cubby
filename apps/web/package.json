    "preview": "pnpm run build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:write-config": "tsx scripts/write-config.ts",
    "load-data": "tsx scripts/load-data.ts",
    "regenerate": "pnpm run db:rebuild && pnpm run wasm",
    "test:e2e": " NODE_ENV=test playwright test",
    "knip": "knip"
