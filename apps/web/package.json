{
  "name": "@cubby/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/ensure-wasm.ts && node ../mcp-apps/build.mjs --if-stale && NODE_OPTIONS='--import ./instrument.server.mjs' vite dev",
    "build": "pnpm run build:cf",
    "deploy": "pnpm run deploy:cf",
    "test:prepare": "node ../mcp-apps/build.mjs --if-stale",
    "test:mark-success": "node -e \"require('node:fs').writeFileSync('.vitest-failures.txt', '')\"",
    "test": "pnpm test:prepare && vitest run --project unit --project mcp-contract --project worker-safety --project ui && pnpm test:mark-success",
    "test:unit": "vitest run --project unit",
    "test:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project ui",
    "test:postgres": "node ../../scripts/test-services.ts -- vitest run --project integration",
    "test:integration:postgres": "pnpm test:postgres",
    "test:changed": "pnpm test:prepare && vitest run --changed",
    "test:changed:postgres": "CUBBY_TEST_INTEGRATION=1 node ../../scripts/test-services.ts -- vitest run --changed",
    "test:file": "pnpm test:prepare && vitest run",
    "test:file:postgres": "node ../../scripts/test-services.ts -- vitest run --project integration",
    "test:watch": "pnpm test:prepare && vitest --ui",
    "test:e2e": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test",
    "test:e2e:ci:chromium": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test --project='Unauthenticated tests' --project='Authenticated tests'",
    "test:e2e:ci:webkit": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test --project='iPhone WebKit smoke'",
    "test:e2e:install-browser": "playwright install",
    "test:e2e:install-deps": "playwright install-deps",
    "test:e2e:postgres": "pnpm test:e2e",
    "typecheck": "tsc --noEmit --checkers 1",
    "db:ensure-extensions": "tsx scripts/ensure-db-extensions.ts",
    "db:push": "pnpm run db:ensure-extensions && drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "types:generate": "wrangler types --env-interface Env --env-file .env.example --strict-vars=false --include-runtime=false",
    "types:check": "pnpm types:generate --check",
    "build:cf": "node ../mcp-apps/build.mjs --if-stale && rm -rf dist && DEPLOY_TARGET=cloudflare NODE_ENV=production vite build && tsx scripts/check-client-bundle.ts",
    "deploy:cf": "pnpm run build:cf && wrangler deploy --config dist/server/wrangler.json",
    "preview:cf": "pnpm run build:cf && wrangler dev --config dist/server/wrangler.json --var SENTRY_ENVIRONMENT:development",
    "gen:apple-icon": "magick -background none public/favicon.svg -resize 180x180 -depth 8 -strip public/apple-touch-icon.png",
    "gen:pwa-icons": "magick -background none public/favicon.svg -resize 192x192 -depth 8 -strip public/icon-192.png && magick -background none public/favicon.svg -resize 512x512 -depth 8 -strip public/icon-512.png && magick -size 512x512 xc:'#f7f9fc' \\( public/icon-512.png -resize 360x360 \\) -gravity center -composite -depth 8 -strip public/icon-512-maskable.png",
    "gen:pwa-splash": "mkdir -p public/splash && for size in 750x1334:192 1125x2436:256 828x1792:256 1170x2532:256 1284x2778:256 1179x2556:256 1290x2796:256 1206x2622:256 1320x2868:256 1620x2160:300 1668x2388:300 2048x2732:360; do dim=${size%%:*}; icon=${size##*:}; magick -size $dim xc:'#f7f9fc' \\( public/icon-512.png -resize ${icon}x${icon} \\) -gravity center -composite -depth 8 -strip public/splash/apple-splash-${dim}.png; done",
    "gen:pwa-assets": "pnpm run gen:apple-icon && pnpm run gen:pwa-icons && pnpm run gen:pwa-splash",
    "test:calendar": "pnpm --dir ../web-worker-tests test:workers"
  },
