{
  "name": "@cubby/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx tooling/dev/index.ts start",
    "build": "pnpm run build:cf",
    "deploy": "pnpm run deploy:cf",
    "test:prepare": "node ../../scripts/generator/ensure.ts && node ../mcp-apps/build.mjs --if-stale",
    "test:mark-success": "node -e \"require('node:fs').writeFileSync('.vitest-failures.txt', '')\"",
    "test": "pnpm test:prepare && vitest run --project unit --project mcp-contract --project worker-safety --project ui && pnpm test:mark-success",
    "test:unit": "vitest run --project unit",
    "test:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest run --project ui",
    "test:preview": "vitest run --project preview",
    "test:postgres": "node ../../scripts/test-services.ts -- vitest run --project integration",
    "test:changed:postgres": "CUBBY_TEST_INTEGRATION=1 node ../../scripts/test-services.ts -- vitest run --changed",
    "test:file": "pnpm test:prepare && vitest run",
    "test:watch": "pnpm test:prepare && vitest --ui",
    "test:e2e": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test",
    "eval:agent-models": "NODE_ENV=test node ../../scripts/test-services.ts -- vitest run --project live-eval src/server/purchase-import/agent-model-eval.live-eval.ts",
    "eval:features": "NODE_ENV=test node ../../scripts/test-services.ts -- vitest run --project live-eval src/server/ai/feature-routing-eval.live-eval.ts",
    "eval:purchase-decisions": "NODE_ENV=test node ../../scripts/test-services.ts -- vitest run --project live-eval src/server/purchase-import/purchase-decision-eval.live-eval.ts",
    "test:e2e:affected": "NODE_ENV=test node scripts/e2e-affected.ts",
    "test:e2e:watch": "tsx tooling/build-cf.ts --ensure && NODE_ENV=test node ../../scripts/test-services.ts --warm -- concurrently -k -n build,test \"pnpm run build:cf:watch\" \"playwright test --ui\"",
    "test:e2e:ci:desktop": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test --project='Unauthenticated tests' --project='Authenticated tests'",
    "test:e2e:ci:purchase-import": "NODE_ENV=test node ../../scripts/test-services.ts -- playwright test --project='Purchase import agent'",
    "test:e2e:install-browser": "playwright install",
    "test:e2e:install-deps": "playwright install-deps",
    "typecheck": "node ../../scripts/generator/ensure.ts && node ../../scripts/typecheck-web.ts",
    "typecheck:app": "node ../../scripts/generator/ensure.ts && node ../../scripts/typecheck-web.ts --app",
    "db:generate": "node ../../scripts/generator/ensure.ts && tsx tooling/db-generate.ts",
    "db:check": "node ../../scripts/generator/ensure.ts && node ../../scripts/test-services.ts -- tsx tooling/db-check.ts",
    "db:migrate": "tsx tooling/db-migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "types:generate": "wrangler types --env-interface Env --env-file .env.example --strict-vars=false --include-runtime=false && node scripts/worker-type-imports.ts",
    "types:check": "wrangler types --env-interface Env --env-file .env.example --strict-vars=false --include-runtime=false --check && node scripts/worker-type-imports.ts --check",
    "build:cf": "tsx tooling/build-cf.ts",
    "build:cf:watch": "tsx tooling/build-cf.ts --watch",
    "deploy:cf": "pnpm run build:cf && wrangler deploy --config dist/server/wrangler.json",
    "preview:cf": "tsx tooling/dev/index.ts preview",
    "test:calendar": "pnpm --dir ../web-worker-tests test:workers",
    "dev:doctor": "tsx tooling/dev/index.ts doctor",
    "dev:status": "tsx tooling/dev/index.ts status",
    "dev:seed": "tsx tooling/dev/index.ts seed",
    "dev:reset": "tsx tooling/dev/index.ts reset",
    "dev:down": "tsx tooling/dev/index.ts down",
    "dev:sim": "tsx tooling/dev/index.ts sim",
    "dev:integrations": "CUBBY_DEV_PROFILE=integrations tsx tooling/dev/index.ts start"
  },
