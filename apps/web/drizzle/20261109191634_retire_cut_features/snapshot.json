    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"Entity\",\"Entity_kind_check\"]",
      "set": {
        "value": "\"kind\" IN ('product', 'recipe', 'ingredient', 'cookbook', 'location', 'inventory', 'meal', 'ledgerParty', 'ledgerTransfer', 'project', 'task', 'vendor', 'purchase', 'financialAccount', 'financialTransaction', 'expense', 'image', 'planting', 'gardenEntry', 'vendorAccount', 'productCategory', 'run', 'device', 'plant', 'spendingCategory', 'email', 'imageJob', 'sourceTransactionRecord', 'transactionImport', 'shipment', 'sourceOccurrence')"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"Entity\",\"Entity_shortcode_prefix_check\"]",
      "set": {
        "value": "\"shortcode\" IS NULL OR CASE \"kind\" WHEN 'product' THEN \"shortcode\" LIKE 'PRD-%' WHEN 'recipe' THEN \"shortcode\" LIKE 'RCP-%' WHEN 'ingredient' THEN \"shortcode\" LIKE 'ING-%' WHEN 'cookbook' THEN \"shortcode\" LIKE 'CKB-%' WHEN 'location' THEN \"shortcode\" LIKE 'LOC-%' WHEN 'inventory' THEN \"shortcode\" LIKE 'INV-%' WHEN 'meal' THEN \"shortcode\" LIKE 'MEL-%' WHEN 'ledgerParty' THEN \"shortcode\" LIKE 'LPY-%' WHEN 'ledgerTransfer' THEN \"shortcode\" LIKE 'LTR-%' WHEN 'project' THEN \"shortcode\" LIKE 'PRJ-%' WHEN 'task' THEN \"shortcode\" LIKE 'TSK-%' WHEN 'vendor' THEN \"shortcode\" LIKE 'VEN-%' WHEN 'purchase' THEN \"shortcode\" LIKE 'PUR-%' WHEN 'financialAccount' THEN \"shortcode\" LIKE 'FAC-%' WHEN 'financialTransaction' THEN \"shortcode\" LIKE 'FTX-%' WHEN 'expense' THEN \"shortcode\" LIKE 'EXP-%' WHEN 'image' THEN \"shortcode\" LIKE 'IMG-%' WHEN 'planting' THEN \"shortcode\" LIKE 'PLT-%' WHEN 'gardenEntry' THEN \"shortcode\" LIKE 'GDE-%' WHEN 'vendorAccount' THEN \"shortcode\" LIKE 'VACCT-%' WHEN 'productCategory' THEN \"shortcode\" LIKE 'CAT-%' WHEN 'run' THEN \"shortcode\" LIKE 'RUN-%' WHEN 'device' THEN \"shortcode\" LIKE 'DEV-%' WHEN 'plant' THEN \"shortcode\" LIKE 'PLANT-%' WHEN 'spendingCategory' THEN \"shortcode\" LIKE 'SPC-%' WHEN 'email' THEN \"shortcode\" LIKE 'EML-%' WHEN 'imageJob' THEN \"shortcode\" LIKE 'IPR-%' WHEN 'sourceTransactionRecord' THEN \"shortcode\" LIKE 'STR-%' WHEN 'transactionImport' THEN \"shortcode\" LIKE 'TIM-%' WHEN 'shipment' THEN \"shortcode\" LIKE 'SHIP-%' WHEN 'sourceOccurrence' THEN \"shortcode\" LIKE 'SOC-%' ELSE false END"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"EntityLink\",\"EntityLink_kind_check\"]",
      "set": {
        "value": "(\"kind\", \"fromKind\", \"toKind\") IN (('purchaseProduct', 'purchase', 'product'), ('purchasePaymentAccount', 'purchase', 'financialAccount'), ('projectTool', 'project', 'product'), ('gardenEntryPlanting', 'gardenEntry', 'planting'), ('productComponent', 'product', 'product'), ('taskDependency', 'task', 'task'), ('projectDependency', 'project', 'project'))"
      }
    }
  ]
