      "set": {
        "value": "(\"identityKind\" = 'provider' AND \"providerIdentity\" IS NOT NULL AND \"physicalImportId\" IS NULL AND \"physicalPosition\" IS NULL) OR (\"identityKind\" = 'positioned' AND \"providerIdentity\" IS NULL AND \"physicalImportId\" IS NOT NULL AND \"physicalPosition\" > 0) OR (\"identityKind\" IN ('reviewed', 'legacy') AND \"providerIdentity\" IS NULL AND \"physicalImportId\" IS NULL AND \"physicalPosition\" IS NULL)"
