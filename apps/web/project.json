{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@cubby/web",
  "implicitDependencies": ["recipebridge"],
  "namedInputs": {
    // Runtime identity comes from gate; web-only settings and artifacts add
    // the inputs the browser/database/Worker lanes actually consume.
    "webGate": [
      "gate",
      // Native App implementation is not consumed by web/runtime tests. Root
      // tooling checks retain their broad gate and still validate native layout.
      "!{workspaceRoot}/apps/apple/App/**/*",
      {
        "runtime": "git ls-files --others --ignored --exclude-standard -- ':(glob)**/.env*' | git hash-object --stdin-paths"
      },
      // Built from Rust inputs and toolchain the file key cannot see.
      { "dependentTasksOutputFiles": "packages/wasm/**/*" },
      // Switches the built Worker to its development preview configuration.
      { "env": "CUBBY_DEV_PREVIEW_BUILD" },
      { "env": "NODE_ENV" },
      { "env": "CUBBY_TEST_SHUFFLE_SEED" },
      { "env": "CUBBY_TEST_INTEGRATION" },
      // The browser lanes sign in with these.
      { "env": "E2E_TEST_USER_EMAIL" },
      { "env": "E2E_TEST_USER_PASSWORD" }
    ]
  },
  "targets": {
    // Package.json infers the command for the fast Vitest projects.
    "test": {
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "inputs": ["webGate"],
      "outputs": ["{projectRoot}/.vitest-results.json"]
    },
    // CUBBY_POSTGRES_SHARD (`index/count`) splits the files across CI runners.
    "postgres": {
      "command": "pnpm exec node ../../scripts/test-services.ts -- vitest run --project integration --shard=${CUBBY_POSTGRES_SHARD:-1/1}",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "inputs": ["webGate", { "env": "CUBBY_POSTGRES_SHARD" }],
      "outputs": ["{projectRoot}/.vitest-results.json"]
    },
    "db-check": {
      "command": "pnpm run db:check",
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "inputs": ["webGate"]
    },
    // Builds the Worker inside the command rather than through `dependsOn`:
    // build-cf's key includes HEAD for provenance, so as a dependency it
    // would rebuild before every cache hit here.
    "workerd-tests": {
      "command": "pnpm exec tsx tooling/build-cf.ts --ensure && pnpm exec node ../../scripts/test-services.ts -- vitest run --project integration-workerd",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "inputs": ["webGate"]
    },
    "build-cf": {
      "command": "pnpm run build:cf",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/**",
        "{workspaceRoot}/packages/**",
        "{workspaceRoot}/*.{json,jsonc,yaml,yml,toml,lock}",
        "{workspaceRoot}/.npmrc",
        "{workspaceRoot}/docs/guide/**/*.md",
        "{workspaceRoot}/.claude/skills/{purchase-import,photo-inventory-import,product-enrichment}/**/*.md",
        // The bundle embeds source identity, and its provenance requires HEAD.
        { "runtime": "git rev-parse HEAD" },
        { "runtime": "git rev-parse --abbrev-ref HEAD" },
        { "env": "CUBBY_SOURCE_COMMIT" },
        { "env": "CUBBY_SOURCE_BRANCH" },
        { "env": "CUBBY_DEV_PREVIEW_BUILD" },
        {
          "dependentTasksOutputFiles": "packages/wasm/**/*"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    // The required desktop browser lane. CUBBY_E2E_SHARD (`index/count`)
    // splits it across CI runners; the restored run bundle is the evidence of
    // the run that produced a cached pass. See workerd-tests for the build.
    "e2e": {
      "command": "pnpm exec tsx tooling/build-cf.ts --ensure && pnpm run test:e2e:ci:desktop --workers=2 --shard=${CUBBY_E2E_SHARD:-1/1}",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "inputs": [
        "webGate",
        { "env": "CUBBY_E2E_SHARD" },
        { "env": "CUBBY_BOAT_PILOT" }
      ],
      "outputs": [
        "{projectRoot}/playwright-report",
        "{projectRoot}/blob-report"
      ]
    },
    // Informative only (never a merge gate); keyed like the other web lanes.
    "e2e-purchase-import": {
      "command": "pnpm exec tsx tooling/build-cf.ts --ensure && pnpm run test:e2e:ci:purchase-import",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "inputs": ["webGate"],
      "outputs": ["{projectRoot}/playwright-report"]
    },
    "workers-tests": {
      "command": "pnpm run test:calendar",
      // The calendar worker formats through the recipebridge WASM.
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        },
        {
          "projects": ["cubby-checks"],
          "target": "generate"
        }
      ],
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "inputs": ["webGate"]
    }
  }
}
