{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@cubby/web",
  "implicitDependencies": ["recipebridge"],
  "targets": {
    // Package.json infers a "test" target for the fast Vitest projects. Its
    // cache key is intentionally broader than the project-scoped default:
    // these tests import shared workspace code, generated WASM, ignored env
    // files, and runtime-sensitive configuration.
    "test": {
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        }
      ],
      "inputs": [
        "repo",
        "sharedGlobals",
        {
          "runtime": "git ls-files --others --ignored --exclude-standard -- ':(glob)**/.env*' | git hash-object --stdin-paths"
        },
        {
          "dependentTasksOutputFiles": "packages/wasm/**/*"
        },
        {
          "env": "NODE_ENV"
        },
        {
          "env": "TZ"
        },
        {
          "env": "LANG"
        },
        {
          "env": "CUBBY_TEST_SHUFFLE_SEED"
        },
        {
          "env": "CUBBY_TEST_INTEGRATION"
        },
        {
          "env": "VITEST_MAX_WORKERS"
        }
      ],
      "outputs": [
        "{workspaceRoot}/apps/mcp-apps/dist",
        "{projectRoot}/.vitest-failures.txt"
      ]
    },
    "postgres": {
      "command": "pnpm run test:postgres",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        }
      ],
      "inputs": [
        "{projectRoot}/src/server/**",
        "{projectRoot}/drizzle/**",
        "{projectRoot}/tooling/**",
        "{projectRoot}/vitest.config.ts",
        "{workspaceRoot}/packages/schemas/**",
        "{workspaceRoot}/scripts/test-services.ts",
        {
          "env": "CUBBY_TEST_SHUFFLE_SEED"
        },
        {
          "dependentTasksOutputFiles": "packages/wasm/**/*"
        }
      ]
    },
    "build-cf": {
      "command": "pnpm run build:cf",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "dependsOn": [
        {
          "projects": ["cubby-checks"],
          "target": "wasm"
        }
      ],
      "inputs": [
        "default",
        "^default",
        {
          "dependentTasksOutputFiles": "packages/wasm/**/*"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "e2e": {
      "command": "pnpm run test:e2e",
      "options": {
        "cwd": "apps/web"
      },
      // Not cached: real browser runs against disposable Postgres/IntegreSQL
      // containers have side effects and (documented, measured) flake, so a
      // blind replay would hide either. dependsOn ensures the bundle it
      // serves from dist/ is current before it runs.
      "cache": false,
      "dependsOn": ["build-cf"],
      "inputs": [
        "{projectRoot}/src/**",
        "{projectRoot}/tests/e2e/**",
        "{projectRoot}/playwright.config.ts",
        "{projectRoot}/vite.config.ts"
      ]
    },
    "workers-tests": {
      "command": "pnpm run test:calendar",
      "options": {
        "cwd": "apps/web"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/server/calendar/**",
        "{projectRoot}/src/server/database-freshness/**",
        "{projectRoot}/vitest.calendar.config.ts"
      ]
    }
  }
}
