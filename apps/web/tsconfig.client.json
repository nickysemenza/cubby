{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-environment.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "src/server/**",
    "src/cf-server.ts",
    "src/server.ts",
    "src/lib/auth.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "src/lib/test/**"
  ],
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "tooling/*": ["./tooling/*"],
      "~/server/entity-kernel/metadata/read.boundary": [
        "./artifacts/server-contracts/server/entity-kernel/metadata/read.boundary"
      ],
      "~/server/http/routes/*": [
        "./artifacts/server-contracts/server/http/routes/*"
      ],
      "~/server/operation-runtime/browser-operation-dispatch": [
        "./artifacts/server-contracts/server/operation-runtime/browser-operation-dispatch"
      ],
      "~/server/operation-runtime/middleware/native-workspace": [
        "./artifacts/server-contracts/server/operation-runtime/middleware/native-workspace"
      ],
      "~/server/operation-runtime/middleware/private-server-functions": [
        "./artifacts/server-contracts/server/operation-runtime/middleware/private-server-functions"
      ],
      "~/server/operation-runtime/middleware/tracing": [
        "./artifacts/server-contracts/server/operation-runtime/middleware/tracing"
      ],
      "~/server/http/guard-session.boundary": [
        "./artifacts/server-contracts/server/http/guard-session.boundary"
      ],
      "~/server/http/source-release.boundary": [
        "./artifacts/server-contracts/server/http/source-release.boundary"
      ]
    }
  }
}
