# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/recipehub"

# R2 Storage
R2_ACCESS_KEY_ID=example
R2_SECRET_ACCESS_KEY=example
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_BUCKET_NAME=example
R2_PUBLIC_URL=https://foobucket.nicky.fun

# USDA API Client URL - defaults to localhost for development
# In production, set to: https://usda-db.fly.dev/
USDA_API_URL="http://localhost:8080/"

# UPC Lookup Worker - defaults to production worker
# API key is optional (worker may allow unauthenticated requests)
UPC_LOOKUP_API_URL="https://upc-lookup.nicky.workers.dev"
UPC_LOOKUP_API_KEY="your-api-key"

# For running system scripts (load-data.ts, etc.):
# 1. Create an API key via the web UI (once better-auth API key management is added)
# 2. Set API_KEY to the generated key (starts with "ba_")
# 3. Set ORGANIZATION_ID to either the organization slug or UUID
# Example using slug (easier to remember):
#   API_KEY="ba_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#   ORGANIZATION_ID="acme-corp"
# Or using UUID:
#   ORGANIZATION_ID="88446b48-5885-4fbd-b378-2446af89a170"

# Base URL for the application (defaults to localhost in development)
# In production, set to your application's public URL
# VITE_APP_URL="http://localhost:3000"

# Google Sheets Integration (optional)
# To enable Google Sheets sync:
# 1. Create a Google Cloud project and enable the Google Sheets API
# 2. Create a service account and download the JSON key
# 3. Set these environment variables from the JSON key
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service@project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenTelemetry (optional, Node.js dev mode only)
# Traces are exported to this OTLP HTTP endpoint (default: http://localhost:4318)
# Jaeger all-in-one exposes OTLP on port 4318, see docker-compose.yml
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
