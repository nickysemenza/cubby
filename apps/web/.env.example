# Deployment/explicit service configuration reference. `pnpm dev` ignores this
# file and supplies guarded local auth, PostgreSQL, and storage values.
# See docs/local-development.md for local profiles and optional settings.
# Keep credential values synthetic in this committed example.

# Auth
BETTER_AUTH_SECRET="dev-secret-change-me-in-production"
# Signup is closed by default (personal instance). Uncomment to temporarily
# allow creating an account, then remove again.
# ALLOW_SIGNUP="true"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cubby"

# R2 Storage
R2_ACCESS_KEY_ID=example
R2_SECRET_ACCESS_KEY=example
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_BUCKET_NAME=example
R2_PUBLIC_URL=https://media.example.com

# USDA API Client URL for local Wrangler development
USDA_API_URL="http://localhost:8787/"

# UPC lookups read Postgres UpcLookupCache and fall back to upcitemdb (no key).
# Set to "true" to skip the upcitemdb fallback (offline dev, E2E).
UPC_UPSTREAM_DISABLED="false"

# Base URL for the application (defaults to localhost in development)
# In production, set to your application's public URL
# VITE_APP_URL="http://localhost:3000"

# Notion API (optional, for importing recipes from Notion)
# Create an internal integration at https://www.notion.so/profile/integrations/internal
# Share the Notion Recipes database with the integration
NOTION_API_KEY=""
