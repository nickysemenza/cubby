# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.ts"
# should be updated accordingly.

# Auth
BETTER_AUTH_SECRET="dev-secret-change-me-in-production"

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cubby"

# R2 Storage
R2_ACCESS_KEY_ID=example
R2_SECRET_ACCESS_KEY=example
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_BUCKET_NAME=example
R2_PUBLIC_URL=https://foobucket.nicky.fun

# USDA API Client URL - defaults to local Wrangler development
# In production, set to: https://usda-api.nicky.workers.dev/
USDA_API_URL="http://localhost:8787/"

# UPC Lookup Worker - defaults to production worker
# API key is optional (worker may allow unauthenticated requests)
UPC_LOOKUP_API_URL="https://upc-lookup.nicky.workers.dev"
UPC_LOOKUP_API_KEY="your-api-key"

# Base URL for the application (defaults to localhost in development)
# In production, set to your application's public URL
# VITE_APP_URL="http://localhost:3000"

# Notion API (optional, for Project Tracker dashboard)
# Create an internal integration at https://www.notion.so/profile/integrations/internal
# Share the "Project Tracker" page with the integration
NOTION_API_KEY=""

# OpenTelemetry (optional, Node.js dev mode only)
# Traces are exported to this OTLP HTTP endpoint (default: http://localhost:4318)
# Jaeger all-in-one exposes OTLP on port 4318, see docker-compose.yml
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
