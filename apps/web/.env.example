# Optional local credential for live AI evals and the Tester Army browser driver.
# Copy to apps/web/.env (gitignored) and replace the synthetic value.
# Normal development and deterministic E2E tests need no .env file.
# Local startup supplies database, auth, and storage configuration.
# Deployment bindings and secrets: docs/infrastructure.md.
AI_GATEWAY_API_KEY="example-gateway-inference-token"
# Optional dedicated driver credential; falls back to AI_GATEWAY_API_KEY.
TESTER_ARMY_CF_API_TOKEN=""
