{
  "name": "cubby",
  "main": "src/cf-server.ts",
  // Bumped to 2026-06-16 for the cloudflare:workers `tracing.enterSpan` custom-spans
  // API (shipped 2026-06-16) — see src/server/tracing.ts prod backend.
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  // Runaway-request guardrail above the 30s default. The original 120s stopgap
  // was for the Problems WASM parse-sweeps, which have since moved off the hot
  // path into Settings → Maintenance manual actions (the per-detector lazy split
  // landed). 45s keeps headroom for an eager costing recompute on a large recipe
  // tree while letting a pathological request fail fast instead of burning 2 min
  // of CPU. Single-user app, so the headroom is negligible cost.
  "limits": {
    "cpu_ms": 45000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
      // Named OTLP destination configured in the CF dashboard (Workers
      // Observability → Destinations) pointing at Grafana Cloud Loki.
      "destinations": ["grafana-logs"]
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
      // Named OTLP destination pointing at Grafana Cloud Tempo. Captures CF
      // platform auto-spans + our cloudflare:workers custom spans.
      "destinations": ["grafana-traces"]
    }
  },
  "routes": [
    {
      "pattern": "cubby.nickysemenza.com",
      "custom_domain": true
    }
  ],
  // Prod is custom-domain only — keep the production *.workers.dev URL off so
  // cubby.nickysemenza.com is the sole prod origin. Per-PR preview deploys
  // (`wrangler versions upload`) still get https://<prefix>-cubby.nicky.workers.dev
  // via preview_urls. NOTE: these are non-versioned settings — they apply on
  // `wrangler deploy` (deploy-cf), not on `versions upload`, so enable Preview
  // URLs once in the dashboard for them to take effect before the first prod
  // deploy. Pinned here so a later deploy can't silently flip either.
  "workers_dev": false,
  "preview_urls": true,
  // Place Worker near the database rather than the user (SSR-heavy app)
  "placement": {
    "mode": "smart"
  },
  // Worker-to-worker service bindings (prod only — dev falls back to the
  // public *_API_URL vars below since vite dev runs plain Node).
  "services": [
    { "binding": "USDA_API", "service": "usda-api" },
    { "binding": "UPC_LOOKUP", "service": "upc-lookup" }
  ],
  // Workers AI binding — exposes `env.AI.gateway("cubby")` for routing the
  // Anthropic/OpenAI adapters through Cubby's authenticated AI Gateway with
  // implicit (Worker-identity) auth. Dev (vite Node) has no `env.AI`, so those
  // clients fall back to gateway-REST with AI_GATEWAY_API_KEY. See
  // src/server/clients/{anthropic,openai}.ts + src/server/cf-env.ts.
  "ai": { "binding": "AI" },
  // Hyperdrive connection pooling — creates via:
  //   wrangler hyperdrive create cubby-db --connection-string="postgres://..."
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "adc9757dfffd45bc94d5c2a66b2ad410"
    }
  ],
  // Recipe-totals recompute offloaded off the request path. A heavily-used
  // ingredient merge can touch 100+ recipes; recomputing inline overruns the
  // per-invocation CPU/memory budget, so dispatchRecompute fans the recipe ids
  // into RECOMPUTE_CHUNK_SIZE targeted chunks (one message each). max_batch_size:1
  // keeps one chunk per invocation; max_concurrency:1 keeps the drain serial and
  // predictable while stale-id filtering makes old duplicate chunks cheap no-ops.
  // Create once before first deploy:
  //   wrangler queues create cubby-recompute
  //   wrangler queues create cubby-recompute-dlq
  "queues": {
    "producers": [{ "binding": "RECOMPUTE_QUEUE", "queue": "cubby-recompute" }],
    "consumers": [
      {
        "queue": "cubby-recompute",
        // Batch many chunks into one invocation. The per-chunk work is small and
        // IO-bound (~250-500ms: a USDA service fetch + a few small DB writes); at
        // batch_size:1 the drain wall-time was dominated by SERIAL queue-dispatch
        // latency — the gap between one single-message invocation acking and the
        // next being delivered, paid once per chunk. Batching pays that gap ~once
        // per 10 chunks instead, collapsing a ~26s drain toward ~10s. The handler
        // (cf-server.ts queue()) loops over the batch and acks/retries EACH message
        // individually, so per-message ack isolation is preserved — this is NOT
        // union-processing. timeout:0 delivers as soon as messages are present
        // (the burst is sent in one sendBatch, so a full batch is already waiting);
        // it only stops the trailing cascade messages (which arrive 1-4 at a time)
        // from sitting in a fill-the-batch wait. The inherent ~1s queue pickup
        // latency is a Queues property, not tunable by these knobs.
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        // SERIAL by choice (concurrency:1), independent of batch size. With
        // concurrency:1 there is still at most ONE invocation in flight, so no two
        // messages race the same recipe — the parent-cascade stays simple and fully
        // consistent (the stale-filter + cascade dedup rely on this). Concurrency
        // WOULD be safe perf-wise (the work is IO-bound, not CPU-bound) and faster,
        // but it reintroduces a lost-update window not worth it for a single-user
        // app; batching is the throughput lever instead. NOTE: the earlier
        // "CPU-bound / 16965ms load+compute" rationale here was a MISDIAGNOSIS — a
        // wasm_tracing CPU leak (fixed in recipebridge/src/lib.rs) mis-timed by
        // workerd's frozen clock. If you ever raise concurrency, re-check the
        // cascade race (see recipe-costing.service.ts enqueueParentCascade).
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "cubby-recompute-dlq"
      }
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    // Signup is closed (personal instance). Flip to "true" + deploy to
    // temporarily allow creating an account, then flip back.
    "ALLOW_SIGNUP": "false",
    "R2_ENDPOINT": "https://9f10f078d35d86c78dedece2300a6b88.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "foo",
    "R2_PUBLIC_URL": "https://foobucket.nicky.fun",
    "R2_KEY_PREFIX": "cubby",
    "USDA_API_URL": "https://usda-api.nicky.workers.dev/",
    "UPC_LOOKUP_API_URL": "https://upc-lookup.nicky.workers.dev"
  }
  // Required secrets (set via `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET
  //   R2_ACCESS_KEY_ID
  //   R2_SECRET_ACCESS_KEY
  //   AI_GATEWAY_API_KEY (optional)
  // Note: DATABASE_URL is provided by the Hyperdrive binding, not a secret.
}
