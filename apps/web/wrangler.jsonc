{
  "name": "cubby",
  "main": "src/cf-server.ts",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "cubby.nickysemenza.com",
      "custom_domain": true
    }
  ],
  // Place Worker near the database rather than the user (SSR-heavy app)
  "placement": {
    "mode": "smart"
  },
  // Hyperdrive connection pooling — creates via:
  //   wrangler hyperdrive create cubby-db --connection-string="postgres://..."
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "adc9757dfffd45bc94d5c2a66b2ad410"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "R2_ENDPOINT": "https://9f10f078d35d86c78dedece2300a6b88.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "foo",
    "R2_PUBLIC_URL": "https://foobucket.nicky.fun",
    "R2_KEY_PREFIX": "cubby",
    "USDA_API_URL": "https://usda-api.nicky.workers.dev/",
    "UPC_LOOKUP_API_URL": "https://upc-lookup.nicky.workers.dev"
  }
  // Required secrets (set via `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET
  //   R2_ACCESS_KEY_ID
  //   R2_SECRET_ACCESS_KEY
  //   AI_GATEWAY_API_KEY (optional)
  // Note: DATABASE_URL is provided by the Hyperdrive binding, not a secret.
}
