{
  "name": "cubby",
  "main": "src/cf-server.ts",
  // Sentry owns source-map upload. Cloudflare's duplicate upload exceeds its
  // compressed map limit; maps remain in the build for Sentry and path validation.
  "upload_source_maps": false,
  // 2026-06-16 is the minimum for the cloudflare:workers `tracing.enterSpan` custom-spans
  // API (shipped 2026-06-16) — see src/server/tracing.ts prod backend.
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Runaway-request guardrail above the 30s default. The original 120s stopgap
  // was for the Problems WASM parse-sweeps, which have since moved off the hot
  // path into Settings → Maintenance manual actions (the per-detector lazy split
  // landed). 45s keeps headroom for an eager costing recompute on a large recipe
  // tree while letting a pathological request fail fast instead of burning 2 min
  // of CPU. Single-user app, so the headroom is negligible cost.
  "limits": {
    "cpu_ms": 45000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
      // Named OTLP destination configured in the CF dashboard (Workers
      // Observability → Destinations) pointing at Grafana Cloud Loki.
      "destinations": ["grafana-logs"]
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "cubby.nickysemenza.com",
      "custom_domain": true
    }
  ],
  // Prod is custom-domain only — cubby.nickysemenza.com is the sole prod
  // origin. Both flags are pinned false so a later deploy can't flip them.
  "workers_dev": false,
  "preview_urls": false,
  // Vite's client output (and the emitted OpenAPI document) is served as
  // static assets before the Worker runs.
  "assets": { "html_handling": "none" },
  // Home and list reads make sequential Hyperdrive queries. Run near Neon;
  // Smart placement left observed requests local to the user.
  "placement": {
    "region": "aws:us-west-2"
  },
  // Worker-to-worker service bindings (prod only — dev falls back to the
  // public *_API_URL vars below since vite dev runs plain Node).
  // Workers AI binding — exposes `env.AI.gateway("cubby")`, the Universal
  // endpoint every AI call rides: the provider SDKs and the cookbook
  // forwarder all fetch through one shim that authenticates with implicit
  // (Worker-identity) auth. Dev (vite Node) has no `env.AI`, so the shim falls
  // back to gateway-REST with AI_GATEWAY_API_KEY. See
  // src/server/ai/gateway.ts + src/server/cf-env.ts.
  "ai": { "binding": "AI" },
  // Entity embedding vectors. One index per (model, dimensions) — the index's
  // dimension count is immutable, so a model change is a new index. Only
  // `entityType` is metadata-indexed (17 values); the slim `EntityEmbedding`
  // Postgres row keeps the hash/readiness bookkeeping. Create via:
  //   wrangler vectorize create cubby-openai-text-embedding-3-small-1536 --dimensions=1536 --metric=cosine
  //   wrangler vectorize create-metadata-index cubby-openai-text-embedding-3-small-1536 --property-name=entityType --type=string
  // Dev (vite Node) has no binding, so semantic search reports unconfigured.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "cubby-openai-text-embedding-3-small-1536"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_GATEWAY_EGRESS",
        "class_name": "AiGatewayEgressDurableObject"
      },
      {
        "name": "DB_FRESHNESS",
        "class_name": "DatabaseFreshnessDurableObject"
      },
      {
        "name": "CALENDAR_FEED",
        "class_name": "CalendarFeedDurableObject"
      },
      {
        "name": "IMAGE_PROCESSING",
        "class_name": "ImageProcessingDurableObject"
      },
      {
        "name": "AI_RESPONSE_CACHE",
        "class_name": "AiResponseCacheDurableObject"
      },
      {
        "name": "CHATGPT_PLAN",
        "class_name": "ChatGptPlanDurableObject"
      },
      // The purchase agent: one import Run's coordinator per object, named by
      // `importRunAgentIdentity`; pi-durable keeps its transcript in the
      // object's SQLite (src/server/purchase-import/agent-host.ts).
      {
        "name": "PURCHASE_IMPORT_RUN",
        "class_name": "PurchaseImportRunAgent"
      },
      // One object per USDA release, named `<release>.g<generation>`
      // (src/server/usda-release; docs/adr/0008-usda-release-durable-object.md).
      {
        "name": "USDA_RELEASE",
        "class_name": "UsdaReleaseDurableObject"
      }
    ]
  },
  "exports": {
    "AiGatewayEgressDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "UsdaReleaseDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "DatabaseFreshnessDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CalendarFeedDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    // The retired Mac browser bridge broker (ADR 0008): the tombstone deletes
    // its namespace and stored commands. Remove once a deploy reports it stale.
    "PurchaseImportDurableObject": {
      "type": "durable-object",
      "state": "deleted"
    },
    "ImageProcessingDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AiResponseCacheDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ChatGptPlanDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PurchaseImportRunAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  // Makes every trace attributable to the exact immutable Worker version.
  // This works for both production deploys and per-PR version previews.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Two Hyperdrive objects point at the same direct Neon origin. HYPERDRIVE is
  // authoritative (strong reads); HYPERDRIVE_CACHED is the bounded-stale read
  // path. Provider-side origin connection caps and the production compute
  // range live in docs/infrastructure.md; neither is expressible here. Pool
  // capacity must account for concurrent requests and available origin RAM,
  // not only the per-request ceiling in db-runtime-resolver.ts. Desired timings live
  // in src/lib/hyperdrive-cache-policy.ts for the same reason.
  // Creates via:
  //   wrangler hyperdrive create cubby-db --connection-string="postgres://..."
  //   wrangler hyperdrive create cubby-db-cached --connection-string="postgres://..."
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "adc9757dfffd45bc94d5c2a66b2ad410"
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "427dd7a2876c4dccbe056d37fa7374ff"
    }
  ],
  // Durable, page-oriented search-index repair. The request that starts the
  // instance may disconnect; progress is replayed from retained Workflow events.
  //
  // Scheduled Gmail discovery runs one `mail_discovery` pass per mailbox. Its
  // Run row is the durable record and each instance is one attempt at it
  // (`<runShortcode>-<attempt>`), so retention only bounds diagnostics
  // (`server/workflow-runs/launcher.ts` sets it per instance).
  "workflows": [
    {
      "name": "cubby-ai-refresh",
      "binding": "AI_REFRESH",
      "class_name": "AiRefreshWorkflow"
    },
    {
      "binding": "SEARCH_INDEX_REPAIR",
      "name": "cubby-search-index-repair",
      "class_name": "SearchIndexRepairWorkflow"
    },
    {
      "binding": "MAIL_DISCOVERY",
      "name": "cubby-mail-discovery",
      "class_name": "MailDiscoveryWorkflow"
    }
  ],
  // Background tasks offloaded off the request path. A message is the whole
  // task (recipe totals, an embedding refresh, a location AI refresh); there
  // is no execution row behind it. Every handler re-checks the derived
  // state's own freshness marker, so duplicate or redelivered messages are
  // no-ops, and a message the queue drops after its retries is not lost work:
  // the stale marker on the source row keeps it visible on the Problems
  // page's "Awaiting work" card, where "Settle now" republishes it.
  // Create once before first deploy:
  //   wrangler queues create cubby-background
  //   wrangler queues create cubby-image-cloud
  //   wrangler queues create cubby-telemetry
  //
  // Separate queues own separate concurrency budgets. Background and cloud
  // photos favor immediate delivery; telemetry batches inserts. The cloud
  // handoff releases shared slots before download/model work, so photos cannot
  // occupy both shared consumers while other freshness work waits.
  //
  // No dead-letter queues, deliberately: a message that exhausted its retries
  // carries no information the source rows do not already hold, and every
  // failed attempt was already reported to Sentry by the consumer.
  "queues": {
    "producers": [
      { "binding": "BACKGROUND_QUEUE", "queue": "cubby-background" },
      { "binding": "IMAGE_CLOUD_QUEUE", "queue": "cubby-image-cloud" },
      { "binding": "TELEMETRY_QUEUE", "queue": "cubby-telemetry" },
      {
        "binding": "PURCHASE_AGENT_QUEUE",
        "queue": "cubby-purchase-agent"
      }
    ],
    "consumers": [
      {
        "queue": "cubby-image-cloud",
        // The shared consumer only awaits publication. Claim/download/model work
        // starts here: one image per invocation and at most four DB clients,
        // alongside the shared queue's two. The Gateway bounds paid starts too.
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 4,
        "max_retries": 3
      },
      {
        "queue": "cubby-background",
        // One task per invocation bounds isolate memory. A ten-task batch
        // exceeded the Worker memory limit before a queued Run was claimed.
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // Each invocation holds one database client; bound competing background
        // work while interactive requests share the Hyperdrive origin pool.
        // Freshness gates, rather than serial delivery, protect correctness.
        "max_concurrency": 2,
        "max_retries": 3
      },
      {
        "queue": "cubby-telemetry",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      },
      // Purchase-agent events (run starts, browser results). The consumer
      // fences duplicates and late deliveries itself and retries a transient
      // admission failure up to three attempts before failing the run.
      {
        "queue": "cubby-purchase-agent",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "vars": {
    "AI_REFRESH_ENABLED": "true",
    "NODE_ENV": "production",
    // Signup is closed (personal instance). Flip to "true" + deploy to
    // temporarily allow creating an account, then flip back.
    "ALLOW_SIGNUP": "false",
    "E2E_AUTH_TEST_MODE": "false",
    "APP_ORIGIN": "https://cubby.nickysemenza.com",
    "R2_ENDPOINT": "https://9f10f078d35d86c78dedece2300a6b88.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "foo",
    "R2_PUBLIC_URL": "https://media.nickysemenza.com",
    "R2_KEY_PREFIX": "cubby",
    // OAuth client IDs are public identifiers. The paired client secret is a
    // Worker secret and must never be committed.
    "GOOGLE_CLIENT_ID": "183601884678-9rddrge4anct24rnbvqb5jm5q9fb8oqg.apps.googleusercontent.com",
    // Activation and rollback of a USDA release are a deploy (ADR 0008).
    "USDA_ACTIVE_RELEASE": "2026-04"
  },
  // Gzipped NDJSON shards per USDA release, loaded by USDA_RELEASE.
  "r2_buckets": [
    { "binding": "USDA_RELEASES", "bucket_name": "cubby-usda-releases" }
  ]
  // Required secrets (set via `wrangler secret put <NAME>`):
  //   BETTER_AUTH_SECRET
  //   R2_ACCESS_KEY_ID
  //   R2_SECRET_ACCESS_KEY
  //   GOOGLE_CLIENT_SECRET (optional; required for Gmail discovery)
  // Note: production uses Hyperdrive instead of DATABASE_URL and the AI binding
  // instead of AI_GATEWAY_API_KEY. The latter stays in local .env for Vite dev.
}
