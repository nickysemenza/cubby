# Better-Auth Test User Credentials for E2E Tests
# Add these to your .env file (playwright.config.ts only loads .env)

# Test user credentials for Playwright e2e tests
# The global setup will create a user with these credentials if they don't exist,
# or sign in with them if they already exist

E2E_TEST_USER_EMAIL=test@example.com
E2E_TEST_USER_PASSWORD=TestPassword123!

# Note: The global setup will automatically:
# 1. Create/sign in the test user
# 4. Save the auth state to playwright/.auth/user.json
