{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "system config",
  "type": "object",
  "properties": {
    "locations": {
      "description": "locations that have inventoryable items",
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "products": {
      "description": "products that can be purchased",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "upc": {
            "description": "12 digit UPC code",
            "type": "string",
            "minLength": 12,
            "maxLength": 14
          },
          "ndb_number": {
            "description": "NDB number",
            "type": "number",
            "minimum": 1000,
            "maximum": 99999
          },
          "manufacturer": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "ingredient": {
            "description": "if the product is an ingredient, an ingredient with the same name will be created and linked to this product",
            "type": "boolean"
          },
          "aliases": {
            "description": "alternative names for this ingredient",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "price_per": {
            "description": "price per each, shorthand for unit_mappings",
            "type": "number"
          },
          "unit_mappings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "manufacturer"
        ],
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "locations",
    "products"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "name": {
          "description": "name of location",
          "type": "string"
        },
        "type": {
          "description": "type of location (room, container, etc)",
          "type": "string",
          "enum": [
            "room",
            "bag",
            "shelf",
            "crate",
            "half-crate",
            "table",
            "drawer",
            "cart",
            "cabinet"
          ]
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "upc": {
                "description": "12 digit UPC code",
                "type": "string",
                "minLength": 12,
                "maxLength": 14
              },
              "ndb_number": {
                "description": "NDB number",
                "type": "number",
                "minimum": 1000,
                "maximum": 99999
              },
              "manufacturer": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "ingredient": {
                "description": "if the product is an ingredient, an ingredient with the same name will be created and linked to this product",
                "type": "boolean"
              },
              "aliases": {
                "description": "alternative names for this ingredient",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "price_per": {
                "description": "price per each, shorthand for unit_mappings",
                "type": "number"
              },
              "unit_mappings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "manufacturer"
            ],
            "additionalProperties": false
          }
        },
        "productReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    }
  }
}