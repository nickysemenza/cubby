{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "apple",
  "namedInputs": {
    "appleCommon": [
      "{workspaceRoot}/cubby-ffi/**/*",
      "{workspaceRoot}/recipebridge/**/*",
      "{workspaceRoot}/Cargo.{toml,lock}",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/**/*",
      "{workspaceRoot}/scripts/{apple/apple-check.sh,apple/apple-inputs.ts,ci-environment.ts,ensure.ts,rust-fingerprint.ts,lib/tree-digest.ts}",
      { "runtime": "node scripts/ci-environment.ts apple" },
      { "runtime": "node scripts/ci-environment.ts ffi" },
      "{projectRoot}/scripts/{prepare-project.sh,build-rust.sh,check-openapi-warnings.sh}",
      "{workspaceRoot}/packages/shared/golden-vectors/**/*",
      "{workspaceRoot}/.github/workflows/ci.yaml",
      "{workspaceRoot}/.github/actions/**/*",
      {
        "externalDependencies": []
      }
    ],
    "appleHost": [
      "appleCommon",
      "{projectRoot}/CubbyKit/**/*",
      "!{projectRoot}/CubbyKit/Sources/CubbyAPI/README.md",
      {
        "runtime": "node scripts/apple/apple-inputs.ts host"
      }
    ],
    "appleApp": [
      "appleCommon",
      "{projectRoot}/**/*",
      "!{projectRoot}/{AGENTS,DESIGN,ITERATION,README}.md",
      "!{projectRoot}/CubbyKit/Sources/CubbyAPI/README.md",
      "!{projectRoot}/CubbyKit/Tests/**/*",
      {
        "runtime": "node scripts/apple/apple-inputs.ts app"
      }
    ]
  },
  "targets": {
    "lint": {
      "command": "bash scripts/apple/apple-check.sh lint",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.swift",
        "{projectRoot}/.swift-format",
        "{workspaceRoot}/scripts/apple/apple-check.sh",
        { "runtime": "node scripts/ci-environment.ts swift" },
        {
          "externalDependencies": []
        }
      ]
    },
    "host-tests": {
      "command": "bash scripts/apple/apple-check.sh host",
      "cache": true,
      "inputs": [
        "appleHost"
      ]
    },
    "simulator-build": {
      "command": "bash scripts/apple/apple-check.sh app",
      "cache": true,
      "inputs": [
        "appleApp"
      ],
      "outputs": [
        "{projectRoot}/DerivedData/Build/Products/Debug-iphonesimulator/Cubby.app"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "host-tests",
        "simulator-build"
      ]
    }
  }
}
