{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "apple",
  "namedInputs": {
    // What the Apple build reads, so a web-only change replays the Apple
    // lanes: its own tree, the Rust FFI crates, the check scripts and CI
    // config, the shared golden vectors, and the generated Swift. Git ignores
    // the generated files, so they are hashed at runtime in git's byte order;
    // `sort` would follow the locale, which differs between a Mac shell and
    // the runner. The Rust-built FFI shim is left out: CI probes before it
    // exists, and its Rust inputs are keyed. Toolchains (Xcode, Rust) are
    // absent so a developer Mac's pass counts for CI; the nightly uncached run
    // covers CI's toolchain (docs/adr/0009-content-hash-merge-gate.md).
    "appleGate": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/cubby-ffi/**/*",
      "{workspaceRoot}/recipebridge/**/*",
      "{workspaceRoot}/Cargo.{toml,lock}",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/scripts/{apple-check.sh,ensure-apple-ffi.ts,rust-fingerprint.ts,lib/tree-digest.ts}",
      // CubbyKit's tests read these expected values directly.
      "{workspaceRoot}/packages/shared/golden-vectors/**/*",
      "{workspaceRoot}/.github/workflows/ci.yaml",
      "{workspaceRoot}/.github/actions/**/*",
      {
        "runtime": "git ls-files -o -i --exclude-standard -- apps/apple/App/Shared/Previews/Fixtures apps/apple/CubbyKit/Sources apps/apple/Generated ':!apps/apple/CubbyKit/Sources/CubbyFFI' | xargs shasum -a 256"
      }
    ]
  },
  // No explicit `cwd`: nx:run-commands defaults to the workspace root, which
  // scripts/apple-check.sh (and the paths inside it) assume.
  "targets": {
    "host-tests": {
      "command": "sh scripts/apple-check.sh host",
      "cache": true,
      "inputs": ["appleGate"]
    },
    "simulator-build": {
      "command": "sh scripts/apple-check.sh app",
      "cache": true,
      "inputs": ["appleGate"],
      // Restored on a hit, so the simulator E2E installs the cached app.
      "outputs": [
        "{projectRoot}/DerivedData/Build/Products/Debug-iphonesimulator/Cubby.app"
      ]
    },
    // `pnpm apple check`; CI runs the two halves on parallel runners.
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["host-tests", "simulator-build"]
    }
  }
}
