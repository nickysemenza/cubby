{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "apple",
  "targets": {
    "lint": {
      "command": "bash apps/apple/tooling/apple-check.sh lint",
      "cache": true,
      "inputs": [
        "{projectRoot}/App/**/*.swift",
        "{projectRoot}/CubbyKit/Sources/CubbyKit/**/*.swift",
        "!{projectRoot}/CubbyKit/Sources/CubbyKit/Generated/**/*.swift",
        "{projectRoot}/CubbyKit/Sources/cubby/**/*.swift",
        "{projectRoot}/CubbyKit/Sources/CubbyAPISupport/**/*.swift",
        "{projectRoot}/CubbyKit/Tests/**/*.swift",
        "{projectRoot}/.swift-format",
        "{workspaceRoot}/apps/apple/tooling/apple-check.sh",
        // stdout only: some Swift builds print a driver version to stderr.
        { "runtime": "swift --version 2>/dev/null" },
        {
          "externalDependencies": []
        }
      ]
    },
    "host-tests": {
      "command": "bash apps/apple/tooling/apple-check.sh host",
      "cache": false
    },
    "simulator-build": {
      "command": "bash apps/apple/tooling/apple-check.sh app",
      "cache": false,
      "outputs": [
        "{projectRoot}/DerivedData/Build/Products/Debug-iphonesimulator/Cubby.app"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        "host-tests",
        "simulator-build"
      ]
    }
  }
}
