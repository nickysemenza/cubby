context platform=ios timeout=120000

open com.nickysemenza.cubby
wait "role=Button label=More" 60000
open cubby://entity/${PRODUCT_ID}
wait "role=Button id=detail.product.edit" 30000
wait text "${PRODUCT_NAME}" 30000
click "role=Button id=detail.product.edit"
wait "label=Name editable=true" 30000
fill "label=Name editable=true" "${UPDATED_NAME}"
click "role=Button label=Save"
wait "role=Button id=detail.product.edit" 30000
wait text "${UPDATED_NAME}" 30000
