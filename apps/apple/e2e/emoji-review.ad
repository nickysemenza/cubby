context platform=ios timeout=240000

open com.nickysemenza.cubby
wait "role=Button label=Library" 240000
click "role=Button label=Library"
wait text "Browse catalog" 30000
click "label=\"Browse catalog\""
scroll top
wait "role=SearchField label=Search" 30000
fill "role=SearchField label=Search" "Product Categories"
wait "label=\"Product Categories\"" 30000
click "label=\"Product Categories\""
wait "id=browse.productCategory.row.${PRODUCT_ID}" 30000
click "id=browse.productCategory.row.${PRODUCT_ID}"
wait "role=Button id=detail.productCategory.edit" 240000
click "role=Button id=detail.productCategory.edit"
wait "label=Name editable=true" 30000
scroll bottom
wait "id=editor.suggestions.request" 30000
click "id=editor.suggestions.request"
scroll bottom
wait "id=editor.suggestions.emoji.apply" 30000
scroll top
wait "label=Emoji editable=true value=\"Choose an emoji\"" 30000
scroll bottom
click "id=editor.suggestions.emoji.apply"
scroll top
wait "label=Emoji editable=true value=🥕" 30000
click "role=Button label=Save"
wait "role=Button id=detail.productCategory.edit" 30000
click "role=Button id=detail.productCategory.edit"
wait "label=Emoji editable=true value=🥕" 30000
fill "label=Name editable=true" "Synthetic Emoji Category Updated"
fill "label=Emoji editable=true" "👩🏽‍🍳"
click "role=Button label=Save"
wait "role=Button id=detail.productCategory.edit" 30000
wait text "Synthetic Emoji Category Updated" 30000
click "role=Button id=detail.productCategory.edit"
wait "label=Emoji editable=true value=👩🏽‍🍳" 30000
fill "label=Emoji editable=true" ""
click "role=Button label=Save"
wait "role=Button id=detail.productCategory.edit" 30000
