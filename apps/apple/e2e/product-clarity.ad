context platform=ios timeout=240000

open com.nickysemenza.cubby
wait "label=Find" 60000
click "label=Find"
wait "role=SearchField label=\"Search Cubby\" editable=true" 30000
fill "role=SearchField label=\"Search Cubby\" editable=true" "Synthetic Atlas Lantern" --delay-ms 80
wait "id=search.result.${PRODUCT_ID}" 30000
click "id=search.result.${PRODUCT_ID}"
scroll down --until "id=field.explanation.product.${PRODUCT_ID}.price"
click "id=field.explanation.product.${PRODUCT_ID}.price"
wait "id=field.explanation.popover" 30000
wait text "In effect" 30000
wait text "$40.00" 30000
wait text "Without the override" 30000
wait text "$20.00" 30000
scroll down --until "label=\"Manual valuation price\""
wait text "Manual valuation price" 30000
wait text "Expense-derived unit price" 30000
scroll up --until "id=field.explanation.close"
click "id=field.explanation.close"
scroll down --until "id=relation.evidence.purchase.${PURCHASE_ID}.movement.acquired"
wait "id=relation.evidence.purchase.${PURCHASE_ID}.movement.acquired" 30000
wait "id=relation.evidence.purchase.${PURCHASE_ID}.movement.adjusted" 30000
wait "id=relation.evidence.purchase.${PURCHASE_ID}.planned" 30000
wait "id=relation.evidence.purchase.${PURCHASE_ID}.linked" 30000
click "id=relation.row.purchase.${PURCHASE_ID}"
scroll down --until "id=relation.evidence.product.${PRODUCT_ID}.movement.acquired"
wait "id=relation.evidence.product.${PRODUCT_ID}.movement.acquired" 30000
wait "id=relation.evidence.product.${PRODUCT_ID}.movement.adjusted" 30000
wait "id=relation.evidence.product.${PRODUCT_ID}.planned" 30000
wait "id=relation.evidence.product.${PRODUCT_ID}.linked" 30000
