context platform=ios timeout=240000

open com.nickysemenza.cubby
wait "role=Button label=Find" 240000
click "role=Button label=Find"
wait "role=SearchField label=\"Search Cubby\" editable=true" 30000
fill "role=SearchField label=\"Search Cubby\" editable=true" "Synthetic Atlas Lantern" --delay-ms 80
wait "id=search.result.${PRODUCT_ID}" 30000
click "id=search.result.${PRODUCT_ID}"
wait "role=Button id=detail.product.edit" 30000
click "role=Button id=detail.product.edit"
wait "label=Name editable=true" 30000
fill "label=Name editable=true" "Synthetic Atlas Lantern Updated"
click "role=Button label=Save"
wait "role=Button id=detail.product.edit" 30000
wait text "Synthetic Atlas Lantern Updated" 30000

click "label=Library id=BackButton"
wait text "Browse catalog" 30000
click "label=\"Browse catalog\"" --settle
scroll down 0.5 --until "id=browse.catalog.product"
wait "id=browse.catalog.product" 30000
click "id=browse.catalog.product label=Products"
wait text "Synthetic Atlas Lantern Updated" 30000
wait "id=browse.product.row.${PRODUCT_ID}" 30000
wait "label=\"List controls\"" 30000
click "label=\"List controls\""
wait "label=View" 30000
click "label=View"
wait "label=Cards" 30000
click "label=Cards"
wait "id=browse.product.cards.${PRODUCT_ID}" 30000
wait "label=\"List controls\"" 30000
click "label=\"List controls\""
wait "label=View" 30000
click "label=View"
wait "label=Compact" 30000
click "label=Compact"
wait "id=browse.product.compact.${PRODUCT_ID}" 30000
wait "label=\"List controls\"" 30000
click "label=\"List controls\""
wait "label=View" 30000
click "label=View"
wait "label=List" 30000
click "label=List"
wait "label=\"List controls\"" 30000
click "label=\"List controls\""
click "role=Button label=Search"
wait "role=SearchField" 30000
fill "role=SearchField editable=true" "Synthetic no matching product" --delay-ms 80
wait text "No matching Products" 30000
fill "role=SearchField editable=true" "Synthetic Atlas Lantern Updated" --delay-ms 80
wait "id=browse.product.row.${PRODUCT_ID}" 30000
