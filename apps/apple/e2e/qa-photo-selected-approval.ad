context platform=ios timeout=240000

# A photo Run opened from its entity link lands on the console with photo review. Selecting only the second
# ready group and approving the selection commits that group alone; the sim QA lane then
# reads back one committed group, one still-proposed group and one Product. Regression:
# the workspace is one List row, so Select once also pushed the match and draft screens, and
# a tap beside a group's name did not open that group.
open com.nickysemenza.cubby
wait "role=Button label=Find" 240000
# Keep Cubby as the automation target when delivering its custom URL.
open com.nickysemenza.cubby "cubby://entity/${PHOTO_RUN_ID}"
wait "id=review.workspace" 90000
wait text "Proposed items · 2" 90000
# The groups, decision and header controls all fit on the first iPhone 17 screen.
click "role=Button label=\"${PHOTO_SELECTED_NAME}\""
wait "role=Button label=\"${PHOTO_SELECTED_NAME}\" selected=true" 30000
click "role=Button label=Select"
wait "role=Button label=Selected" 30000
click "label=\"Approve selected · 1\""
# The settled group sits below the long evidence list; the lane's database readback checks it.
wait text "Proposed items · 1" 90000
