context platform=ios timeout=240000

open com.nickysemenza.cubby
wait "role=Button label=Library" 60000
click "role=Button label=Library"
wait text "Browse catalog" 30000
click "label=\"Browse catalog\""
wait "id=browse.importStatement" 30000
click "id=browse.importStatement"
wait "id=statement.csv.chooseFile" 30000
click "id=statement.csv.chooseFile"
wait "id=DOC.browsingModeTabBar" 30000
click "label=Browse"
wait text "On My iPhone" 30000
click "label=\"On My iPhone\""
wait "id=\"Cubby, Container\"" 30000
click "id=\"Cubby, Container\""
wait "id=\"synthetic-input-statement, csv\"" 30000
# The OS cell spans its filename and metadata; tap the single synthetic file's
# icon rather than its inactive metadata center in this fixed simulator fixture.
press 71 260
wait text "Synthetic Input Card" 30000
wait "id=statement.csv.select.1" 30000
# The switch's AX bounds include its label; tap the thumb in this fixed fixture.
press 338 650
wait "label=Kind" 30000
click "label=Kind"
wait "label=Purchase" 30000
click "label=Purchase"
wait "id=statement.csv.confirm" 30000
click "id=statement.csv.confirm"
wait text "Transactions recorded" 30000
