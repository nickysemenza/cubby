context platform=ios timeout=240000

# Compact width keeps the loaded search while switching List ↔ Cards, offers
# the entity's table on web, and still opens the selected record natively.
open com.nickysemenza.cubby
wait "role=Button label=Library" 240000
click "role=Button label=Library"
wait text "Browse catalog" 30000
click "label=\"Browse catalog\""
scroll down 0.5 --until "id=browse.catalog.product"
wait "id=browse.catalog.product" 30000
click "id=browse.catalog.product label=Products"
wait "id=browse.product.list" 60000
click "label=\"List controls\""
click "label=Search"
wait "role=SearchField editable=true" 30000
fill "role=SearchField editable=true" "${PRODUCT_ID}"
wait "id=browse.product.row.${PRODUCT_ID}" 60000
click "label=Close"
wait "label=\"List controls\"" 30000
click "label=\"List controls\""
click "label=View"
wait "label=\"Open table on web\"" 30000
click "label=Cards"
wait "id=browse.product.cards.${PRODUCT_ID}" 60000
click "label=\"List controls\""
click "label=View"
click "label=List"
wait "id=browse.product.row.${PRODUCT_ID}" 30000
click "label=\"List controls\""
click "label=View"
wait "label=\"Open table on web\"" 30000
click "label=Cards"
wait "id=browse.product.cards.${PRODUCT_ID}" 30000
click "id=browse.product.cards.${PRODUCT_ID}"
wait "role=Button id=detail.product.edit" 60000
