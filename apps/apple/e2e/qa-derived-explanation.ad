context platform=ios timeout=240000

# The row's override menu must retain Explain. Opening the explanation reads
# the published/live comparison without applying an override or publishing it.
open com.nickysemenza.cubby
wait "role=Button label=Library" 240000
click "role=Button label=Library"
wait text "Browse catalog" 30000
click "label=\"Browse catalog\""
scroll down 0.5 --until "id=browse.catalog.product"
click "id=browse.catalog.product label=Products"
wait "id=browse.product.row.${PRODUCT_ID}" 60000
click "id=browse.product.row.${PRODUCT_ID}"
wait "role=Button id=detail.product.edit" 60000
click "role=Button label=Contents"
wait "role=Button label=\"Stock & price\"" 30000
click "role=Button label=\"Stock & price\""
click "role=Button label=Close"
longpress "id=field.explanation.product.${PRODUCT_ID}.price" 800
wait "role=Button label=Explain" 30000
wait "role=Button label=\"Use inherited\"" 30000
click "role=Button label=Explain"
wait "id=field.explanation.derived" 30000
wait "id=field.explanation.effective-value" 30000
click "role=Button label=\"Close field explanation\""
wait "role=Button id=detail.product.edit" 30000
