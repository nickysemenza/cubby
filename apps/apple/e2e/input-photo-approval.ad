context platform=ios timeout=600000

open com.nickysemenza.cubby
wait "role=Button label=\"Review item groups\"" 240000
click "role=Button label=\"Review item groups\""
wait "id=run.console" 30000
wait "id=review.workspace" 30000
wait text "Synthetic Input Crew Shirt" 30000
click "label=\"Apply ready groups\""
wait text "Settled items" 30000
