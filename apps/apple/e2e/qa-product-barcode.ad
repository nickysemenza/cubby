context platform=ios timeout=240000

# Add preserves the saved primary; explicit promotion keeps the former primary
# searchable through the native sweep and never creates another Product.
open com.nickysemenza.cubby
wait "role=Button label=Search" 240000
open "cubby://entity/${PRODUCT_ID}"
wait "id=detail.product.edit" 90000
click "id=detail.product.edit"
wait text "Edit Product" 90000
scroll down 0.4 --until "id=editor.product.externalIds.add"
click "id=editor.product.externalIds.add"
click "id=editor.product.externalIds.collectionEdit.rows.0.value.source"
type "gtin"
wait "id=editor.product.externalIds.collectionEdit.rows.0.value.source value=gtin" 90000
click "role=Button label=Done"
click "id=editor.product.externalIds.collectionEdit.rows.0.value.kind"
click "role=Button label=GTIN"
click "id=editor.product.externalIds.collectionEdit.rows.0.value.externalId"
type "0-88888-88888-0"
wait "id=editor.product.externalIds.collectionEdit.rows.0.value.externalId value=0-88888-88888-0" 90000
click "role=Button label=Done"
click "role=Button label=Save"
wait "id=detail.product.edit" 90000
click "id=detail.product.edit"
wait text "Edit Product" 90000
scroll down 0.4 --until "id=editor.product.externalIds.add"
wait text "Saved: gtin · GTIN: 00088888888880 · Primary" 90000
click "id=editor.product.externalIds.add"
click "id=editor.product.externalIds.collectionEdit.rows.1.value.source"
type "gtin"
wait "id=editor.product.externalIds.collectionEdit.rows.1.value.source value=gtin" 90000
click "role=Button label=Done"
click "id=editor.product.externalIds.collectionEdit.rows.1.value.kind"
click "role=Button label=GTIN"
click "id=editor.product.externalIds.collectionEdit.rows.1.value.externalId"
type "012345678905"
wait "id=editor.product.externalIds.collectionEdit.rows.1.value.externalId value=012345678905" 90000
click "role=Button label=Done"
click "role=Button label=Save"
wait "id=detail.product.edit" 90000
click "id=detail.product.edit"
wait text "Edit Product" 90000
scroll down 0.4 --until "id=editor.product.externalIds.1.primary"
wait text "Saved: gtin · GTIN: 00088888888880 · Primary" 90000
wait text "Saved: gtin · GTIN: 00012345678905 · Secondary" 90000
click "id=editor.product.externalIds.1.primary"
click "role=Button label=Save"
wait "id=detail.product.edit" 90000
click "role=Button label=Capture"
click "role=Button label=\"Choose a location\""
fill "role=SearchField" "Synthetic Kitchen"
wait "id=capture.location.${LOCATION_ID}" 90000
click "id=capture.location.${LOCATION_ID}"
wait absent "id=capture.location.${LOCATION_ID}" 90000
wait "role=TextField" 90000
click "role=TextField"
type "088888888880"
wait "role=TextField value=088888888880" 90000
click "role=Button label=Done"
click "role=Button label=\"Submit code\""
wait text "Synthetic Flour Bag" 90000
wait text "0 added" 90000
wait text "1 confirmed" 90000
