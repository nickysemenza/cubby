context platform=ios timeout=240000

# A Run reads through the generic kernel list and get, so it browses like any
# other entity: Library → Runs → the seeded run's detail.
open com.nickysemenza.cubby
wait "role=Button label=Library" 240000
click "role=Button label=Library"
# Runs sits in the Finance group, the last group of the catalog.
scroll bottom
wait "id=browse.catalog.run" 30000
click "id=browse.catalog.run"
wait "id=browse.run.list" 60000
# A row exposes its combined label (title, shortcode), not its identifier.
wait "label=\"Synthetic Simulator Member · Photo inventory, ${PAUSED_RUN_ID}\"" 60000
click "label=\"Synthetic Simulator Member · Photo inventory, ${PAUSED_RUN_ID}\""
wait text "Paused" 90000
