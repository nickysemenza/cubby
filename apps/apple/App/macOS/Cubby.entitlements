<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed Mac app. Without the network-client entitlement every request fails in a way
	     that looks like a network outage. user-selected files feed the Identify file picker.
	     These keys are macOS-only: an iOS simulator app carrying them fails to spawn silently. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cubby.nickysemenza.com</string>
		<string>webcredentials:cubby.nickysemenza.com</string>
	</array>
</dict>
</plist>
