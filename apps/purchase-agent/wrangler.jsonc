{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purchase-agent",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Export platform/runtime metadata only. Agent message, tool, and evidence
  // content belongs to the authenticated Flue transcript, never console logs
  // or custom trace attributes.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
      "destinations": ["grafana-logs"]
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "queues": {
    "consumers": [
      {
        "queue": "cubby-purchase-agent",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "services": [
    {
      "binding": "CUBBY_PURCHASE_SERVICE",
      "service": "cubby",
      "entrypoint": "PurchaseImportService"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Sentry environment for the agent Durable Object and the queue consumer.
    // "test" disables reporting entirely (workerd harness; set it in .dev.vars
    // for a silent local `pnpm dev`, or "development" to report under that
    // environment like the web `preview:cf`). The DSN itself is code
    // (`@cubby/worker-tracing/sentry-dsn`), not configuration.
    "SENTRY_ENVIRONMENT": "production"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FluePurchaseImportRunAgent"]
    }
  ]
}
