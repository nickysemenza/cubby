{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on sunday"],
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1,
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "Automerge dependency updates only through a PR with passing checks",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "pin"],
      "groupName": "all minor and pin updates",
      "automerge": true,
      "groupSlug": "all-deps"
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@opentelemetry/*"],
      "enabled": false
    },
    {
      "description": "better-auth minors ship auth schema migrations and drop plugin options that tsc does not flag (oauthProvider options are not excess-property checked), so they get their own PR and a manual MCP OAuth check",
      "matchPackageNames": ["better-auth", "@better-auth/*"],
      "groupName": "better-auth",
      "groupSlug": "better-auth",
      "automerge": false
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "ingredient",
        "recipe-scraper",
        "recipe-types",
        "cookbook"
      ],
      "enabled": true,
      "groupName": "ingredient-parser upstream",
      "groupSlug": "ingredient-parser-upstream"
    }
  ],
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksAsSuccess": false
}
