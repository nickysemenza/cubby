{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nickysemenza/renovate-config"],
  "schedule": ["before 6am on sunday"],
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1,
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "description": "Preserve the repository's longer npm cooldown",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@opentelemetry/*"],
      "enabled": false
    },
    {
      "description": "better-auth minors ship auth schema migrations and drop plugin options that tsc does not flag (oauthProvider options are not excess-property checked), so they get their own PR and a manual MCP OAuth check",
      "matchPackageNames": ["better-auth", "@better-auth/*"],
      "groupName": "better-auth",
      "groupSlug": "better-auth",
      "automerge": false
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "ingredient",
        "recipe-scraper",
        "recipe-types",
        "cookbook"
      ],
      "enabled": true
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "ingredient",
        "recipe-scraper",
        "recipe-types",
        "cookbook"
      ],
      "enabled": true,
      "groupName": "ingredient-parser upstream",
      "groupSlug": "ingredient-parser-upstream",
      "matchUpdateTypes": [
        "major",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ]
    }
  ]
}
