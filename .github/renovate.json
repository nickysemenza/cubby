{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on sunday"],
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "prHourlyLimit": 1,
  "prConcurrentLimit": 1,
  "postUpdateOptions": ["pnpmDedupe"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the Playwright container assertion aligned with @playwright/test",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ci\\.yaml$/"],
      "matchStrings": [
        "PLAYWRIGHT_VERSION:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "@playwright/test",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "pin"],
      "groupName": "all minor and pin updates",
      "automerge": false,
      "groupSlug": "all-deps"
    },
    {
      "description": "The Cloudflare dev toolchain is last-green pinned and Wrangler carries an exact-version pnpm patch",
      "matchPackageNames": ["@cloudflare/vite-plugin", "wrangler"],
      "enabled": false
    },
    {
      "description": "Cloudflare's Vitest plugin uses Vitest 4 internals; only the isolated Worker harness stays on 4",
      "matchFileNames": ["apps/web-worker-tests/package.json"],
      "matchPackageNames": ["vitest"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["patch", "digest"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@opentelemetry/*"],
      "enabled": false
    },
    {
      "description": "better-auth minors ship auth schema migrations and drop plugin options that tsc does not flag (oauthProvider options are not excess-property checked), so they get their own PR and a manual MCP OAuth check",
      "matchPackageNames": ["better-auth", "@better-auth/*"],
      "groupName": "better-auth",
      "groupSlug": "better-auth"
    },
    {
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright runtime",
      "groupSlug": "playwright-runtime"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["ingredient", "recipe-scraper", "recipe-epub"],
      "enabled": true,
      "groupName": "ingredient-parser upstream",
      "groupSlug": "ingredient-parser-upstream"
    }
  ]
}
